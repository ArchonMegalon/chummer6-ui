<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <UseAppHost>false</UseAppHost>
    <AssemblyName>Chummer.KeyLockerSigner</AssemblyName>
    <RootNamespace>Chummer.KeyLockerSigner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="System.Security.Cryptography.Pkcs"
      Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo
      Include="Chummer.KeyLockerSigner.FixtureTests" />
    <AssemblyAttribute
      Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDotnetSdkVersion</_Parameter1>
      <_Parameter2>$(NETCoreSdkVersion)</_Parameter2>
    </AssemblyAttribute>
    <None
      Update="packages.lock.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Update="global.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
