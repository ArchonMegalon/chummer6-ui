<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.NavigatorPaneControl">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Padding="0">
      <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="*" Margin="2,1,2,1">
          <StackPanel Spacing="0">
            <TextBlock x:Name="CodexHeadingText" Classes="shell-section-title" Text="Characters" />
            <TextBlock x:Name="CodexCaptionText"
                       Classes="shell-caption"
                       IsVisible="False"
                       Text=""
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="OpenWorkspacesHeader" IsVisible="False" />
            <TextBlock x:Name="NavigationTabsHeader" IsVisible="False" />
            <TextBlock x:Name="SectionActionsHeader" IsVisible="False" />
            <TextBlock x:Name="WorkflowSurfacesHeader" IsVisible="False" />
          </StackPanel>
        </Grid>

        <TreeView x:Name="NavigatorTree"
                  Grid.Row="1"
                  Margin="0"
                  ToolTip.Tip="Character navigator grouped by ruleset."
                  SelectionChanged="NavigatorTree_OnSelectionChanged">
          <TreeView.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </TreeView.ItemsPanel>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Classes="shell-tree-label" Text="{Binding Label}" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
    </Border>
  </ScrollViewer>
</UserControl>
