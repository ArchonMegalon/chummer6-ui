<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicStatusStrip">
  <Border BorderBrush="{DynamicResource ChummerShellBorderStrongBrush}"
          BorderThickness="0,1,0,0"
          Background="{DynamicResource ChummerShellChromeSubtleBrush}"
          Padding="8,4">
    <Grid RowDefinitions="Auto,Auto"
          ColumnDefinitions="*,Auto,Auto,200"
          ColumnSpacing="12"
          RowSpacing="4">
      <TextBlock x:Name="CharacterStateText"
                 VerticalAlignment="Center"
                 Text="Ready. Classic desktop is active."
                 FontSize="12"
                 ClipToBounds="True"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <Border Grid.Column="1"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              BorderThickness="1"
              Background="{DynamicResource ChummerShellSurfaceAltBrush}"
              Padding="8,2">
        <TextBlock x:Name="ServiceStateText"
                   Text="Services ready"
                   FontSize="11" />
      </Border>
      <Border Grid.Column="2"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              BorderThickness="1"
              Background="{DynamicResource ChummerShellSurfaceAltBrush}"
              Padding="8,2">
        <TextBlock x:Name="TimeStateText"
                   Text="Mode: Classic"
                   FontSize="11" />
      </Border>
      <ProgressBar x:Name="WorkbenchProgressBar"
                   Grid.Column="3"
                   Height="16"
                   Minimum="0"
                   Maximum="100"
                   Value="100"
                   VerticalAlignment="Center" />
      <Border Grid.Row="1"
              Grid.ColumnSpan="4"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              BorderThickness="1"
              Background="{DynamicResource ChummerShellSurfaceAltBrush}"
              ClipToBounds="True"
              Padding="8,2">
        <TextBlock x:Name="ComplianceStateText"
                   Text="Workspace: Ready"
                   FontSize="11"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</UserControl>
