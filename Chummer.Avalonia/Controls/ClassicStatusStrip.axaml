<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicStatusStrip">
  <Border BorderBrush="#7e878d"
          BorderThickness="0,1,0,0"
          Background="#eceeef"
          Padding="8,4">
    <Grid ColumnDefinitions="2*,Auto,Auto,Auto,120"
          ColumnSpacing="12">
      <TextBlock x:Name="CharacterStateText"
                 VerticalAlignment="Center"
                 Text="Ready. Classic desktop is active."
                 FontSize="12" />
      <Border Grid.Column="1"
              BorderBrush="#8b9297"
              BorderThickness="1"
              Background="#f7f8f9"
              Padding="8,2">
        <TextBlock x:Name="ServiceStateText"
                   Text="Services ready"
                   FontSize="11" />
      </Border>
      <Border Grid.Column="2"
              BorderBrush="#8b9297"
              BorderThickness="1"
              Background="#f7f8f9"
              Padding="8,2">
        <TextBlock x:Name="TimeStateText"
                   Text="Mode: Classic"
                   FontSize="11" />
      </Border>
      <Border Grid.Column="3"
              BorderBrush="#8b9297"
              BorderThickness="1"
              Background="#f7f8f9"
              Padding="8,2">
        <TextBlock x:Name="ComplianceStateText"
                   Text="Workspace: Ready"
                   FontSize="11" />
      </Border>
      <ProgressBar x:Name="WorkbenchProgressBar"
                   Grid.Column="4"
                   Height="16"
                   Minimum="0"
                   Maximum="100"
                   Value="100"
                   VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
