<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicFormPortHostControl">
  <Border x:Name="RootBorder"
          Padding="8"
          Background="{DynamicResource ChummerShellPanelBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
      <TextBlock x:Name="PortTitleText"
                 FontSize="16"
                 FontWeight="Bold"
                 Text="Classic FormPort" />
      <TextBlock x:Name="PortMetaText"
                 Grid.Row="1"
                 FontSize="11"
                 Opacity="0.7"
                 Text="Legacy form-native surface projection" />
      <ContentControl x:Name="PortContentHost"
                      Grid.Row="2" />
    </Grid>
  </Border>
</UserControl>
