<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicFormPortHostControl">
  <Border x:Name="RootBorder"
          Padding="8"
          Background="{DynamicResource ChummerShellPanelBackgroundBrush}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="6">
      <TextBlock x:Name="PortTitleText"
                 FontSize="16"
                 FontWeight="Bold"
                 Text="Workspace" />
      <ContentControl x:Name="PortContentHost"
                      Grid.Row="1" />
    </Grid>
  </Border>
</UserControl>
