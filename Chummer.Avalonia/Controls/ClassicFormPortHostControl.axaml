<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicFormPortHostControl">
  <Border x:Name="RootBorder"
          Padding="8"
          Background="{DynamicResource ChummerShellPanelBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock x:Name="PortTitleText"
                   FontSize="16"
                   FontWeight="Bold"
                   Text="Classic FormPort" />
        <Border Grid.Column="1"
                Padding="8,2"
                CornerRadius="4"
                BorderBrush="#7e878d"
                BorderThickness="1"
                Background="#f4f6f8">
          <TextBlock x:Name="PortModeChipText"
                     Text="Classic Mode"
                     FontSize="11"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
      <TextBlock x:Name="PortMetaText"
                 Grid.Row="1"
                 FontSize="11"
                 Opacity="0.7"
                 Text="Legacy form-native surface" />
      <ContentControl x:Name="PortContentHost"
                      Grid.Row="2" />
    </Grid>
  </Border>
</UserControl>
