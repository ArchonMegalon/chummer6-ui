<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Chummer.Avalonia.Controls.SummaryHeaderControl">
  <Border x:Name="RootBorder"
          Background="{DynamicResource ChummerShellChromeSubtleBrush}"
          BorderBrush="{DynamicResource ChummerShellBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="10,6"
          IsVisible="False">
    <StackPanel Spacing="6">
      <controls:WorkspaceStripControl x:Name="WorkspaceStripControl" />

      <StackPanel x:Name="NavigationTabsPanel"
                  Spacing="2">
        <TextBlock x:Name="NavigationTabsHeadingText"
                   IsVisible="False"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ChummerShellMutedForegroundBrush}" />
        <WrapPanel x:Name="NavigationTabsButtonsPanel"
                   HorizontalAlignment="Left" />
      </StackPanel>

      <Border x:Name="RestoreContinuityStatusBorder"
              Background="{DynamicResource ChummerShellSurfaceAltBrush}"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8,6"
              IsVisible="False">
        <StackPanel Spacing="4">
          <TextBlock x:Name="RestoreContinuityStatusText"
                     IsVisible="False"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="StaleStateStatusText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="ConflictChoiceStatusText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border x:Name="RestoreContinuityActionPanel"
              Background="{DynamicResource ChummerShellSurfaceBrush}"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8,6"
              IsVisible="False">
        <StackPanel Spacing="4">
          <TextBlock x:Name="RestoreContinuityDecisionText"
                     IsVisible="False"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="RestoreContinuityDecisionOrderText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="RestoreContinuityLocalAuthorityText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="RestoreContinuityReplacementGuardText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="RestoreContinuitySupportHandoffText"
                     IsVisible="False"
                     TextWrapping="Wrap" />
          <WrapPanel x:Name="RestoreActionButtonsPanel"
                     HorizontalAlignment="Left" />
          <WrapPanel HorizontalAlignment="Left"
                     ItemHeight="32"
                     ItemWidth="0">
            <Button x:Name="KeepLocalWorkButton"
                    Margin="0,0,8,0"
                    Click="KeepLocalWorkButton_OnClick"
                    Content="Keep Local" />
            <Button x:Name="SaveLocalWorkButton"
                    Margin="0,0,8,0"
                    Click="SaveLocalWorkButton_OnClick"
                    Content="Save" />
            <Button x:Name="ReviewCampaignWorkspaceButton"
                    Margin="0,0,8,0"
                    Click="ReviewCampaignWorkspaceButton_OnClick"
                    Content="Campaign" />
            <Button x:Name="OpenWorkspaceSupportButton"
                    Click="OpenWorkspaceSupportButton_OnClick"
                    Content="Support" />
          </WrapPanel>
          <TextBlock x:Name="RestoreContinuityActionStatusText"
                     IsVisible="False"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{DynamicResource ChummerShellMutedForegroundBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
