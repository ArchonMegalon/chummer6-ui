<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicMenuBar">
  <Border BorderBrush="{DynamicResource ChummerShellBorderStrongBrush}"
          BorderThickness="0,0,0,1"
          Background="{DynamicResource ChummerShellMenuBarBrush}"
          Padding="2">
    <Grid ColumnDefinitions="*">
      <Menu x:Name="MenuBarPanel"
            Classes="classic-menu shell-menubar"
            Background="Transparent">
        <MenuItem x:Name="FileMenuButton"
                  Classes="menu-root"
                  Tag="file"
                  Header="File"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
        <MenuItem x:Name="EditMenuButton"
                  Classes="menu-root"
                  Tag="edit"
                  Header="Edit"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
        <MenuItem x:Name="SpecialMenuButton"
                  Classes="menu-root"
                  Tag="special"
                  Header="Special"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
        <MenuItem x:Name="ToolsMenuButton"
                  Classes="menu-root"
                  Tag="tools"
                  Header="Tools"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
        <MenuItem x:Name="WindowsMenuButton"
                  Classes="menu-root"
                  Tag="windows"
                  Header="Windows"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
        <MenuItem x:Name="HelpMenuButton"
                  Classes="menu-root"
                  Tag="help"
                  Header="Help"
                  Click="RootMenuItem_OnClick"
                  SubmenuOpened="RootMenuItem_OnSubmenuOpened" />
      </Menu>
    </Grid>
  </Border>
</UserControl>
