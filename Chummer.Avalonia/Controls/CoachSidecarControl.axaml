<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.CoachSidecarControl">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <Border Classes="shell-card">
        <StackPanel Spacing="8">
          <TextBlock Classes="shell-section-title" Text="Coach" />
          <TextBlock x:Name="CoachLaunchHelpText"
                     Classes="shell-caption"
                     Text="Open a scoped coach session for the current workspace. Copy the browser link only if you need to hand the session off."
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenCoachLaunchButton"
                    Classes="shell-action"
                    Content="Open Coach"
                    Click="OpenCoachLaunchButton_OnClick"
                    HorizontalAlignment="Left" />
            <Button x:Name="CopyCoachLaunchButton"
                    Classes="shell-action quiet"
                    Content="Copy Link"
                    Click="CopyCoachLaunchButton_OnClick"
                    HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock x:Name="CoachLaunchStatusText"
                     Classes="shell-caption"
                     Text="Coach browser handoff is unavailable."
                     TextWrapping="Wrap"
                     IsVisible="False" />
          <TextBlock x:Name="CoachErrorText"
                     Classes="shell-caption"
                     Text=""
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
