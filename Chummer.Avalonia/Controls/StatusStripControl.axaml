<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.StatusStripControl">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
    <StackPanel Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
      <TextBlock x:Name="SaveStateText"
                 Classes="shell-caption"
                 Text="Saved"
                 IsVisible="False"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="SaveStateSeparator" Classes="shell-caption" Text="|" VerticalAlignment="Center" IsVisible="False" />
      <TextBlock x:Name="CharacterStateText"
                 Classes="shell-caption"
                 Text="No character open"
                 IsVisible="False"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Classes="shell-caption" Text="|" VerticalAlignment="Center" IsVisible="False" />
      <TextBlock x:Name="ServiceStateText"
                 Classes="shell-caption"
                 Text="Connected"
                 IsVisible="False"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Classes="shell-caption" Text="|" VerticalAlignment="Center" IsVisible="False" />
      <TextBlock x:Name="TimeStateText"
                 Classes="shell-caption"
                 Text="Time updates when ready"
                 IsVisible="False"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Classes="shell-caption" Text="|" VerticalAlignment="Center" IsVisible="False" />
      <TextBlock x:Name="ComplianceStateText"
                 Classes="shell-caption"
                 Text="Ruleset appears with your character"
                 IsVisible="False"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
      <Button x:Name="StatusDetailsButton" Content="Details"
              AutomationProperties.AutomationId="StatusDetailsButton"
              AutomationProperties.Name="Show workspace status details"
              Padding="6,1" MinHeight="22" FontSize="11">
        <Button.Flyout>
          <Flyout>
            <TextBlock x:Name="StatusDetailsText" MaxWidth="440" TextWrapping="Wrap" />
          </Flyout>
        </Button.Flyout>
      </Button>
      <ProgressBar x:Name="WorkbenchProgressBar"
                   Width="56"
                   Height="8"
                   Maximum="100"
                   Value="100"
                   IsVisible="True"
                   IsIndeterminate="False" />
    </StackPanel>
  </Grid>
</UserControl>
