<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.ClassicToolStrip">
  <Border BorderBrush="#6f7a82"
          BorderThickness="0,0,0,1"
          Background="#d9dfe4"
          Padding="6,4">
    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="4">
      <WrapPanel x:Name="ClassicActionStrip"
                 Orientation="Horizontal"
                 ItemHeight="28">
        <Button x:Name="ImportFileButton"
                MinWidth="76"
                Padding="10,4"
                Content="Open"
                ToolTip.Tip="Open Character"
                Click="ImportFileButton_OnClick" />
        <Button x:Name="SaveButton"
                MinWidth="76"
                Padding="10,4"
                Content="Save"
                ToolTip.Tip="Save Character"
                Click="SaveButton_OnClick" />
        <Button x:Name="PrintButton"
                MinWidth="76"
                Padding="10,4"
                Content="Print"
                ToolTip.Tip="Print Character"
                Click="PrintButton_OnClick" />
        <Button x:Name="CopyButton"
                MinWidth="76"
                Padding="10,4"
                Content="Copy"
                ToolTip.Tip="Copy"
                Click="CopyButton_OnClick" />
        <Button x:Name="OpenForPrintingButton"
                MinWidth="76"
                Padding="10,4"
                Content="Open Print"
                ToolTip.Tip="Open Character for Printing"
                Click="OpenForPrintingButton_OnClick" />
        <Button x:Name="OpenForExportButton"
                MinWidth="82"
                Padding="10,4"
                Content="Open Export"
                ToolTip.Tip="Open Character for Export"
                Click="OpenForExportButton_OnClick" />
        <Button x:Name="SettingsButton"
                MinWidth="110"
                Padding="10,4"
                Content="Settings"
                ToolTip.Tip="Global Settings"
                Click="SettingsButton_OnClick" />
        <Button x:Name="ImportRawButton"
                IsVisible="False"
                MinWidth="88"
                Padding="10,4"
                Content="Raw XML"
                ToolTip.Tip="Import Raw XML"
                Click="ImportRawButton_OnClick" />
        <Button x:Name="DesktopHomeButton"
                IsVisible="False"
                MinWidth="72"
                Padding="10,4"
                Content="Home"
                ToolTip.Tip="Desktop Home"
                Click="DesktopHomeButton_OnClick" />
        <Button x:Name="HorizonsButton"
                MinWidth="90"
                Padding="10,4"
                Content="Horizons"
                ToolTip.Tip="Open Horizons"
                Click="HorizonsButton_OnClick" />
        <Button x:Name="CampaignWorkspaceButton"
                IsVisible="False"
                MinWidth="86"
                Padding="10,4"
                Content="Campaign"
                ToolTip.Tip="Campaign Workspace"
                Click="CampaignWorkspaceButton_OnClick" />
        <Button x:Name="GmPrepButton"
                IsVisible="False"
                MinWidth="82"
                Padding="10,4"
                Content="GM Prep"
                ToolTip.Tip="Open GM Prep Packets"
                Click="GmPrepButton_OnClick" />
        <Button x:Name="RosterMovementButton"
                IsVisible="False"
                MinWidth="86"
                Padding="10,4"
                Content="Roster"
                ToolTip.Tip="Open Roster Movement"
                Click="RosterMovementButton_OnClick" />
        <Button x:Name="RuleEnvironmentStudioButton"
                MinWidth="80"
                Padding="10,4"
                Content="Rules"
                ToolTip.Tip="Open Rule Environment Studio"
                Click="RuleEnvironmentStudioButton_OnClick" />
        <Button x:Name="UpdateStatusButton"
                IsVisible="False"
                MinWidth="78"
                Padding="10,4"
                Content="Update"
                ToolTip.Tip="Review Update Status"
                Click="UpdateStatusButton_OnClick" />
        <Button x:Name="InstallLinkingButton"
                IsVisible="False"
                MinWidth="88"
                Padding="10,4"
                Content="Link Copy"
                ToolTip.Tip="Link This Copy"
                Click="InstallLinkingButton_OnClick" />
        <Button x:Name="SupportButton"
                IsVisible="False"
                MinWidth="78"
                Padding="10,4"
                Content="Support"
                ToolTip.Tip="Open Support"
                Click="SupportButton_OnClick" />
        <Button x:Name="ReportIssueButton"
                IsVisible="False"
                MinWidth="82"
                Padding="10,4"
                Content="Issue"
                ToolTip.Tip="Report Issue"
                Click="ReportIssueButton_OnClick" />
        <Button x:Name="LoadDemoRunnerButton"
                IsVisible="False"
                MinWidth="84"
                Padding="10,4"
                Content="Sample"
                ToolTip.Tip="Open Sample Character"
                Click="LoadDemoRunnerButton_OnClick" />
        <Button x:Name="CloseWorkspaceButton"
                MinWidth="72"
                Padding="10,4"
                Content="Close"
                ToolTip.Tip="Close Active Workspace"
                Click="CloseWorkspaceButton_OnClick" />
      </WrapPanel>

      <Border x:Name="StatusTextBorder"
              Grid.Row="1"
              IsVisible="False"
              BorderBrush="#8d969c"
              BorderThickness="1"
              CornerRadius="3"
              Background="#f8fafb"
              Padding="8,3"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
        <TextBlock x:Name="StatusText"
                   Text="Ready"
                   FontSize="11" />
      </Border>
    </Grid>
  </Border>
</UserControl>
