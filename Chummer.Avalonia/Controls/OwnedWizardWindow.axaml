<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Chummer.Avalonia.Controls"
        x:Class="Chummer.Avalonia.Controls.OwnedWizardWindow"
        Width="1040" Height="720"
        MinWidth="760" MinHeight="520"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource ChummerShellFontFamily}"
        FontSize="{DynamicResource ChummerShellFontSizeBody}"
        TransparencyLevelHint="None"
        Background="{DynamicResource ChummerShellHardPanelBrush}">
  <!-- Gen6 F04: Auto,* rows keep the chrome header out of the body's
       rectangle; the body scrolls within the window instead of overflowing. -->
  <Grid RowDefinitions="Auto,*">
    <shell:OwnedWizardChrome x:Name="WizardChrome" Grid.Row="0" />
    <ScrollViewer x:Name="ContentScroller" Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ContentPresenter x:Name="WizardContentHost"
                        Margin="{DynamicResource ChummerShellSpacing}" />
    </ScrollViewer>
  </Grid>
</Window>
