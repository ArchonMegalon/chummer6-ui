<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.CharacterCreateClassicPort">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="10">
      <TextBlock x:Name="CreateNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />
      <WrapPanel x:Name="CreateTabsPanel"
                 Grid.Row="1"
                 Orientation="Horizontal" />
      <WrapPanel x:Name="CreateFactsPanel"
                 Grid.Row="2"
                 Orientation="Horizontal" />
      <Grid Grid.Row="3"
            ColumnDefinitions="3*,3*,2*"
            ColumnSpacing="10">
        <StackPanel x:Name="CreatePriorityPanel"
                    Spacing="10" />
        <StackPanel x:Name="CreateAttributePanel"
                    Grid.Column="1"
                    Spacing="10" />
        <StackPanel x:Name="CreateActionPanel"
                    Grid.Column="2"
                    Spacing="10" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
