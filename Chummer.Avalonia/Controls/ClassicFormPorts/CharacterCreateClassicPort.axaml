<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.CharacterCreateClassicPort"
             Background="{DynamicResource ChummerShellHardPanelBrush}">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Commands.AddCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Commands.EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding Commands.DeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add build choice" Command="{Binding Commands.AddCommand}" />
      <MenuItem Header="Edit selected choice" Command="{Binding Commands.EditCommand}" />
      <MenuItem Header="Delete selected choice" Command="{Binding Commands.DeleteCommand}" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <ScrollViewer Background="{DynamicResource ChummerShellHardPanelBrush}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8"
                Spacing="10"
                Background="{DynamicResource ChummerShellHardPanelBrush}">
      <Border Classes="shell-panel subtle"
              Background="{DynamicResource ChummerShellChromeSubtleBrush}"
              BorderBrush="{DynamicResource ChummerShellBorderBrush}"
              Padding="8,6">
        <TextBlock x:Name="CreateNoticeText"
                   TextWrapping="Wrap"
                   Classes="shell-caption" />
      </Border>

      <TabControl x:Name="CreateTabs"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}">
        <TabItem Header="Priorities">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Priority Grid" Classes="shell-section-title" />
              <ComboBox x:Name="CreatePrioritySelector" MinWidth="180" />
              <ListBox x:Name="CreatePrioritiesList" MinHeight="180" />
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="Attributes">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Attribute Values" Classes="shell-section-title" />
              <ListBox x:Name="CreateAttributesList" MinHeight="180" />
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="Skills">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Skill Picks" Classes="shell-section-title" />
              <TreeView x:Name="CreateSkillsTree" MinHeight="180" />
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="Gear">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Starting Gear" Classes="shell-section-title" />
              <ListBox x:Name="CreateGearList" MinHeight="180" />
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="Spells">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Spells and Traditions" Classes="shell-section-title" />
              <TreeView x:Name="CreateSpellsTree" MinHeight="180" />
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="Final">
          <Border Classes="shell-panel"
                  Background="{DynamicResource ChummerShellSurfaceBrush}"
                  BorderBrush="{DynamicResource ChummerShellBorderBrush}"
                  Padding="8"
                  Margin="6">
            <StackPanel Spacing="8"
                        Background="{DynamicResource ChummerShellSurfaceBrush}">
              <TextBlock Text="Finalized Profile" Classes="shell-section-title" />
              <ListBox x:Name="CreateFinalList" MinHeight="140" />
              <TextBlock Text="Create Actions" Classes="shell-section-title" Margin="0,8,0,0" />
              <ListBox x:Name="CreateActionsList" MinHeight="120" />
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
