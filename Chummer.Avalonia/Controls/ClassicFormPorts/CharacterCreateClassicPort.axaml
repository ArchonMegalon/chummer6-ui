<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.CharacterCreateClassicPort">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Commands.AddCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Commands.EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding Commands.DeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add build choice" Command="{Binding Commands.AddCommand}" />
      <MenuItem Header="Edit selected choice" Command="{Binding Commands.EditCommand}" />
      <MenuItem Header="Delete selected choice" Command="{Binding Commands.DeleteCommand}" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="CreateNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="CreateTabs">
        <TabItem Header="Priorities">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Priority Grid" FontWeight="SemiBold" />
            <ComboBox x:Name="CreatePrioritySelector" MinWidth="180" />
            <ListBox x:Name="CreatePrioritiesList" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Attributes">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Attribute Values" FontWeight="SemiBold" />
            <ListBox x:Name="CreateAttributesList" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Skills">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Skill Picks" FontWeight="SemiBold" />
            <TreeView x:Name="CreateSkillsTree" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Gear">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Starting Gear" FontWeight="SemiBold" />
            <ListBox x:Name="CreateGearList" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Spells">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Spells and Traditions" FontWeight="SemiBold" />
            <TreeView x:Name="CreateSpellsTree" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Final">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Finalized Profile" FontWeight="SemiBold" />
            <ListBox x:Name="CreateFinalList" MinHeight="140" />
            <TextBlock Text="Create Actions" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListBox x:Name="CreateActionsList" MinHeight="120" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
