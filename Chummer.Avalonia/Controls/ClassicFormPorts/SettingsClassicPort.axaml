<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.SettingsClassicPort">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="SettingsNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="SettingsTabs">
        <TabItem Header="Global">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Global Settings"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="SettingsGlobalPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="Custom Data">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Custom Data &amp; Plugins"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="SettingsCustomDataPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="GitHub Issues">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="GitHub Issues"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="SettingsGitHubIssuesPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="Plugins">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Plugins"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="SettingsPluginsPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
