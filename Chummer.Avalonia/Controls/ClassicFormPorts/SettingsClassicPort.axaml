<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.SettingsClassicPort">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="10">
      <TextBlock x:Name="SettingsNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />
      <WrapPanel x:Name="SettingsTabsPanel"
                 Grid.Row="1"
                 Orientation="Horizontal" />
      <WrapPanel x:Name="SettingsFactsPanel"
                 Grid.Row="2"
                 Orientation="Horizontal" />
      <Grid Grid.Row="3"
            ColumnDefinitions="2*,2*,3*"
            ColumnSpacing="10">
        <StackPanel x:Name="SettingsCategoryPanel"
                    Spacing="10" />
        <StackPanel x:Name="SettingsCustomDataPanel"
                    Grid.Column="1"
                    Spacing="10" />
        <StackPanel x:Name="SettingsWorkflowPanel"
                    Grid.Column="2"
                    Spacing="10" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
