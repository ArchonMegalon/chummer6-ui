<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.SettingsClassicPort">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" />
    <KeyBinding Gesture="Ctrl+E" />
    <KeyBinding Gesture="Delete" />
  </UserControl.KeyBindings>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add setting" />
      <MenuItem Header="Edit selected setting" />
      <MenuItem Header="Delete selected setting" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="SettingsNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="SettingsTabs">
        <TabItem Header="Global">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Global Settings"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="SettingsGlobalSelector"
                      Grid.Row="1"
                      MinWidth="180" />
            <ListBox x:Name="SettingsGlobalList"
                     Grid.Row="2"
                     MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Custom Data">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Custom Data &amp; Plugins"
                       FontWeight="SemiBold" />
            <ListBox x:Name="SettingsCustomDataList"
                     Grid.Row="1"
                     MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="GitHub Issues">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="GitHub Issues"
                       FontWeight="SemiBold" />
            <TreeView x:Name="SettingsGitHubIssuesTree"
                      Grid.Row="1"
                      MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Plugins">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Plugins"
                       FontWeight="SemiBold" />
            <TreeView x:Name="SettingsPluginsTree"
                      Grid.Row="1"
                      MinHeight="180" />
          </Grid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
