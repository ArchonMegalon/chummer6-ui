<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.MasterIndexClassicPort">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="IndexNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="IndexTabs">
        <TabItem Header="Browse">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Browse Results"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="IndexBrowseSelector"
                      Grid.Row="1"
                      MinWidth="180" />
            <TreeView x:Name="IndexBrowseTree"
                      Grid.Row="2"
                      MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Search">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Search Workflow"
                       FontWeight="SemiBold" />
            <ListBox x:Name="IndexSearchList"
                     Grid.Row="1"
                     MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Source">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Source and Legacy Chrome"
                       FontWeight="SemiBold" />
            <ListBox x:Name="IndexSourceList"
                     Grid.Row="1"
                     MinHeight="180" />
          </Grid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
