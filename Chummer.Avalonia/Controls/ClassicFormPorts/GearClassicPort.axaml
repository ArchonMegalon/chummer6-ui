<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.GearClassicPort">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Commands.AddCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Commands.EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding Commands.DeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add gear" Command="{Binding Commands.AddCommand}" />
      <MenuItem Header="Edit selected gear" Command="{Binding Commands.EditCommand}" />
      <MenuItem Header="Delete selected gear" Command="{Binding Commands.DeleteCommand}" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="GearNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="GearTabs">
        <TabItem Header="Category">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Category Browser"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="GearCategorySelector"
                      Grid.Row="1"
                      MinWidth="180" />
            <ListBox x:Name="GearCategoryList"
                     Grid.Row="2"
                     MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Filters">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Filters and Quick Actions"
                       FontWeight="SemiBold" />
            <TreeView x:Name="GearFilterTree"
                      Grid.Row="1"
                      MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Details">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Item Detail"
                       FontWeight="SemiBold" />
            <ListBox x:Name="GearDetailList"
                     Grid.Row="1"
                     MinHeight="180" />
          </Grid>
        </TabItem>

        <TabItem Header="Purchase">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Purchase Actions"
                       FontWeight="SemiBold" />
            <ListBox x:Name="GearPurchaseList"
                     Grid.Row="1"
                     MinHeight="180" />
          </Grid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
