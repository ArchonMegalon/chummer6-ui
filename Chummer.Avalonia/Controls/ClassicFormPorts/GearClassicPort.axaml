<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.GearClassicPort">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="GearNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="GearTabs">
        <TabItem Header="Category">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Category Browser"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="GearCategoryPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="Filters">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Filters and Quick Actions"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="GearFilterPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="Details">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Item Detail"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="GearDetailPanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>

        <TabItem Header="Purchase">
          <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="6">
            <TextBlock Text="Purchase Actions"
                       FontWeight="SemiBold" />
            <StackPanel x:Name="GearPurchasePanel"
                        Grid.Row="1"
                        Spacing="4" />
          </Grid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
