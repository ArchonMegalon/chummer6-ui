<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chummer.Avalonia.Controls.CharacterCareerClassicPort">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Commands.AddCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding Commands.EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding Commands.DeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add career item" Command="{Binding Commands.AddCommand}" />
      <MenuItem Header="Edit selected item" Command="{Binding Commands.EditCommand}" />
      <MenuItem Header="Delete selected item" Command="{Binding Commands.DeleteCommand}" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock x:Name="CareerNoticeText"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TabControl x:Name="CareerTabs">
        <TabItem Header="Character">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Career Snapshot"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="CareerActionSelector"
                      MinWidth="180" />
            <ListBox x:Name="CareerSnapshotList"
                     MinHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="160,*" ColumnSpacing="8">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </TabItem>

        <TabItem Header="Advancement">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Advancement Data"
                       FontWeight="SemiBold" />
            <TreeView x:Name="CareerAdvancementTree" MinHeight="180">
              <TreeView.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.78" />
                  </StackPanel>
                </DataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </StackPanel>
        </TabItem>

        <TabItem Header="Gear">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Gear Loaded"
                       FontWeight="SemiBold" />
            <ListBox x:Name="CareerGearList"
                     MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Armor">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Armor and Protection"
                       FontWeight="SemiBold" />
            <ListBox x:Name="CareerArmorList"
                     MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Weapons">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Weapons"
                       FontWeight="SemiBold" />
            <ListBox x:Name="CareerWeaponsList"
                     MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Contacts">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Contacts"
                       FontWeight="SemiBold" />
            <TreeView x:Name="CareerContactsTree" MinHeight="180" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Notes">
          <StackPanel Spacing="8" Margin="6">
            <TextBlock Text="Notes"
                       FontWeight="SemiBold" />
            <ListBox x:Name="CareerNotesList"
                     MinHeight="140" />
            <TextBlock Text="Recent Actions"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <ListBox x:Name="CareerActionsList"
                     MinHeight="120" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
