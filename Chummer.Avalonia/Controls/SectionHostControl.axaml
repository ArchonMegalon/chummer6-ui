<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chummer.Avalonia.Controls"
             x:Class="Chummer.Avalonia.Controls.SectionHostControl">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">
    <Border Grid.Row="0"
            x:Name="LoadedRunnerTabStripBorder"
            Classes="shell-panel subtle"
            Padding="1,0"
            IsVisible="False">
      <TabStrip x:Name="LoadedRunnerTabStrip"
                Classes="classic-tabs"
                SelectionChanged="LoadedRunnerTabStrip_OnSelectionChanged">
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="controls:NavigatorTabItem">
            <TextBlock Text="{Binding Label}" Classes="shell-tab-label" />
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
    </Border>

    <Border Grid.Row="1"
            x:Name="SectionActionTabStripBorder"
            Classes="shell-panel subtle"
            Padding="1,0"
            IsVisible="False">
      <TabStrip x:Name="SectionActionTabStrip"
                Classes="classic-tabs"
                SelectionChanged="SectionActionTabStrip_OnSelectionChanged">
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="controls:NavigatorSectionActionItem">
            <TextBlock Text="{Binding Label}" Classes="shell-tab-label" />
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <Border Padding="0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="1">
        <Border x:Name="NoticeBorder"
                Classes="shell-panel subtle"
                Padding="2,1"
                IsVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="6,6,6,0"
                MaxWidth="420"
                ZIndex="10"
                IsHitTestVisible="False">
      <TextBlock x:Name="NoticeText"
                 Classes="shell-caption"
                 Text=""
                 TextWrapping="Wrap"
                 MaxLines="2"
                 TextTrimming="CharacterEllipsis" />
    </Border>

        <Border Grid.Row="0"
                x:Name="SectionContextBorder"
                Classes="shell-panel subtle"
                Padding="3,2">
          <StackPanel Spacing="0">
            <TextBlock x:Name="SectionContextTitleText"
                       Classes="shell-section-title"
                       Text="Section"
                       IsVisible="False" />
            <TextBlock x:Name="SectionContextSummaryText"
                       Classes="shell-caption"
                       Text="Section summary"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="False" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1"
                x:Name="GearWorkbenchBorder"
                Classes="shell-panel"
                IsVisible="False"
                Padding="3,2">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
            <StackPanel Spacing="1">
              <TextBlock x:Name="GearWorkbenchTitleText"
                         Text="Gear"
                         Classes="shell-section-title" />
              <TextBlock x:Name="GearWorkbenchSummaryText"
                         Classes="shell-caption"
                         Text="Loadout summary" />
            </StackPanel>
            <WrapPanel Grid.Row="1"
                       x:Name="GearWorkbenchBadgeStrip"
                       Orientation="Horizontal"
                       ItemHeight="28" />
            <Grid Grid.Row="2"
                  ColumnDefinitions="1.2*,0.8*"
                  ColumnSpacing="8">
              <ListBox x:Name="GearWorkbenchList"
                       MinHeight="168"
                       MaxHeight="320"
                       BorderThickness="0"
                       Background="{DynamicResource ChummerShellSurfaceBrush}"
                       SelectionChanged="GearWorkbenchList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="0" Margin="0,1">
                      <TextBlock Text="{Binding Label}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}"
                                 Classes="shell-caption"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="2" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Column="1"
                      Classes="shell-panel subtle"
                      Padding="4,3">
                <TextBlock x:Name="GearWorkbenchDetailText"
                           Classes="shell-caption"
                           Text="Select an inventory entry to inspect its current loadout details."
                           TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="2"
                x:Name="ClassicCharacterSheetBorder"
                Classes="shell-panel"
                IsVisible="False"
                Padding="3,2">
          <StackPanel Spacing="4">
            <TextBlock x:Name="ClassicCharacterSummaryTitle"
                       Text="Section"
                       Classes="shell-section-title"
                       IsVisible="False" />
            <WrapPanel x:Name="ClassicCharacterFactsPanel"
                       Orientation="Horizontal"
                       ItemHeight="32" />
            <WrapPanel x:Name="ClassicAttributeFactsPanel"
                       Orientation="Horizontal"
                       ItemHeight="28" />
          </StackPanel>
        </Border>
        <Border Grid.Row="3"
                x:Name="AttributeParityEditorBorder"
                Classes="shell-panel"
                IsVisible="False"
                Padding="4,3">
          <Grid RowDefinitions="Auto,*" RowSpacing="4">
            <Grid x:Name="AttributeParityHeaderGrid"
                  ColumnDefinitions="*,72,72,88,118"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Attributes" Classes="shell-section-title" IsVisible="False" />
              <TextBlock Grid.Column="1" Text="Points" Classes="shell-caption" HorizontalAlignment="Right" IsVisible="False" />
              <TextBlock Grid.Column="2" Text="Karma" Classes="shell-caption" HorizontalAlignment="Right" IsVisible="False" />
              <TextBlock Grid.Column="3" Text="Val (Aug)" Classes="shell-caption" HorizontalAlignment="Right" IsVisible="False" />
              <TextBlock Grid.Column="4" Text="Metatype Limits" Classes="shell-caption" HorizontalAlignment="Right" IsVisible="False" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MinHeight="208"
                          MaxHeight="360">
              <StackPanel x:Name="AttributeParityRowsHost"
                          Spacing="2" />
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="4"
                x:Name="BuildLabBorder"
                Classes="shell-panel subtle"
                IsVisible="False"
                Padding="4,3">
          <StackPanel Spacing="4">
            <TextBlock x:Name="BuildLabSummaryText"
                       Text="Build Lab intake"
                       Classes="shell-section-title"
                       IsVisible="False" />
            <StackPanel x:Name="BuildLabTrustReceiptPanel"
                        Spacing="4" />
          </StackPanel>
        </Border>
        <Border Grid.Row="5"
                x:Name="SectionRowsBorder"
                Classes="shell-panel"
                Padding="3,2">
          <StackPanel Spacing="1">
            <ListBox x:Name="SectionRowsList"
                     MinHeight="132"
                     MaxHeight="360"
                     BorderThickness="0"
                     Background="{DynamicResource ChummerShellSurfaceBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="132,*" ColumnSpacing="8" Margin="0,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayPath}"
                               Classes="shell-caption"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayValue}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Grid.Row="6"
                x:Name="SectionReviewPanel"
                Classes="shell-panel subtle"
                Padding="3,2"
                IsVisible="False">
          <TextBox x:Name="SectionPreviewBox"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   IsReadOnly="True"
                   MinHeight="80"
                   MaxHeight="220" />
        </Border>
        <Border Grid.Row="7"
                x:Name="SectionQuickActionsBorder"
                Classes="shell-panel"
                Padding="1,0"
                IsVisible="False">
          <StackPanel x:Name="SectionQuickActionsHost"
                      Orientation="Horizontal"
                      Spacing="4" />
        </Border>
      </Grid>
      </Border>
    </ScrollViewer>

    <Border Grid.Row="3" x:Name="RawXmlImportBorder" Classes="shell-panel subtle" Padding="3" IsVisible="False">
      <Expander Header="Raw XML Import" IsExpanded="False">
        <StackPanel Spacing="2" Margin="0,4,0,0">
          <TextBox x:Name="XmlInputBox"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="64"
                   MaxHeight="220"
                   ToolTip.Tip="Paste raw XML when you need a direct import or diagnostics." />
        </StackPanel>
      </Expander>
    </Border>
  </Grid>
</UserControl>
