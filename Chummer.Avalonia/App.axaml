          <SolidColorBrush x:Key="ChummerShellActiveMenuBackgroundBrush" Color="#DDE9DD" />
          <SolidColorBrush x:Key="ChummerShellActiveMenuBorderBrush" Color="#1C4A2D" />
          <SolidColorBrush x:Key="ChummerShellDialogHeaderBrush" Color="#E9EEF5" />
