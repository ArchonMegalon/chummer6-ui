          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#CBD5E1" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#94A3B8" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#111827" />
