          <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#111827" />
          <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#475569" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="FlyoutPresenterForeground" Color="#111827" />
          <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#B5C0CF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterForeground" Color="#111827" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#B5C0CF" />
          <SolidColorBrush x:Key="MenuItemBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="MenuItemBackgroundPointerOver" Color="#F5F8FC" />
          <SolidColorBrush x:Key="MenuItemBackgroundSelected" Color="#2C5FB8" />
          <SolidColorBrush x:Key="MenuItemForeground" Color="#111827" />
          <SolidColorBrush x:Key="MenuItemForegroundPointerOver" Color="#111827" />
          <SolidColorBrush x:Key="MenuItemForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuItemForegroundDisabled" Color="#475569" />
          <SolidColorBrush x:Key="ChummerShellAccentButtonBrush" Color="#1C4A2D" />
          <SolidColorBrush x:Key="ChummerShellAccentButtonForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ChummerShellInfoBrush" Color="#173A6C" />
          <SolidColorBrush x:Key="ChummerShellWarningBrush" Color="#9A6700" />
          <SolidColorBrush x:Key="ChummerShellDangerBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="ChummerShellFocusRingBrush" Color="#2C6B3F" />
          <SolidColorBrush x:Key="ChummerShellSuccessBrush" Color="#1C4A2D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ChummerShellWindowBackgroundBrush" Color="#050B16" />
          <SolidColorBrush x:Key="ChummerShellForegroundBrush" Color="#E5E7EB" />
          <SolidColorBrush x:Key="ChummerShellMutedForegroundBrush" Color="#D8E1EC" />
          <SolidColorBrush x:Key="ChummerShellTextMutedBrush" Color="#94A3B8" />
          <SolidColorBrush x:Key="ChummerShellChromeBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="ChummerShellChromeSubtleBrush" Color="#111827" />
          <SolidColorBrush x:Key="ChummerShellChromeAccentBrush" Color="#172554" />
          <SolidColorBrush x:Key="ChummerShellMenuBarBrush" Color="#162033" />
          <SolidColorBrush x:Key="ChummerShellMenuHoverBrush" Color="#223149" />
