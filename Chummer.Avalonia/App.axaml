      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ChummerShellWindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI,Verdana,Arial" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI,Verdana,Arial" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.shell-kicker">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellMutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.shell-title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-subtitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellMutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-section-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellMutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-option-label">
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-option-meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellTextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.shell-tree-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.shell-tab-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="StackPanel.shell-toolstrip-band">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="Border.shell-toolstrip-state">
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBlock.shell-metric-value">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.shell-panel">
      <Setter Property="Background" Value="{DynamicResource ChummerShellSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #120F172A" />
    </Style>
    <Style Selector="Border.shell-panel.chrome">
      <Setter Property="Background" Value="{DynamicResource ChummerShellChromeBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.shell-panel.subtle">
      <Setter Property="Background" Value="{DynamicResource ChummerShellChromeSubtleBrush}" />
    </Style>
    <Style Selector="Border.shell-panel.accent">
      <Setter Property="Background" Value="{DynamicResource ChummerShellChromeAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellActiveMenuBorderBrush}" />
    </Style>
    <Style Selector="Border.shell-card">
      <Setter Property="Background" Value="{DynamicResource ChummerShellSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BoxShadow" Value="0 10 24 0 #120F172A" />
    </Style>
    <Style Selector="Border.shell-card.subtle">
      <Setter Property="Background" Value="{DynamicResource ChummerShellPanelMutedBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ChummerShellChromeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellActiveMenuBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ChummerShellSurfaceAltBrush}" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellFocusRingBrush}" />
    </Style>
    <Style Selector="Button.menu-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Button.menu-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChummerShellChromeSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellBorderBrush}" />
    </Style>
    <Style Selector="Button.shell-action.primary">
      <Setter Property="Background" Value="{DynamicResource ChummerShellAccentButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellAccentButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellAccentButtonBrush}" />
    </Style>
    <Style Selector="Button.shell-action.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChummerShellActiveMenuBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChummerShellActiveMenuBorderBrush}" />
    </Style>
    <Style Selector="Button.shell-action.quiet">
      <Setter Property="Background" Value="{DynamicResource ChummerShellPanelOverlayBrush}" />
    </Style>
    <Style Selector="Button.tool-icon">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="StackPanel.tool-button-content">
      <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="Image.tool-button-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="TextBlock.tool-button-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource FlyoutPresenterBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource FlyoutPresenterForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FlyoutPresenterBorderBrush}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutPresenterForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutPresenterForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}" />
    </Style>
    <Style Selector="Menu.classic-menu">
      <Setter Property="Background" Value="{DynamicResource ChummerShellMenuBarBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChummerShellForegroundBrush}" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Menu.shell-menubar">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Background" Value="{DynamicResource MenuItemBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MenuItemForeground}" />
    </Style>
    <Style Selector="MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource MenuItemBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource MenuItemForegroundPointerOver}" />
    </Style>
    <Style Selector="MenuItem:selected">
