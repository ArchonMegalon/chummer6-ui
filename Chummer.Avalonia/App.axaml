          <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#475569" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F5F8FC" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#EEF3F8" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#EEF3F8" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#111827" />
