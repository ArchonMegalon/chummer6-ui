          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#CBD5E1" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#B5C0CF" />
          <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#FBFCFE" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#F5F8FC" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#EEF3F8" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2C5FB8" />
