<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chummer.Avalonia.Controls"
        x:Class="Chummer.Avalonia.MainClassicWindow"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="560"
        Title="Chummer Desktop Classic"
        Icon="/Assets/chummer.ico">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <controls:ClassicMenuBar Grid.Row="0" />
    <controls:ClassicToolStrip Grid.Row="1" />
    <Border Grid.Row="2" Padding="0">
      <controls:ClassicFormPortHostControl />
    </Border>
    <controls:ClassicStatusStrip Grid.Row="3" />
  </Grid>
</Window>
