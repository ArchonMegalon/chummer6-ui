# Self-hosted browser client defaults

CHUMMER_PORTAL_PORT=8091
CHUMMER_API_PORT=8088
CHUMMER_BLAZOR_PORT=8089
CHUMMER_HUB_PORT=8092

CHUMMER_PORTAL_OWNER_SHARED_KEY=local-self-hosted-portal-shared-key
CHUMMER_PORTAL_IMPLICIT_OWNER=local@self-host

CHUMMER_PORTAL_BLAZOR_URL=/blazor/
CHUMMER_BLAZOR_PATH_BASE=/blazor
CHUMMER_PORTAL_HUB_URL=/hub/
CHUMMER_PORTAL_DOWNLOADS_URL=/downloads/

CHUMMER_PORTAL_RELEASES_FILE=/app/downloads/releases.json
CHUMMER_PORTAL_RELEASES_DIR=/app/downloads

# Optional analytics, default-off.
# Set CHUMMER_ANALYTICS_PROVIDER=rybbit only when you have a Rybbit site id
# and have disabled sensitive capture such as session replay and autocapture for the site.
# The browser adapter is metadata-only: route/workflow fields and boolean presence
# fields such as has_workspace and has_dossier are allowed; runner names,
# owner identifiers, workspace or dossier identifiers, XML, payloads, hashes, and dossier text are not.
CHUMMER_ANALYTICS_PROVIDER=none
# CHUMMER_RYBBIT_SITE_ID=
# CHUMMER_RYBBIT_SCRIPT_URL=https://analytics.example.com/api/script.js
# CHUMMER_RYBBIT_BASE_URL=https://analytics.example.com

# Optional connected-runtime lanes
# CHUMMER_API_KEY=
# CHUMMER_PORTAL_API_KEY=
# CHUMMER_PORTAL_SESSION_URL=/session/
# CHUMMER_PORTAL_SESSION_PROXY_URL=
# CHUMMER_PORTAL_COACH_URL=/coach/
# CHUMMER_PORTAL_COACH_PROXY_URL=
# CHUMMER_PORTAL_AI_PROXY_URL=
# CHUMMER_RUN_URL=
# CHUMMER_PORTAL_DOWNLOADS_FALLBACK_URL=
