    "desktopControlsFromOracle": true,
    "popupMenusInScope": true,
    "tooltipsInScope": true,
    "secondaryPointerHostTruthInScope": true,
    "middleClickTruthInScope": true
  },
  "exitLayers": [
    {
      "id": "inventory_coverage",
      "description": "Every promoted dialog, panel, grid, popup menu, and tooltip route listed by the parity oracle is in scope."
    },
    {
      "id": "widget_class_parity",
      "description": "Equivalent legacy controls keep the same widget class."
    },
    {
      "id": "label_text_parity",
      "description": "Visible labels and action captions stay legacy-identical except for trivial punctuation normalization."
    },
    {
      "id": "action_geography_parity",
      "description": "Buttons stay in the same action strip, left-to-right order, and normalized layout zone."
    },
    {
      "id": "pointer_route_parity",
      "description": "Left, double, right, middle, and wheel interactions remain functionally identical when legacy already had the same route."
    },
    {
      "id": "mouse_only_replay",
      "description": "Mouse-only veteran macros must land on the same visible result, including source-click and double-tap legacy routes."
    }
  ],
  "detailedDialogChecks": [
    {
      "dialogId": "gear_add",
      "legacyDesignerPath": "/docker/chummer5a/Chummer/Forms/Selection Forms/SelectGear.Designer.cs",
