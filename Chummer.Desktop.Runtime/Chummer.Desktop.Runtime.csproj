<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunDesktopReleaseMatrixTestsOnly Condition="'$(RunDesktopReleaseMatrixTestsOnly)' == ''">false</RunDesktopReleaseMatrixTestsOnly>
    <RunBlazorShellComponentTestsOnly Condition="'$(RunBlazorShellComponentTestsOnly)' == ''">false</RunBlazorShellComponentTestsOnly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="$(ChummerLocalContractsProject)" />
    <ProjectReference Include="$(ChummerLocalCampaignContractsProject)" />
    <ProjectReference Include="$(ChummerLocalRunContractsProject)" />
    <ProjectReference Include="$(ChummerLocalHubRegistryContractsProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="$(ChummerContractsPackageId)" Version="$(ChummerContractsPackageVersion)" />
    <PackageReference Include="$(ChummerCampaignContractsPackageId)" Version="$(ChummerCampaignContractsPackageVersion)" />
    <PackageReference Include="$(ChummerRunContractsPackageId)" Version="$(ChummerRunContractsPackageVersion)" />
    <PackageReference Include="$(ChummerHubRegistryContractsPackageId)" Version="$(ChummerHubRegistryContractsPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildProjectDirectory)/../Chummer.Presentation/Chummer.Presentation.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunBlazorShellComponentTestsOnly)' != 'true' and '$(RunDesktopReleaseMatrixTestsOnly)' != 'true'">
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Application/Chummer.Application.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Application/Chummer.Application.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Infrastructure/Chummer.Infrastructure.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Infrastructure/Chummer.Infrastructure.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Hosting/Chummer.Rulesets.Hosting.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Hosting/Chummer.Rulesets.Hosting.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr4/Chummer.Rulesets.Sr4.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr4/Chummer.Rulesets.Sr4.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr5/Chummer.Rulesets.Sr5.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr5/Chummer.Rulesets.Sr5.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr6/Chummer.Rulesets.Sr6.csproj"
                      Condition="Exists('$(MSBuildProjectDirectory)/../../chummer-core-engine/Chummer.Rulesets.Sr6/Chummer.Rulesets.Sr6.csproj')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunBlazorShellComponentTestsOnly)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="DesktopCrashReport.cs" />
    <Compile Include="DesktopCrashRuntime.cs" />
    <Compile Include="DesktopInstallLinkingRuntime.cs" />
    <Compile Include="DesktopPublicPortalRuntime.cs" />
    <Compile Include="DesktopRepoRootLocator.cs" />
    <Compile Include="DesktopStateRootResolver.cs" />
    <Compile Include="DesktopTrustReceiptComposer.cs" />
    <Compile Include="DesktopUpdateClientStatus.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunDesktopReleaseMatrixTestsOnly)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="DesktopPreferenceRuntime.cs" />
    <Compile Include="DesktopPublicPortalRuntime.cs" />
    <Compile Include="DesktopStateRootResolver.cs" />
    <Compile Include="DesktopUpdateClientStatus.cs" />
    <Compile Include="DesktopUpdateManifest.cs" />
    <Compile Include="DesktopUpdateRuntime.cs" />
  </ItemGroup>
</Project>
