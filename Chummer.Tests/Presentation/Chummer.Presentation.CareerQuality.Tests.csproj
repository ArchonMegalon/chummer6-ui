<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ChummerCoreRoot Condition="'$(ChummerCoreRoot)' == ''">../../../chummer-core-engine</ChummerCoreRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CareerQualityFocusedCompileStubs.cs" />
    <Compile Include="CareerQualityWorkflowTests.cs" />
    <Compile Include="../../Chummer.Presentation/Overview/CareerQualityWorkflow.cs"
             Link="Presentation/CareerQualityWorkflow.cs" />
    <Compile Include="$(ChummerCoreRoot)/Chummer.Contracts/Characters/CharacterCareerQualityRules.cs"
             Link="Core/CharacterCareerQualityRules.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.1.0" />
  </ItemGroup>
</Project>
