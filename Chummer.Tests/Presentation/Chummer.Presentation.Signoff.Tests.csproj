<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.VisualStudio.TestTools.UnitTesting.DoNotParallelizeAttribute" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="$(ChummerLocalCampaignContractsProject)" />
    <ProjectReference Include="$(ChummerLocalContractsProject)" />
    <ProjectReference Include="$(ChummerLocalRunContractsProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="$(ChummerCampaignContractsPackageId)" Version="$(ChummerCampaignContractsPackageVersion)" />
    <PackageReference Include="$(ChummerContractsPackageId)" Version="$(ChummerContractsPackageVersion)" />
    <PackageReference Include="$(ChummerRunContractsPackageId)" Version="$(ChummerRunContractsPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Chummer.Presentation\Chummer.Presentation.csproj"
                      ReferenceOutputAssembly="true"
                      Private="true" />
    <ProjectReference Include="..\..\..\chummer-core-engine\Chummer.Rulesets.Hosting\Chummer.Rulesets.Hosting.csproj"
                      Condition="Exists('..\..\..\chummer-core-engine\Chummer.Rulesets.Hosting\Chummer.Rulesets.Hosting.csproj')" />
    <ProjectReference Include="..\..\..\chummer-core-engine\Chummer.Rulesets.Sr5\Chummer.Rulesets.Sr5.csproj"
                      Condition="Exists('..\..\..\chummer-core-engine\Chummer.Rulesets.Sr5\Chummer.Rulesets.Sr5.csproj')" />
    <ProjectReference Include="..\..\..\chummer-core-engine\Chummer.Rulesets.Sr6\Chummer.Rulesets.Sr6.csproj"
                      Condition="Exists('..\..\..\chummer-core-engine\Chummer.Rulesets.Sr6\Chummer.Rulesets.Sr6.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AccessibilitySignoffSmokeTests.cs" />
    <Compile Include="CharacterRosterStructureParityGuardTests.cs" />
    <Compile Include="RulesetUiDirectiveCatalogTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>
  <Target Name="CopyPresentationRuntimeClosure" AfterTargets="Build">
    <PropertyGroup>
      <_PresentationRuntimeDir>$(MSBuildProjectDirectory)\..\..\Chummer.Presentation\bin\$(Configuration)\$(TargetFramework)\</_PresentationRuntimeDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_PresentationRuntimeDir)')">
      <_PresentationRuntimeFiles Include="$(_PresentationRuntimeDir)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_PresentationRuntimeFiles)"
      DestinationFiles="@(_PresentationRuntimeFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_PresentationRuntimeFiles)' != ''" />
  </Target>
</Project>
