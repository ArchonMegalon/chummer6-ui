    <PropertyGroup>
      <_FocusedBaselineHostDir>$([System.IO.Path]::GetFullPath('$(FocusedTestBaselineHostDir)'))</_FocusedBaselineHostDir>
      <_FocusedOutputDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</_FocusedOutputDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(_FocusedBaselineHostDir)')"
           Text="Focused test builds with BuildProjectReferences=false require a baseline test host at '$(_FocusedBaselineHostDir)'. Build Chummer.Tests once without focused compile pruning or set FocusedTestBaselineHostDir." />

    <ItemGroup Condition="'$(_FocusedBaselineHostDir)' != '$(_FocusedOutputDir)'">
      <_FocusedBaselineHostFile Include="$(_FocusedBaselineHostDir)**/*" />
    </ItemGroup>

    <Copy Condition="'$(_FocusedBaselineHostDir)' != '$(_FocusedOutputDir)'"
          SourceFiles="@(_FocusedBaselineHostFile)"
          DestinationFiles="@(_FocusedBaselineHostFile->'$(_FocusedOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
