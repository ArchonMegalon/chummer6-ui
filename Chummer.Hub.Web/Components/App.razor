@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <base href="@BuildBaseHref()" />
    <title>Chummer Hub Web</title>
    <link rel="stylesheet" href="hub.css" />
</head>
<body>
<Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
<script src="hub-api.js"></script>
<script src="campaign-join.js"></script>
<script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private string BuildBaseHref()
    {
        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? uri))
        {
            return "/";
        }

        if (string.IsNullOrWhiteSpace(uri.AbsolutePath) || string.Equals(uri.AbsolutePath, "/", StringComparison.Ordinal))
        {
            return "/";
        }

        return uri.AbsolutePath.EndsWith("/", StringComparison.Ordinal)
            ? uri.AbsolutePath
            : $"{uri.AbsolutePath}/";
    }
}
