<Project>
  <PropertyGroup>
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</RestorePackagesPath>
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == ''">$(MSBuildThisFileDirectory).tmp/nuget/packages</RestorePackagesPath>
    <BuildInParallel>false</BuildInParallel>
    <RestoreDisableParallel>true</RestoreDisableParallel>
    <MaxCpuCount>1</MaxCpuCount>
    <ChummerContractsPackageId Condition="'$(ChummerContractsPackageId)' == ''">Chummer.Engine.Contracts</ChummerContractsPackageId>
    <ChummerContractsPackageVersion Condition="'$(ChummerContractsPackageVersion)' == ''">0.0.0-packageplane.candidate.shfebd698752e19</ChummerContractsPackageVersion>
    <ChummerCampaignContractsPackageId Condition="'$(ChummerCampaignContractsPackageId)' == ''">Chummer.Campaign.Contracts</ChummerCampaignContractsPackageId>
    <ChummerCampaignContractsPackageVersion Condition="'$(ChummerCampaignContractsPackageVersion)' == ''">0.1.0-preview</ChummerCampaignContractsPackageVersion>
    <ChummerRunContractsPackageId Condition="'$(ChummerRunContractsPackageId)' == ''">Chummer.Run.Contracts</ChummerRunContractsPackageId>
    <ChummerRunContractsPackageVersion Condition="'$(ChummerRunContractsPackageVersion)' == ''">0.1.0-packageplane.candidate.sh66c418a5004f</ChummerRunContractsPackageVersion>
    <ChummerHubRegistryContractsPackageId Condition="'$(ChummerHubRegistryContractsPackageId)' == ''">Chummer.Hub.Registry.Contracts</ChummerHubRegistryContractsPackageId>
    <ChummerHubRegistryContractsPackageVersion Condition="'$(ChummerHubRegistryContractsPackageVersion)' == ''">0.1.0-packageplane.candidate.sh66c418a5004f</ChummerHubRegistryContractsPackageVersion>
    <ChummerUiKitPackageId Condition="'$(ChummerUiKitPackageId)' == ''">Chummer.Ui.Kit</ChummerUiKitPackageId>
    <ChummerUiKitPackageVersion Condition="'$(ChummerUiKitPackageVersion)' == ''">0.1.0-preview</ChummerUiKitPackageVersion>
    <ChummerCoreRuntimePackageVersion Condition="'$(ChummerCoreRuntimePackageVersion)' == ''">0.0.0-packageplane.candidate.shfebd698752e19</ChummerCoreRuntimePackageVersion>
    <ChummerCompatibilityRoot Condition="'$(ChummerCompatibilityRoot)' == ''">$(MSBuildThisFileDirectory)../</ChummerCompatibilityRoot>
    <ChummerLocalContractsProject Condition="'$(ChummerLocalContractsProject)' == ''">$(ChummerCompatibilityRoot)chummer-core-engine/Chummer.Contracts/Chummer.Contracts.csproj</ChummerLocalContractsProject>
    <ChummerLocalCampaignContractsProject Condition="'$(ChummerLocalCampaignContractsProject)' == ''">$(ChummerCompatibilityRoot)chummer.run-services/Chummer.Campaign.Contracts/Chummer.Campaign.Contracts.csproj</ChummerLocalCampaignContractsProject>
    <ChummerLocalHubRegistryContractsProject Condition="'$(ChummerLocalHubRegistryContractsProject)' == ''">$(ChummerCompatibilityRoot)chummer-hub-registry/Chummer.Hub.Registry.Contracts/Chummer.Hub.Registry.Contracts.csproj</ChummerLocalHubRegistryContractsProject>
    <ChummerLocalRunContractsProject Condition="'$(ChummerLocalRunContractsProject)' == ''">$(ChummerCompatibilityRoot)chummer.run-services/Chummer.Run.Contracts/Chummer.Run.Contracts.csproj</ChummerLocalRunContractsProject>
    <ChummerLocalUiKitProject Condition="'$(ChummerLocalUiKitProject)' == ''">$(ChummerCompatibilityRoot)chummer-ui-kit/src/Chummer.Ui.Kit/Chummer.Ui.Kit.csproj</ChummerLocalUiKitProject>
    <ChummerLocalMediaContractsProject Condition="'$(ChummerLocalMediaContractsProject)' == ''">$(ChummerCompatibilityRoot)fleet/repos/chummer-media-factory/src/Chummer.Media.Contracts/Chummer.Media.Contracts.csproj</ChummerLocalMediaContractsProject>
    <ChummerUseLocalCompatibilityTree Condition="'$(ChummerUseLocalCompatibilityTree)' == ''">false</ChummerUseLocalCompatibilityTree>
    <ChummerUseLockedOwnerContractPackages Condition="'$(ChummerUseLockedOwnerContractPackages)' == ''">false</ChummerUseLockedOwnerContractPackages>
  </PropertyGroup>
</Project>
