<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunBlazorShellComponentTestsOnly Condition="'$(RunBlazorShellComponentTestsOnly)' == ''">false</RunBlazorShellComponentTestsOnly>
    <OutputType Condition="'$(RunBlazorShellComponentTestsOnly)' == 'true'">Library</OutputType>
    <RookPortraitAsset>wwwroot/assets/build-ghosts/rook-female-ork-decker-v1.png</RookPortraitAsset>
    <RookPortraitSha256>4C7043F51D4171EF59F142594B5D0F363B7F7C336C72F032466B52E2541CEB14</RookPortraitSha256>
  </PropertyGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="$(ChummerLocalCampaignContractsProject)"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier)" />
    <ProjectReference Include="$(ChummerLocalContractsProject)"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier)" />
    <ProjectReference Include="$(ChummerLocalRunContractsProject)"
                      Condition="'$(ChummerUseLockedOwnerContractPackages)' != 'true'"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' == 'true' and '$(ChummerUseLockedOwnerContractPackages)' == 'true'">
    <PackageReference Include="$(ChummerRunContractsPackageId)" Version="$(ChummerRunContractsPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="$(ChummerCampaignContractsPackageId)" Version="$(ChummerCampaignContractsPackageVersion)" />
    <PackageReference Include="$(ChummerContractsPackageId)" Version="$(ChummerContractsPackageVersion)" />
    <PackageReference Include="$(ChummerRunContractsPackageId)" Version="$(ChummerRunContractsPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <ProjectReference Include="..\Chummer.Desktop.Runtime\Chummer.Desktop.Runtime.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="..\Chummer.Presentation\Chummer.Presentation.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
    <ProjectReference Include="..\Chummer.Workspaces.Postgres\Chummer.Workspaces.Postgres.csproj"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Chummer.Tests\TestFiles\BLUE.chum5"
             Link="Fixtures\BLUE.chum5"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Update="$(RookPortraitAsset)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunBlazorShellComponentTestsOnly)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <Target Name="VerifyRookPortraitPackage" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RookPortraitFile Include="$(MSBuildProjectDirectory)/$(RookPortraitAsset)" />
    </ItemGroup>
    <Error Condition="!Exists('@(_RookPortraitFile)')"
           Text="The Build Ghost Rook portrait is missing from the Blazor package." />
    <GetFileHash Files="@(_RookPortraitFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_RookPortraitHashed" />
    </GetFileHash>
    <Error Condition="'%(_RookPortraitHashed.FileHash)' != '$(RookPortraitSha256)'"
           Text="The packaged Build Ghost Rook portrait does not match the approved release digest." />
  </Target>
</Project>
