{
  "name": "Chummer Runner Builder",
  "short_name": "Chummer Build",
  "description": "Installable character-building workspace for creating, opening, and managing Chummer runners.",
  "id": "./app",
  "start_url": "./app?command=character_roster&source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#08111f",
  "theme_color": "#0f3b3e",
  "orientation": "any",
  "categories": ["games", "productivity", "utilities"],
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/chummer-build-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/chummer-build-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/chummer-build-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/chummer-build-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/chummer-pwa.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/chummer-pwa-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Runner",
      "short_name": "New",
      "description": "Start a new runner in the character-building workspace.",
      "url": "./app?command=new_character&source=pwa-shortcut",
      "icons": [
        {
          "src": "icons/chummer-build-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Runner Roster",
      "short_name": "Roster",
      "description": "Choose an existing runner or return to the build roster.",
      "url": "./app?command=character_roster&source=pwa-shortcut",
      "icons": [
        {
          "src": "icons/chummer-build-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "media/chummer6/chummer6-hero.png",
      "sizes": "1600x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Chummer Runner Builder roster and build workspace"
    },
    {
      "src": "media/chummer6/karma-forge.png",
      "sizes": "960x540",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Runner creation tools and character workflow lanes"
    }
  ]
}
