    protected override void OnInitialized()
    {
        Presenter.StateChanged += OnPresenterStateChanged;
    }

    public void Dispose()
    {
        Presenter.StateChanged -= OnPresenterStateChanged;
    }

    private void OnPresenterStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OpenShellCommandFromSurfaceAsync(string commandId)
    {
        string fallbackHref = BuildPreviewHref(command: commandId, useWorkbenchRoute: true);
        if (!IsAppRoute && !IsWorkbenchRoute)
        {
            Navigation.NavigateTo(fallbackHref);
            return;
        }

        if (_desktopShell is null)
        {
            Navigation.NavigateTo(fallbackHref);
            return;
        }

        await _desktopShell.ExecuteCommandFromSurfaceAsync(commandId);
    }

    private IReadOnlyList<RecentWorkspaceLink> BuildRecentWorkspaceLinks()
    {
        Dictionary<string, OpenWorkspaceState> openWorkspaces = Presenter.State.Session.OpenWorkspaces
            .ToDictionary(workspace => workspace.Id.Value, StringComparer.Ordinal);

        return Presenter.State.Session.RecentWorkspaceIds
            .Select(recentWorkspaceId =>
            {
                if (openWorkspaces.TryGetValue(recentWorkspaceId.Value, out OpenWorkspaceState? openWorkspace))
                {
                    string savedLabel = openWorkspace.HasSavedWorkspace ? "saved" : "unsaved";
                    return new RecentWorkspaceLink(
                        recentWorkspaceId.Value,
                        $"{openWorkspace.Alias} · {openWorkspace.Name} · {openWorkspace.RulesetId} · {savedLabel}",
                        openWorkspace.Alias);
                }

                return new RecentWorkspaceLink(recentWorkspaceId.Value, recentWorkspaceId.Value, recentWorkspaceId.Value);
            })
            .ToArray();
    }

    private string BuildPreviewHref(string? fixture = null, string? workspace = null, string? tab = null, string? command = null, string? control = null, string? dialogAction = null, bool useWorkbenchRoute = false)
    {
        List<string> query = [];
        if (!string.IsNullOrWhiteSpace(fixture))
        {
            query.Add($"{FixtureQueryName}={Uri.EscapeDataString(fixture)}");
        }

        if (!string.IsNullOrWhiteSpace(workspace))
        {
            query.Add($"{WorkspaceQueryName}={Uri.EscapeDataString(workspace)}");
        }

        if (!string.IsNullOrWhiteSpace(tab))
        {
            query.Add($"{TabQueryName}={Uri.EscapeDataString(tab)}");
        }

        if (!string.IsNullOrWhiteSpace(command))
        {
            query.Add($"{CommandQueryName}={Uri.EscapeDataString(command)}");
        }

        if (!string.IsNullOrWhiteSpace(control))
        {
            query.Add($"{ControlQueryName}={Uri.EscapeDataString(control)}");
        }

        if (!string.IsNullOrWhiteSpace(dialogAction))
        {
            query.Add($"{DialogActionQueryName}={Uri.EscapeDataString(dialogAction)}");
        }

        // Keep these as path-base-safe relative hrefs; public route contracts remain /blazor/* at the portal edge.
        string route = useWorkbenchRoute ? (IsAppRoute ? AppRouteSegment : WorkbenchRouteSegment) : PreviewRouteSegment;
        return query.Count == 0
            ? route
            : $"{route}?{string.Join("&", query)}";
    }

    private string BuildWorkbenchLaneHref(string tabId)
        => PrimaryRecentWorkspace is null
            ? BuildPreviewHref(SeededWorkspaceId, tab: tabId, useWorkbenchRoute: true)
            : BuildPreviewHref(workspace: PrimaryRecentWorkspace.WorkspaceId, tab: tabId, useWorkbenchRoute: true);

    private string BuildWorkbenchLaneLabel(string seededLabel, string laneName)
        => PrimaryRecentWorkspace is null
            ? seededLabel
            : $"Continue {PrimaryRecentWorkspace.ShortLabel} on {laneName}";

    private string BuildWorkbenchCommandHref(string commandId, string? dialogAction = null)
        => PrimaryRecentWorkspace is null
            ? BuildPreviewHref(SeededWorkspaceId, command: commandId, dialogAction: dialogAction, useWorkbenchRoute: true)
            : BuildPreviewHref(workspace: PrimaryRecentWorkspace.WorkspaceId, command: commandId, dialogAction: dialogAction, useWorkbenchRoute: true);

    private string BuildWorkbenchCommandLabel(string seededLabel, string workflowName)
        => PrimaryRecentWorkspace is null
            ? seededLabel
            : $"Continue {PrimaryRecentWorkspace.ShortLabel} for {workflowName}";

    private static bool IsConfigured(string? value)
        => !string.IsNullOrWhiteSpace(value);

    private static string BuildRuntimeLaneState(string? value)
        => IsConfigured(value) ? "configured" : "off";

    private sealed record RecentWorkspaceLink(string WorkspaceId, string Label, string ShortLabel);
