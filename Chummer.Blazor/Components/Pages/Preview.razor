@namespace Chummer.Blazor.Components.Pages
@page "/preview"
@page "/workbench"
@layout Chummer.Blazor.Components.Layout.NoLayout
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Configuration
@using Chummer.Blazor.Components.Layout
@using Chummer.Presentation.Overview
@implements IDisposable

<PageTitle>Chummer Browser Workbench</PageTitle>

<main class="browser-preview-shell">
    <header class="browser-preview-banner">
        <div class="browser-preview-banner-copy">
            @if (IsWorkbenchRoute)
            {
                <p class="browser-preview-kicker">Browser workbench</p>
                <h1>Chummer's shared workbench shell, running in the browser.</h1>
                <p>
                    This is the product-shaped browser workbench entrypoint: the same shared shell, navigation, and workflow contracts,
                    presented as a real web client surface instead of a proof-only lane.
                </p>
            }
            else
            {
                <p class="browser-preview-kicker">Live browser workbench</p>
                <h1>Chummer's shared workbench shell, running in the browser.</h1>
                <p>
                    This route runs the browser-facing Chummer shell with the same shared navigation and workflow contracts used elsewhere in the product.
                    The desktop client still owns native install and file-heavy operations, but this surface is more than a guided mock.
                </p>
            }
        </div>

        <nav class="browser-preview-actions" aria-label="Workbench navigation">
            <a href="/">Public home</a>
            @if (IsWorkbenchRoute)
            {
                <a href="/preview">Preview routes</a>
            }
            else
            {
                <a href="/workbench">Workbench route</a>
            }
            <a href="/showcase">Showcase</a>
            <a href="/downloads/">Downloads</a>
            <a href="/docs/">Docs</a>
        </nav>
    </header>

    <section class="browser-preview-boundary" aria-label="Boundary notice">
        <div>
            <strong>Browser-owned here:</strong> responsive shell navigation, implicit owner session posture, and browser-ready workflows that already have parity proof.
        </div>
        <div>
            <strong>Desktop-owned still:</strong> native install continuity, local-file-heavy operations, and any workflow slice that has not yet been proven end to end in browser.
        </div>
    </section>

    <section class="browser-preview-status-grid" aria-label="Workbench status">
        <article class="browser-preview-status-card">
            <span class="browser-preview-status-label">Deployment</span>
            <strong>Published self-hosted Docker surface</strong>
            <p>Portal, browser shell, docs, downloads, and API routes are exposed through one public front door.</p>
        </article>
        <article class="browser-preview-status-card">
            <span class="browser-preview-status-label">Session</span>
            <strong>Implicit owner sign-in</strong>
            <p>The browser-facing stack carries a self-hosted owner identity without forcing an explicit login wall first.</p>
        </article>
        <article class="browser-preview-status-card">
            <span class="browser-preview-status-label">Workflow truth</span>
            <strong>Parity where implemented, boundaries where not</strong>
            <p>The browser surface is allowed to claim real capability, but it must keep native-only paths clearly separated.</p>
        </article>
        <article class="browser-preview-status-card"
                 data-connected-runtime-posture
                 data-connected-runtime-session="@BuildRuntimeLaneState(Configuration["CHUMMER_PORTAL_SESSION_PROXY_URL"])"
                 data-connected-runtime-coach="@BuildRuntimeLaneState(Configuration["CHUMMER_PORTAL_COACH_PROXY_URL"])"
                 data-connected-runtime-ai="@BuildRuntimeLaneState(Configuration["CHUMMER_PORTAL_AI_PROXY_URL"])">
            <span class="browser-preview-status-label">Connected runtime</span>
            <strong>@BuildConnectedRuntimeTitle()</strong>
            <p>@BuildConnectedRuntimeSummary()</p>
        </article>
    </section>

    @if (IsWorkbenchRoute)
    {
        <section class="browser-preview-status-grid" aria-label="Workbench route guidance">
            <article class="browser-preview-status-card">
                <span class="browser-preview-status-label">Product route</span>
                <strong>Use this route as the browser client entrypoint</strong>
                <p>The shell below is the product-facing browser workbench route while broader parity work continues to mature.</p>
            </article>
            <article class="browser-preview-status-card">
                <span class="browser-preview-status-label">Preview</span>
                <strong>Open detailed browser routes on demand</strong>
                <p>Use the preview route when you need startup deep links, seeded workflows, and browser result-state checks.</p>
                <a href="/preview">Open preview routes</a>
            </article>
        </section>

        <section class="browser-workbench-task-dock" aria-label="Promoted workbench task dock" data-workbench-polish="task-dock">
            <div class="browser-workbench-task-dock-copy">
                <span class="browser-preview-status-label">Task dock</span>
                <strong>Keep the common Chummer jobs one click from the browser workbench.</strong>
                <p>Start, edit, output, and portal handoff stay in one dense strip.</p>
            </div>
            <nav class="browser-workbench-task-dock-actions" aria-label="Workbench task shortcuts">
                <a href="@BuildPreviewHref(command: "new_character", useWorkbenchRoute: true)" data-workbench-dock-action="start-new">New runner</a>
                <a href="@BuildPreviewHref(command: "open_character", useWorkbenchRoute: true)" data-workbench-dock-action="open-existing">Open/import</a>
                <a href="@BuildLabLaneHref" data-workbench-dock-action="build-lab">Build lab</a>
                <a href="@GearLaneHref" data-workbench-dock-action="gear">Gear</a>
                <a href="@SaveAsFlowHref" data-workbench-dock-action="save-as">Save/download</a>
                <a href="@ExportFlowHref" data-workbench-dock-action="export">Export</a>
                <a href="@PrintFlowHref" data-workbench-dock-action="print">Print</a>
                <a href="/downloads/" data-workbench-dock-action="downloads">Desktop installers</a>
                <a href="/contact" data-workbench-dock-action="support">Support</a>
            </nav>
        </section>

        <section class="browser-workbench-recovery-strip" aria-label="Workbench session recovery" data-workbench-recovery="strip">
            <div class="browser-workbench-recovery-copy">
                <span class="browser-preview-status-label">Session recovery</span>
                <strong>Resume without restarting the job.</strong>
                <p>Refresh, direct entry, and portal handoff should keep the browser client in the same work rhythm as desktop Chummer.</p>
            </div>
            <div class="browser-workbench-recovery-actions">
                <a href="@ContinueRecentHref" data-workbench-recovery-action="continue-recent">@ContinueRecentLabel</a>
                <a href="@BuildLabLaneHref" data-workbench-recovery-action="build-lab">@BuildLabLaneLabel</a>
                <a href="@ProfileLaneHref" data-workbench-recovery-action="profile">Profile lane</a>
                <a href="/status" data-workbench-recovery-action="status">Status fallback</a>
            </div>
            @if (PrimaryRecentWorkspace is not null)
            {
                <div class="browser-workbench-recovery-detail">
                    <span data-workbench-recovery-workspace="@PrimaryRecentWorkspace.WorkspaceId">Restored runner: @PrimaryRecentWorkspace.ShortLabel</span>
                    <a href="@BuildPreviewHref(workspace: PrimaryRecentWorkspace.WorkspaceId, useWorkbenchRoute: true)"
                       data-workbench-recovery-action="restore-workspace">
                        Restore shell
                    </a>
                    <a href="@BuildPreviewHref(workspace: PrimaryRecentWorkspace.WorkspaceId, tab: "tab-gear", useWorkbenchRoute: true)"
                       data-workbench-recovery-action="restore-gear">
                        Restore gear
                    </a>
                    <a href="@BuildPreviewHref(workspace: PrimaryRecentWorkspace.WorkspaceId, command: "save_character_as", useWorkbenchRoute: true)"
                       data-workbench-recovery-action="restore-output">
                        Restore output
                    </a>
                </div>
            }
            else
            {
                <div class="browser-workbench-recovery-detail">
                    <span data-workbench-recovery-empty="true">No restored runner yet. Start, import, or open the seeded dossier to establish browser continuity.</span>
                </div>
            }
        </section>

        <section class="browser-workbench-hosting-strip" aria-label="Workbench hosting and privacy posture" data-workbench-hosting="strip">
            <div class="browser-workbench-hosting-copy">
                <span class="browser-preview-status-label">Hosting and privacy</span>
                <strong>Same workbench, hosted or self-hosted.</strong>
                <p>The browser client is meant to run on `chummer.run` and in Docker without changing the user workflow or quietly changing telemetry expectations.</p>
            </div>
            <div class="browser-workbench-hosting-cards">
                <article data-workbench-hosting-card="public-edge">
                    <span>Hosted route</span>
                    <strong>/blazor/workbench</strong>
                    <p>The promoted browser client stays behind the portal front door so downloads, support, status, and account handoff remain same-origin.</p>
                </article>
                <article data-workbench-hosting-card="docker-self-host">
                    <span>Self-host</span>
                    <strong>Docker portal profile</strong>
                    <p>Self-hosted operators keep the same portal/API/Blazor shape, with owner context and analytics defaults controlled by environment.</p>
                </article>
                <article data-workbench-hosting-card="analytics-privacy">
                    <span>Analytics</span>
                    <strong>Rybbit is optional and metadata-only</strong>
                    <p>Hosted analytics may use route/workflow metadata; self-host defaults stay off and must not send character, owner, runner file, XML, or dossier content.</p>
                </article>
            </div>
        </section>

        <section class="browser-workbench-command-palette" aria-label="Workbench command palette posture" data-workbench-command-palette="strip">
            <div class="browser-workbench-command-copy">
                <span class="browser-preview-status-label">Command palette</span>
                <strong>Chummer habits, browser-safe commands.</strong>
                <p>Keep common Chummer actions discoverable with keyboard-style hints while every command remains a reload-safe workbench link.</p>
            </div>
            <details open class="browser-workbench-command-panel" data-workbench-command-palette-panel="primary">
                <summary>Quick command map</summary>
                <div class="browser-workbench-command-list" role="list">
                    <a href="@BuildPreviewHref(command: "new_character", useWorkbenchRoute: true)"
                       role="listitem"
                       aria-keyshortcuts="Control+N"
                       data-workbench-command-palette-action="new-character">
                        <kbd>Ctrl</kbd><kbd>N</kbd><span>New runner</span>
                    </a>
                    <a href="@BuildPreviewHref(command: "open_character", useWorkbenchRoute: true)"
                       role="listitem"
                       aria-keyshortcuts="Control+O"
                       data-workbench-command-palette-action="open-character">
                        <kbd>Ctrl</kbd><kbd>O</kbd><span>Open/import</span>
                    </a>
                    <a href="@BuildLabLaneHref"
                       role="listitem"
                       aria-keyshortcuts="Control+B"
                       data-workbench-command-palette-action="build-lab">
                        <kbd>Ctrl</kbd><kbd>B</kbd><span>Build Lab</span>
                    </a>
                    <a href="@GearLaneHref"
                       role="listitem"
                       aria-keyshortcuts="Control+G"
                       data-workbench-command-palette-action="gear">
                        <kbd>Ctrl</kbd><kbd>G</kbd><span>Gear</span>
                    </a>
                    <a href="@SaveAsFlowHref"
                       role="listitem"
                       aria-keyshortcuts="Control+S"
                       data-workbench-command-palette-action="save-download">
                        <kbd>Ctrl</kbd><kbd>S</kbd><span>Save/download</span>
                    </a>
                    <a href="@PrintFlowHref"
                       role="listitem"
                       aria-keyshortcuts="Control+P"
                       data-workbench-command-palette-action="print">
                        <kbd>Ctrl</kbd><kbd>P</kbd><span>Print</span>
                    </a>
                    <a href="/contact"
                       role="listitem"
                       aria-keyshortcuts="F1"
                       data-workbench-command-palette-action="support">
                        <kbd>F1</kbd><span>Support</span>
                    </a>
                </div>
            </details>
        </section>

        <section class="browser-workbench-density-strip" aria-label="Workbench density posture" data-workbench-density="strip">
            <div class="browser-workbench-density-copy">
                <span class="browser-preview-status-label">Density posture</span>
                <strong>Dense by default, readable when needed.</strong>
                <p>Chummer web should start from compact desktop ergonomics, then expose comfortable and mobile-safe postures without changing the workflow model.</p>
            </div>
            <fieldset class="browser-workbench-density-options" data-workbench-density-panel="display">
                <legend>Display density</legend>
                <label for="workbench-density-compact" data-workbench-density-option="compact">
                    <input id="workbench-density-compact" name="workbench-density" type="radio" checked="checked" />
                    <span>Compact desktop</span>
                    <small>Dense rows, short labels, maximum sheet context.</small>
                </label>
                <label for="workbench-density-comfortable" data-workbench-density-option="comfortable">
                    <input id="workbench-density-comfortable" name="workbench-density" type="radio" />
                    <span>Comfortable review</span>
                    <small>More breathing room for rules, dialogs, and source review.</small>
                </label>
                <label for="workbench-density-mobile" data-workbench-density-option="mobile">
                    <input id="workbench-density-mobile" name="workbench-density" type="radio" />
                    <span>Mobile safe</span>
                    <small>Single-column fallback while keeping the same commands.</small>
                </label>
            </fieldset>
        </section>

        <section class="browser-workbench-workflow-ledger" aria-label="Workbench workflow summary" data-workbench-workflow-ledger="strip">
            <div class="browser-workbench-ledger-copy">
                <span class="browser-preview-status-label">Workbench</span>
                <strong>See what opens here.</strong>
                <p>A compact map of the browser client, with clear handoffs when desktop is still the better tool.</p>
            </div>
            <div class="browser-workbench-ledger-grid">
                <article data-workbench-ledger-row="startup">
                    <span>Startup</span>
                    <strong>New runners, open files, origins, and lists</strong>
                    <p>Common entry points stay in the browser and survive a reload.</p>
                </article>
                <article data-workbench-ledger-row="editing">
                    <span>Editing</span>
                    <strong>Dense runner sections and focused dialogs</strong>
                    <p>Sheet work stays section-based so the page does not turn into a wall of controls.</p>
                </article>
                <article data-workbench-ledger-row="output">
                    <span>Output</span>
                    <strong>Save, download, export, and print</strong>
                    <p>Browser-safe output is visible; native file work hands off cleanly.</p>
                </article>
                <article data-workbench-ledger-row="recovery">
                    <span>Recovery</span>
                    <strong>Recent, restored, and direct-entry work</strong>
                    <p>Continuation paths are visible before the user has to hunt for them.</p>
                </article>
                <article data-workbench-ledger-row="portal">
                    <span>Portal</span>
                    <strong>Downloads, status, support, and account work</strong>
                    <p>Account and support links stay on the Chummer route.</p>
                </article>
                <article data-workbench-ledger-row="proof">
                    <span>Boundaries</span>
                    <strong>Some desktop-only actions still open Chummer desktop</strong>
                    <p>The browser route names those handoffs instead of pretending every native action belongs here.</p>
                </article>
            </div>
        </section>

        <section class="browser-workbench-file-intake" aria-label="Workbench files" data-workbench-file-intake="strip">
            <div class="browser-workbench-file-intake-copy">
                <span class="browser-preview-status-label">Files</span>
                <strong>Open or import a runner.</strong>
                <p>Paste XML in the browser, keep Hero Lab and XML tools nearby, or use desktop when direct file access matters.</p>
            </div>
            <div class="browser-workbench-file-intake-actions">
                <a href="@BuildPreviewHref(command: "open_character", useWorkbenchRoute: true)"
                   data-workbench-file-intake-action="open-character">
                    <span>Open</span>
                    <small>Paste or stage Chummer XML.</small>
                </a>
                <a href="@BuildPreviewHref(command: "hero_lab_importer", useWorkbenchRoute: true)"
                   data-workbench-file-intake-action="hero-lab">
                    <span>Hero Lab import</span>
                    <small>Bring in a Hero Lab runner.</small>
                </a>
                <a href="@BuildPreviewHref(command: "xml_editor", useWorkbenchRoute: true)"
                   data-workbench-file-intake-action="xml-editor">
                    <span>XML editor</span>
                    <small>Inspect bridge and custom data.</small>
                </a>
                <a href="/downloads/"
                   data-workbench-file-intake-action="desktop-handoff">
                    <span>Desktop</span>
                    <small>Use native file dialogs.</small>
                </a>
                <a href="/contact"
                   data-workbench-file-intake-action="support">
                    <span>Help</span>
                    <small>Get help with files or installs.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-rules-data" aria-label="Workbench rules" data-workbench-rules-data="strip">
            <div class="browser-workbench-rules-data-copy">
                <span class="browser-preview-status-label">Rules</span>
                <strong>Check rules and references.</strong>
                <p>Open ruleset, source, XML, or language tools without leaving the workbench.</p>
            </div>
            <div class="browser-workbench-rules-data-actions">
                <a href="@RulesLaneHref"
                   data-workbench-rules-data-action="rules-review">
                    <span>Rules</span>
                    <small>Open the active rules lane.</small>
                </a>
                <a href="@BuildPreviewHref(command: "switch_ruleset", useWorkbenchRoute: true)"
                   data-workbench-rules-data-action="switch-ruleset">
                    <span>Ruleset</span>
                    <small>Review edition choice.</small>
                </a>
                <a href="@BuildPreviewHref(command: "master_index", useWorkbenchRoute: true)"
                   data-workbench-rules-data-action="master-index">
                    <span>Index</span>
                    <small>Browse sources and references.</small>
                </a>
                <a href="@BuildPreviewHref(command: "xml_editor", useWorkbenchRoute: true)"
                   data-workbench-rules-data-action="xml-editor">
                    <span>XML data</span>
                    <small>Inspect custom data.</small>
                </a>
                <a href="@BuildPreviewHref(command: "translator", useWorkbenchRoute: true)"
                   data-workbench-rules-data-action="translator">
                    <span>Language</span>
                    <small>Check translations.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-settings" aria-label="Workbench settings" data-workbench-settings="strip">
            <div class="browser-workbench-settings-copy">
                <span class="browser-preview-status-label">Settings</span>
                <strong>Change setup without leaving the page.</strong>
                <p>Open app settings, character defaults, ruleset choice, update status, or help from the workbench.</p>
            </div>
            <div class="browser-workbench-settings-actions">
                <a href="@BuildPreviewHref(command: "global_settings", useWorkbenchRoute: true)"
                   data-workbench-settings-action="global-settings">
                    <span>App</span>
                    <small>Language, UI, and defaults.</small>
                </a>
                <a href="@BuildPreviewHref(command: "character_settings", useWorkbenchRoute: true)"
                   data-workbench-settings-action="character-settings">
                    <span>Character</span>
                    <small>Build, karma, nuyen, and notes.</small>
                </a>
                <a href="@BuildPreviewHref(command: "switch_ruleset", useWorkbenchRoute: true)"
                   data-workbench-settings-action="ruleset-settings">
                    <span>Ruleset</span>
                    <small>Change edition preference.</small>
                </a>
                <a href="/status"
                   data-workbench-settings-action="update-status">
                    <span>Updates</span>
                    <small>Check release status.</small>
                </a>
                <a href="@BuildPreviewHref(command: "report_bug", useWorkbenchRoute: true)"
                   data-workbench-settings-action="support-settings">
                    <span>Help</span>
                    <small>Open support or report an issue.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-diagnostics" aria-label="Workbench diagnostics" data-workbench-diagnostics="strip">
            <div class="browser-workbench-diagnostics-copy">
                <span class="browser-preview-status-label">Diagnostics</span>
                <strong>Check the app when something feels off.</strong>
                <p>Open runtime details, About, health, release status, or preview tools from the workbench.</p>
            </div>
            <div class="browser-workbench-diagnostics-actions">
                <a href="@BuildPreviewHref(command: OverviewCommandPolicy.RuntimeInspectorCommandId, useWorkbenchRoute: true)"
                   data-workbench-diagnostics-action="runtime-inspector">
                    <span>Runtime</span>
                    <small>Inspect current browser state.</small>
                </a>
                <a href="@BuildPreviewHref(command: "about", useWorkbenchRoute: true)"
                   data-workbench-diagnostics-action="about">
                    <span>About</span>
                    <small>Review client identity.</small>
                </a>
                <a href="/blazor/health"
                   data-workbench-diagnostics-action="health">
                    <span>Health</span>
                    <small>Check the browser service.</small>
                </a>
                <a href="/status"
                   data-workbench-diagnostics-action="status">
                    <span>Status</span>
                    <small>Read release status.</small>
                </a>
                <a href="/preview"
                   data-workbench-diagnostics-action="proof-shelf">
                    <span>Preview</span>
                    <small>Open preview tools.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-connected-runtime" aria-label="Workbench live lanes" data-workbench-connected-runtime="strip">
            <div class="browser-workbench-connected-runtime-copy">
                <span class="browser-preview-status-label">Live lanes</span>
                <strong>Use connected tools when they are available.</strong>
                <p>Play, session, coach, assistant, and status links stay close without changing the workbench.</p>
            </div>
            <div class="browser-workbench-connected-runtime-actions">
                <a href="/play"
                   data-workbench-connected-runtime-action="play-session">
                    <span>Play</span>
                    <small>Open the portal play shell.</small>
                </a>
                <a href="/session/"
                   data-workbench-connected-runtime-action="session-runtime">
                    <span>Session</span>
                    <small>Use configured session forwarding.</small>
                </a>
                <a href="/coach/"
                   data-workbench-connected-runtime-action="coach-runtime">
                    <span>Coach</span>
                    <small>Use configured coach handoff.</small>
                </a>
                <a href="@BuildPreviewHref(command: "auto_alice", useWorkbenchRoute: true)"
                   data-workbench-connected-runtime-action="auto-alice">
                    <span>Assistant</span>
                    <small>Open the optional assistant lane.</small>
                </a>
                <a href="/status"
                   data-workbench-connected-runtime-action="runtime-status">
                    <span>Status</span>
                    <small>Check configured/off posture.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-accessibility" aria-label="Workbench accessibility" data-workbench-accessibility="strip">
            <div class="browser-workbench-accessibility-copy">
                <span class="browser-preview-status-label">Accessibility</span>
                <strong>Desktop density without hidden controls.</strong>
                <p>Keyboard order, dialog fit, readable density, reduced motion, and help links stay close.</p>
            </div>
            <div class="browser-workbench-accessibility-actions">
                <a href="@BuildPreviewHref(command: "global_settings", useWorkbenchRoute: true)"
                   data-workbench-accessibility-action="keyboard-order">
                    <span>Keyboard</span>
                    <small>Keep commands reachable.</small>
                </a>
                <a href="@BuildPreviewHref(command: "character_settings", useWorkbenchRoute: true)"
                   data-workbench-accessibility-action="dialog-fit">
                    <span>Dialog fit</span>
                    <small>Keep dialogs inside the viewport.</small>
                </a>
                <a href="#workbench-density-compact"
                   data-workbench-accessibility-action="density">
                    <span>Density</span>
                    <small>Use compact or comfortable layout.</small>
                </a>
                <a href="/status"
                   data-workbench-accessibility-action="reduced-motion">
                    <span>Motion</span>
                    <small>Keep status readable without animation.</small>
                </a>
                <a href="/contact"
                   data-workbench-accessibility-action="support">
                    <span>Help</span>
                    <small>Open support when a task breaks.</small>
                </a>
            </div>
        </section>

        <section class="browser-workbench-section-rail" aria-label="Workbench sheet section rail" data-workbench-section-rail="strip">
            <div class="browser-workbench-section-rail-copy">
                <span class="browser-preview-status-label">Sheet rail</span>
                <strong>Move straight to a section.</strong>
                <p>Profile, build, skills, gear, combat, magic, matrix, contacts, and career stay close.</p>
            </div>
            <nav class="browser-workbench-section-rail-actions" aria-label="Character sheet section shortcuts">
                <a href="@BuildWorkbenchLaneHref("tab-info")" data-workbench-section-rail-action="profile">Profile</a>
                <a href="@BuildWorkbenchLaneHref("tab-create")" data-workbench-section-rail-action="build">Build</a>
                <a href="@BuildWorkbenchLaneHref("tab-skills")" data-workbench-section-rail-action="skills">Skills</a>
                <a href="@BuildWorkbenchLaneHref("tab-gear")" data-workbench-section-rail-action="gear">Gear</a>
                <a href="@BuildWorkbenchLaneHref("tab-combat")" data-workbench-section-rail-action="combat">Combat</a>
                <a href="@BuildWorkbenchLaneHref("tab-magician")" data-workbench-section-rail-action="magic">Magic</a>
                <a href="@BuildWorkbenchLaneHref("tab-technomancer")" data-workbench-section-rail-action="matrix">Matrix</a>
                <a href="@BuildWorkbenchLaneHref("tab-contacts")" data-workbench-section-rail-action="contacts">Contacts</a>
