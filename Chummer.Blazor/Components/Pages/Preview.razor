@namespace Chummer.Blazor.Components.Pages
@page "/preview"
@page "/app"
@page "/online"
@page "/workbench"
@layout Chummer.Blazor.Components.Layout.NoLayout
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Configuration
@using Chummer.Blazor.Components.Layout
@using Chummer.Blazor.RunnerIntelligence
@using Chummer.Presentation.Overview
@using Chummer.Presentation.RunnerIntelligence
@implements IDisposable
@inject BlazorRunnerIntelligencePreviewService RunnerIntelligencePreviewService

<PageTitle>@PageTitleText</PageTitle>

<main class="browser-preview-shell @(IsAppRoute ? "classic-promoted-app" : IsWorkbenchRoute ? "classic-compat-app" : "classic-preview-tools")">
    <header class="browser-preview-banner">
        <div class="browser-preview-banner-copy">
            @if (IsAppRoute)
            {
                <p class="browser-preview-kicker">Chummer Online</p>
                <h1>Explore Chummer Online.</h1>
                <p>
                    This is the Chummer Online entrypoint: open, organize, build, review, export, and resume runners through the shared Chummer shell without exposing proof-route language.
                </p>
            }
            else if (IsWorkbenchRoute)
            {
                <p class="browser-preview-kicker">Compatibility route</p>
                <h1>Chummer Online compatibility shell, running in the browser.</h1>
                <p>
                    This route keeps older workbench and proof links alive. The user-facing product route is Chummer Online at <code>/blazor/app</code>.
                </p>
            }
            else
            {
                <p class="browser-preview-kicker">Preview route tools</p>
                <h1>Preview Chummer Online workflows without changing the public route.</h1>
                <p>
                    This route is for startup deep links, seeded workflows, and browser result-state checks. Use Chummer Online for the normal user workflow.
                </p>
            }
        </div>

        <nav class="browser-preview-actions" aria-label="@RouteNavigationLabel">
            <a href="@HomeHref">Public home</a>
            @if (IsAppRoute)
            {
                <a href="@PreviewHref">Preview tools</a>
            }
            else if (IsWorkbenchRoute)
            {
                <a href="@AppHref">Chummer Online</a>
                <a href="@PreviewHref">Preview tools</a>
            }
            else
            {
                <a href="@AppHref">Chummer Online</a>
                <a href="@WorkbenchRouteSegment">Compatibility route</a>
            }
            <a href="@ShowcaseHref">Showcase</a>
            <a href="@DownloadsHref">Downloads</a>
            <a href="@DocsHref">Docs</a>
        </nav>
    </header>

    @if (IsAppRoute || IsWorkbenchRoute)
    {
        <section class="classic-chummer-shell" aria-label="Chummer Online classic desktop shell" data-chummer-classic-shell="true" data-active-workflow="@ActiveWorkflowDataKey" data-output-workflow="@OutputWorkflowDataKey" data-output-state="@OutputStateDataKey" data-output-target="@OutputTargetDataKey" data-route-family="@RouteFamilyDataKey" data-route-segment="@RouteSegmentDataKey" data-route-surface="@RouteSurfaceDataKey" data-canonical-route="@CanonicalRouteDataKey" data-route-alias="@RouteAliasDataKey" data-command="@CommandDataKey" data-tab="@TabDataKey" data-workspace="@WorkspaceDataKey" data-active-runner="@ActiveRunnerDataKey" data-roster-selected-node="@SelectedRosterNodeDataKey" data-dossier-state="@DossierStateDataKey" data-dossier-storage="@DossierStorageDataKey" data-ruleset="@RulesetDataKey" data-validation-state="@ValidationStateDataKey" data-privacy-mode="@PrivacyModeDataKey" data-analytics-scope="@AnalyticsScopeDataKey" data-hosting-mode="@HostingModeDataKey" data-deployment-target="@DeploymentTargetDataKey" data-self-hostable="@SelfHostableDataKey" data-container-target="@ContainerTargetDataKey" data-auth-gate="@AuthGateDataKey" data-session-state="@SessionStateDataKey" data-login-target="@LoginTargetDataKey" data-auth-return-policy="@AuthReturnPolicyDataKey" data-fixture="@FixtureDataKey" data-legacy-runner="@LegacyRunnerDataKey" data-control="@ControlDataKey" data-dialog-action="@DialogActionDataKey" data-client-kind="@ClientKindDataKey" data-parity-target="@ParityTargetDataKey" data-calculation-owner="@CalculationOwnerDataKey" data-statistics-runtime="@StatisticsRuntimeDataKey" data-character-statistics="@CharacterStatisticsDataKey" data-statistics-scope="@StatisticsScopeDataKey" data-recommendation-mode="@RecommendationModeDataKey" data-recommendation-inputs="@RecommendationInputsDataKey" data-risk-model="@RiskModelDataKey" data-calculation-boundary="@CalculationBoundaryDataKey" data-result-consumer="@ResultConsumerDataKey">
            <header class="classic-chummer-titlebar" aria-label="Chummer Online window title">
                <div class="classic-chummer-titlebar-title">Chummer Online - @(PrimaryRecentWorkspace?.ShortLabel ?? "Sample Runner") - @ActiveWorkflowStatus</div>
                <div class="classic-window-controls" aria-hidden="true"><span>_</span><span>[]</span><span>X</span></div>
            </header>
            <nav class="classic-chummer-menu" aria-label="Classic Chummer menu">
                <div class="classic-menu-item">
                    <a href="@BuildPreviewHref(command: NewCharacterCommand, useWorkbenchRoute: true)">File</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@BuildPreviewHref(command: NewCharacterCommand, useWorkbenchRoute: true)"
                           role="menuitem"
                           data-browser-shell-command="@NewCharacterCommand"
                           data-chummer-shortcut="Ctrl+N"
                           aria-keyshortcuts="Control+N"
                           @onclick="() => OpenShellCommandFromSurfaceAsync(NewCharacterCommand)"
                           @onclick:preventDefault="true">New runner</a>
                        <a href="@BuildPreviewHref(command: OpenCharacterCommand, useWorkbenchRoute: true)"
                           role="menuitem"
                           data-browser-shell-command="@OpenCharacterCommand"
                           data-chummer-shortcut="Ctrl+O"
                           aria-keyshortcuts="Control+O"
                           @onclick="() => OpenShellCommandFromSurfaceAsync(OpenCharacterCommand)"
                           @onclick:preventDefault="true">Open runner</a>
                        <a href="@SaveAsFlowHref" role="menuitem" aria-current="@(IsSaveWorkflow ? "page" : null)" data-chummer-shortcut="Ctrl+Shift+S" aria-keyshortcuts="Control+Shift+S">Save as</a>
                        <a href="@PrintFlowHref" role="menuitem" aria-current="@(IsPrintWorkflow ? "page" : null)" data-chummer-shortcut="Ctrl+P" aria-keyshortcuts="Control+P">Print</a>
                        <a href="@ExportFlowHref" role="menuitem" aria-current="@(IsExportWorkflow ? "page" : null)" data-chummer-shortcut="Ctrl+E" aria-keyshortcuts="Control+E">Export</a>
                    </div>
                </div>
                <div class="classic-menu-item">
                    <a href="@BuildLabLaneHref">Edit</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@BuildLabLaneHref" role="menuitem" aria-current="@(IsBuildLabWorkflow ? "page" : null)" data-chummer-shortcut="Ctrl+B" aria-keyshortcuts="Control+B">Build Lab</a>
                        <a href="@GearLaneHref" role="menuitem" aria-current="@(IsGearWorkflow ? "page" : null)" data-chummer-shortcut="Ctrl+G" aria-keyshortcuts="Control+G">Gear</a>
                        <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ProfileTabId, useWorkbenchRoute: true)" role="menuitem">Profile</a>
                    </div>
                </div>
                <div class="classic-menu-item">
                    <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ProfileTabId, useWorkbenchRoute: true)">View</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ProfileTabId, useWorkbenchRoute: true)" role="menuitem">Profile</a>
                        <a href="@BuildPreviewHref(SeededWorkspaceId, tab: RulesTabId, useWorkbenchRoute: true)" role="menuitem">Rules</a>
                        <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ContactsTabId, useWorkbenchRoute: true)" role="menuitem">Contacts</a>
                    </div>
                </div>
                <div class="classic-menu-item">
                    <a href="@ChummerOnlineRosterHref">Runner</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@ChummerOnlineRosterHref" role="menuitem" aria-current="@(IsCharacterRosterCommand ? "page" : null)" data-chummer-shortcut="Ctrl+R" aria-keyshortcuts="Control+R">Character Roster</a>
                        <a href="@ContinueRecentHref" role="menuitem">Continue runner</a>
                        <a href="@BuildPreviewHref(command: OpenCharacterCommand, useWorkbenchRoute: true)"
                           role="menuitem"
                           data-browser-shell-command="@OpenCharacterCommand"
                           @onclick="() => OpenShellCommandFromSurfaceAsync(OpenCharacterCommand)"
                           @onclick:preventDefault="true">Import runner XML</a>
                    </div>
                </div>
                <div class="classic-menu-item">
                    <a href="@GlobalSettingsHref">Tools</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@GlobalSettingsHref" role="menuitem" data-chummer-shortcut="Ctrl+," aria-keyshortcuts="Control+,">Options</a>
                        <a href="@StatusHref" role="menuitem">Status</a>
                        <a href="@DownloadsHref" role="menuitem">Desktop installers</a>
                    </div>
                </div>
                <div class="classic-menu-item">
                    <a href="@HelpHref">Help</a>
                    <div class="classic-menu-flyout" role="menu">
                        <a href="@HelpHref" role="menuitem" data-chummer-shortcut="F1" aria-keyshortcuts="F1">Help</a>
                        <a href="@DocsHref" role="menuitem">Docs</a>
                        <a href="@ContactHref" role="menuitem">Support</a>
                    </div>
                </div>
            </nav>

            <nav class="classic-chummer-toolstrip" aria-label="Classic Chummer toolstrip">
                <div class="classic-toolstrip-group" aria-label="File actions">
                    <a class="classic-tool-icon"
                       href="@BuildPreviewHref(command: NewCharacterCommand, useWorkbenchRoute: true)"
                       data-browser-shell-command="@NewCharacterCommand"
                       data-classic-toolstrip-action="new-runner"
                       data-chummer-shortcut="Ctrl+N"
                       aria-keyshortcuts="Control+N"
                       title="New runner"
                       @onclick="() => OpenShellCommandFromSurfaceAsync(NewCharacterCommand)"
                       @onclick:preventDefault="true">N</a>
                    <a class="classic-tool-icon"
                       href="@BuildPreviewHref(command: OpenCharacterCommand, useWorkbenchRoute: true)"
                       data-browser-shell-command="@OpenCharacterCommand"
                       data-classic-toolstrip-action="open-dossier"
                       data-chummer-shortcut="Ctrl+O"
                       aria-keyshortcuts="Control+O"
                       title="Open runner"
                       @onclick="() => OpenShellCommandFromSurfaceAsync(OpenCharacterCommand)"
                       @onclick:preventDefault="true">O</a>
                    <a class="classic-tool-icon" href="@SaveAsFlowHref" data-classic-toolstrip-action="save-dossier" data-chummer-shortcut="Ctrl+S" aria-keyshortcuts="Control+S" title="Save dossier" aria-current="@(IsSaveWorkflow ? "page" : null)">S</a>
                </div>
                <div class="classic-toolstrip-group" aria-label="Output actions">
                    <a class="classic-tool-icon" href="@PrintFlowHref" data-classic-toolstrip-action="print-dossier" data-chummer-shortcut="Ctrl+P" aria-keyshortcuts="Control+P" title="Print" aria-current="@(IsPrintWorkflow ? "page" : null)">P</a>
                    <a class="classic-tool-icon" href="@ExportFlowHref" data-classic-toolstrip-action="export-dossier" data-chummer-shortcut="Ctrl+E" aria-keyshortcuts="Control+E" title="Export" aria-current="@(IsExportWorkflow ? "page" : null)">E</a>
                </div>
                <div class="classic-toolstrip-group" aria-label="Dossier actions">
                    <a class="classic-tool-icon" href="@ChummerOnlineRosterHref" data-classic-toolstrip-action="character-roster" data-chummer-shortcut="Ctrl+R" aria-keyshortcuts="Control+R" title="Character Roster" aria-current="@(IsCharacterRosterCommand ? "page" : null)">R</a>
                    <a class="classic-tool-icon" href="@BuildLabLaneHref" data-classic-toolstrip-action="build-lab" data-chummer-shortcut="Ctrl+B" aria-keyshortcuts="Control+B" title="Build Lab" aria-current="@(IsBuildLabWorkflow ? "page" : null)">B</a>
                    <a class="classic-tool-icon" href="@GearLaneHref" data-classic-toolstrip-action="gear" data-chummer-shortcut="Ctrl+G" aria-keyshortcuts="Control+G" title="Gear" aria-current="@(IsGearWorkflow ? "page" : null)">G</a>
                </div>
            </nav>

            <div class="classic-chummer-workspace">
                <aside class="classic-chummer-roster @(IsCharacterRosterCommand ? "is-roster-command" : string.Empty)" aria-label="Character Roster">
                    <h2>Character Roster</h2>
                    <div class="classic-roster-toolbar" role="toolbar" aria-label="Roster organization tools" data-roster-toolbar="custom-directories">
                        <button type="button" data-roster-command="new-folder" data-roster-shortcut="Ctrl+Shift+N" aria-keyshortcuts="Control+Shift+N" aria-controls="classic-roster-tree">New folder</button>
                        <button type="button" data-roster-command="move-selection" data-roster-shortcut="Ctrl+M" aria-keyshortcuts="Control+M" aria-controls="classic-roster-tree">Move</button>
                        <button type="button" data-roster-command="rename-selection" data-roster-shortcut="F2" aria-keyshortcuts="F2" aria-controls="classic-roster-tree">Rename</button>
                        <button type="button" data-roster-command="show-inbox" data-roster-shortcut="Ctrl+I" aria-keyshortcuts="Control+I" aria-controls="classic-roster-tree">Inbox</button>
                    </div>
                    <p id="classic-roster-hint" class="classic-roster-hint">Drag runners or folders to organize this roster.</p>
                    <ul id="classic-roster-tree" class="classic-roster-tree" role="tree" aria-label="Custom character roster tree" aria-describedby="classic-roster-hint" data-roster-tree="custom-directories" data-roster-selected-node="@SelectedRosterNodeDataKey" data-roster-schema-version="1" data-roster-storage-scope="workspace" data-roster-persistence-key="chummer-online-roster-tree" data-roster-reorder-mode="nested">
                        <li role="treeitem" aria-expanded="true" aria-level="1" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-active-table" data-roster-parent-id="root" data-roster-order="10" data-roster-drop-zone="active-table">
                            Active Table
                            <ul role="group">
                                <li role="treeitem" aria-level="2" data-tree-kind="runner" data-roster-draggable-kind="runner" draggable="true" aria-selected="true" data-roster-node="active-runner" data-roster-node-id="runner-active" data-roster-parent-id="folder-active-table" data-roster-order="10">
                                    <a href="@ContinueRecentHref">@ContinueRecentLabel</a>
                                </li>
                                <li role="treeitem" aria-level="2" data-tree-kind="runner" data-roster-draggable-kind="runner" draggable="true" data-roster-node="sample-runner" data-roster-node-id="runner-sample" data-roster-parent-id="folder-active-table" data-roster-order="20">
                                    <a href="@BuildPreviewHref(SeededWorkspaceId, useWorkbenchRoute: true)">Sample runner</a>
                                </li>
                            </ul>
                        </li>
                        <li role="treeitem" aria-expanded="true" aria-level="1" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-saved-runners" data-roster-parent-id="root" data-roster-order="20" data-roster-drop-zone="saved-runners">
                            Saved Runners
                            <ul role="group">
                                <li role="treeitem" aria-level="2" data-tree-kind="runner" data-roster-draggable-kind="runner" draggable="true" data-roster-node="import-dossier" data-roster-node-id="runner-import-dossier" data-roster-parent-id="folder-saved-runners" data-roster-order="10">
                                    <a href="@BuildPreviewHref(command: OpenCharacterCommand, useWorkbenchRoute: true)"
                                       data-browser-shell-command="@OpenCharacterCommand"
                                       @onclick="() => OpenShellCommandFromSurfaceAsync(OpenCharacterCommand)"
                                       @onclick:preventDefault="true">Import runner XML</a>
                                </li>
                            </ul>
                        </li>
                        <li role="treeitem" aria-expanded="true" aria-level="1" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-inbox" data-roster-parent-id="root" data-roster-order="30" data-roster-drop-zone="inbox">
                            Inbox
                            <ul role="group">
                                <li role="treeitem" aria-level="2" data-tree-kind="runner" data-roster-draggable-kind="runner" draggable="true" data-roster-node="unsorted-local" data-roster-node-id="runner-unsorted-local" data-roster-parent-id="folder-inbox" data-roster-order="10">
                                    <a href="@ChummerOnlineRosterHref">Unsorted local runner</a>
                                </li>
                            </ul>
                        </li>
                        <li role="treeitem" aria-expanded="true" aria-level="1" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-user-directories" data-roster-parent-id="root" data-roster-order="40" data-roster-drop-zone="user-directories">
                            User Directories
                            <ul role="group">
                                <li role="treeitem" aria-expanded="false" aria-level="2" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-street-campaign" data-roster-parent-id="folder-user-directories" data-roster-order="10" data-roster-drop-zone="street-campaign">Street Campaign</li>
                                <li role="treeitem" aria-expanded="false" aria-level="2" data-tree-kind="folder" data-roster-accepts-children="true" data-roster-draggable-kind="folder" draggable="true" data-roster-node-id="folder-missions-backup" data-roster-parent-id="folder-user-directories" data-roster-order="20" data-roster-drop-zone="missions-backup">Missions Backup</li>
                            </ul>
                        </li>
                    </ul>
                </aside>

                <section class="classic-chummer-dossier" aria-label="Active runner workspace">
                    <header>
                        <span>Active runner</span>
                        <strong>@(PrimaryRecentWorkspace?.ShortLabel ?? "Sample Runner")</strong>
                    </header>
                    <nav class="classic-dossier-tabs" aria-label="Runner sections">
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: ProfileTabId, useWorkbenchRoute: true)" aria-current="@(IsProfileWorkflow ? "page" : null)">Profile</a>
                        <a class="classic-dossier-tab" href="@BuildLabLaneHref" aria-current="@(IsBuildLabWorkflow ? "page" : null)">Build</a>
                        <a class="classic-dossier-tab" href="@GearLaneHref" aria-current="@(IsGearWorkflow ? "page" : null)">Gear</a>
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: CombatTabId, useWorkbenchRoute: true)" aria-current="@(IsCombatWorkflow ? "page" : null)">Combat</a>
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: MagicTabId, useWorkbenchRoute: true)" aria-current="@(IsMagicWorkflow ? "page" : null)">Magic</a>
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: MatrixTabId, useWorkbenchRoute: true)" aria-current="@(IsMatrixWorkflow ? "page" : null)">Matrix</a>
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: ContactsTabId, useWorkbenchRoute: true)" aria-current="@(IsContactsWorkflow ? "page" : null)">Contacts</a>
                        <a class="classic-dossier-tab" href="@BuildPreviewHref(SeededWorkspaceId, tab: CareerTabId, useWorkbenchRoute: true)" aria-current="@(IsCareerWorkflow ? "page" : null)">Career</a>
                    </nav>
                    <div class="classic-chummer-dossier-body">
                        <nav class="classic-dossier-section-list" aria-label="Classic runner section list">
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ProfileTabId, useWorkbenchRoute: true)" aria-current="@(IsProfileWorkflow ? "page" : null)">Common</a>
                            <a href="@BuildLabLaneHref" aria-current="@(IsBuildLabWorkflow ? "page" : null)">Build</a>
                            <a href="@GearLaneHref" aria-current="@(IsGearWorkflow ? "page" : null)">Gear</a>
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: CombatTabId, useWorkbenchRoute: true)" aria-current="@(IsCombatWorkflow ? "page" : null)">Combat</a>
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: MagicTabId, useWorkbenchRoute: true)" aria-current="@(IsMagicWorkflow ? "page" : null)">Magic</a>
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: MatrixTabId, useWorkbenchRoute: true)" aria-current="@(IsMatrixWorkflow ? "page" : null)">Matrix</a>
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: ContactsTabId, useWorkbenchRoute: true)" aria-current="@(IsContactsWorkflow ? "page" : null)">Contacts</a>
                            <a href="@BuildPreviewHref(SeededWorkspaceId, tab: CareerTabId, useWorkbenchRoute: true)" aria-current="@(IsCareerWorkflow ? "page" : null)">Career</a>
                        </nav>
                        <div class="classic-dossier-grid">
                            <section class="classic-dossier-group" aria-label="Runner identity">
                                <h3>Runner Identity</h3>
                                <dl>
                                    <div><dt>Name</dt><dd>@(PrimaryRecentWorkspace?.ShortLabel ?? "Sample Runner")</dd></div>
                                    <div><dt>Alias</dt><dd>Street Samurai</dd></div>
                                    <div><dt>Ruleset</dt><dd>SR5</dd></div>
                                    <div><dt>Status</dt><dd>Unsaved local runner</dd></div>
                                </dl>
                            </section>

                            <section class="classic-dossier-group" aria-label="Core attributes">
                                <h3>Core Attributes</h3>
                                <dl>
                                    <div><dt>BOD</dt><dd>4</dd></div>
                                    <div><dt>AGI</dt><dd>6</dd></div>
                                    <div><dt>REA</dt><dd>5</dd></div>
                                    <div><dt>STR</dt><dd>3</dd></div>
                                    <div><dt>CHA</dt><dd>2</dd></div>
                                    <div><dt>INT</dt><dd>4</dd></div>
                                    <div><dt>LOG</dt><dd>3</dd></div>
                                    <div><dt>WIL</dt><dd>4</dd></div>
                                </dl>
                            </section>

                            <section class="classic-dossier-group classic-dossier-group--wide" aria-label="Runner lists">
                                <h3>Build Lists</h3>
                                <div class="classic-dossier-lists">
                                    <ul>
                                        <li>Qualities</li>
                                        <li>Positive: Mentor Spirit</li>
                                        <li>Negative: SINner</li>
                                    </ul>
                                    <ul>
                                        <li>Gear</li>
                                        <li>Ares Predator V</li>
                                        <li>Armor Jacket</li>
                                    </ul>
                                    <ul>
                                        <li>Contacts</li>
                                        <li>Fixer · Loyalty 3</li>
                                        <li>Street Doc · Connection 2</li>
                                    </ul>
                                </div>
                            </section>

                            <section class="classic-dossier-group classic-dossier-group--wide" aria-label="Readiness">
                                <h3>Readiness</h3>
                                <div class="classic-dossier-readiness">
                                    <span>Build checks: review required</span>
                                    <span>Save state: local changes</span>
                                    <span>Output: print/export ready</span>
                                </div>
                            </section>
                        </div>
                        <div class="classic-chummer-dossier-actions">
                            <a href="@BuildLabLaneHref">Continue Build Lab</a>
                            <a href="@GearLaneHref">Open Gear</a>
                            <a href="@SaveAsFlowHref">Save/download</a>
                        </div>
                    </div>
                </section>

                <aside class="classic-chummer-inspector" aria-label="Runner inspector">
                    <h2>Inspector</h2>
                    <dl>
                        <div><dt>Karma</dt><dd>12</dd></div>
                        <div><dt>Nuyen</dt><dd>8,450 nuyen</dd></div>
                        <div><dt>Essence</dt><dd>5.4</dd></div>
                        <div><dt>Limits</dt><dd>Physical 7</dd></div>
                    </dl>
                    <h3>Build Checks</h3>
                    <ul>
                        <li>Review availability before export.</li>
                        <li>Confirm lifestyle and licenses.</li>
                        <li>Output profile ready.</li>
                    </ul>
                </aside>
            </div>

            <footer class="classic-chummer-status" aria-label="Classic Chummer status">
                    <span><strong>Ready</strong><em>Local</em></span>
                    <span><strong>Dirty</strong><em>Unsaved runner</em></span>
                    <span><strong>Rules</strong><em>SR5</em></span>
                    <span><strong>Checks</strong><em>Review required</em></span>
                    <span><strong>Privacy</strong><em>Local-first</em></span>
                    <span><strong>Workflow</strong><em>@ActiveWorkflowStatus</em></span>
                </footer>
        </section>
    }

