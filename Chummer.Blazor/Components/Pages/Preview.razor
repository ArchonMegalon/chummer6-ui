    private static string NormalizeShellDataToken(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "none";
        }

        string normalized = new(
            value.Trim()
                .ToLowerInvariant()
                .Select(character => char.IsLetterOrDigit(character) ? character : '-')
                .ToArray());

        while (normalized.Contains("--", StringComparison.Ordinal))
        {
            normalized = normalized.Replace("--", "-", StringComparison.Ordinal);
        }

        normalized = normalized.Trim('-');
        if (normalized.Length > ShellDataTokenMaxLength)
        {
            normalized = normalized[..ShellDataTokenMaxLength].Trim('-');
        }

        return string.IsNullOrWhiteSpace(normalized) ? "none" : normalized;
    }

    private const int ShellDataTokenMaxLength = 80;
    private bool IsRouteSegment(string routeSegment)
    {
        string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        return path.EndsWith($"/{routeSegment}", StringComparison.OrdinalIgnoreCase);
