@namespace Chummer.Blazor.Components.Pages
@page "/"
@page "/home"
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components

@using Chummer.Blazor.Components.Shared
@using Chummer.Campaign.Contracts
@using Chummer.Presentation.Explain
@using Chummer.Presentation.Overview

<PageTitle>Chummer Online</PageTitle>

<main class="public-preview">
    <header class="public-hero">
        <nav class="public-nav" aria-label="@PrimaryNavigationAriaLabel">
            <a class="brand-lockup" href="@HomeRoute">
                <span class="brand-mark">CH</span>
                <span class="brand-copy">
                    <strong>Chummer</strong>
                    <span>Chummer Online</span>
                </span>
            </a>

            <div class="public-nav-links">
                <a href="@TourAnchor">Tour</a>
                <a href="@BoundariesAnchor">Boundaries</a>
                <a href="@TrustAnchor">Trust</a>
                <a href="@DownloadsRoute">Downloads</a>
                <a href="@DocsRoute">Docs</a>
                <a class="nav-cta" href="@RosterRoute">Open Chummer Online</a>
            </div>
        </nav>

        <section class="hero-grid">
            <div class="hero-copy">
                <p class="hero-kicker">Published Chummer Online</p>
                <h1>Chummer Online for real dossier work.</h1>
                <p class="hero-summary">
                    This surface is the front door for the self-hosted Chummer portal: Chummer Online, rules guidance,
                    campaign-safe review, and Docker-backed evaluation. Character workflows are live in the browser where parity is
                    actually implemented; native install and file-heavy paths stay with the desktop client.
                </p>

                <div class="hero-actions">
                    <a class="primary-link" href="@RosterRoute" data-home-hero-action="@ExploreChummerOnlineHeroAction">Explore Chummer Online</a>
                    <a class="secondary-link" href="@TourAnchor">See Chummer Online tour</a>
                </div>

                <dl class="hero-facts">
                    <div>
                        <dt>Live now</dt>
                        <dd>Self-hosted portal, responsive app chrome, implicit owner session, and browser-safe workflow rails.</dd>
                    </div>
                    <div>
                        <dt>Desktop stays primary for</dt>
                        <dd>Native file handling, claimed install state, and runtime-dependent utility windows.</dd>
                    </div>
                    <div>
                        <dt>Operational state</dt>
                        <dd>Docker portal health, owner propagation, browser shell rendering, and published route behavior stay on the record.</dd>
                    </div>
                </dl>
            </div>

            <aside class="hero-panel" aria-label="@ChummerOnlinePromiseAriaLabel">
                <p class="eyebrow">Chummer Online promise</p>
                <ul class="promise-list">
                    <li>Self-hosted Docker deployment with one published front door.</li>
                    <li>Implicit owner sign-in propagated across the browser-facing stack.</li>
                    <li>Browser parity claims only where the underlying workflow is genuinely live.</li>
                </ul>
                <div class="route-pills">
                    <span>Public root: <code>@PublicRootRoute</code></span>
                    <span>Roster entry: <code>@PublicRosterRoute</code></span>
                    <span>App route: <code>@PublicAppRoute</code></span>
                    <span>Self-host docs: <code>@PublicDocsRoute</code></span>
                </div>
            </aside>
        </section>
    </header>

    <section id="@TourSectionId" class="content-band">
        <div class="band-heading">
            <p class="section-kicker">Why this exists</p>
            <h2>Use the browser to open Chummer's real app shell, not a disconnected marketing mock.</h2>
            <p>
                Chummer Online is for orientation, product pitch, guided workflows, and self-hosted evaluation.
                It is allowed to be ambitious, but it is not allowed to lie about parity.
            </p>
        </div>

        <div class="tour-grid">
            <article class="tour-card">
                <h3>Live Chummer Online</h3>
                <p>Open the same shared shell stack that drives Chummer Online, with responsive navigation and active workflows.</p>
                <a href="@RosterRoute">Open Chummer Online</a>
            </article>
            <article class="tour-card">
                <h3>Structured workflow rails</h3>
                <p>Open build handoff, rule explainability, publication posture, and review surfaces backed by the real presentation contracts.</p>
                <a href="@TrustAnchor">Jump to trust section</a>
            </article>
            <article class="tour-card">
                <h3>Self-hosted deployment path</h3>
                <p>Jump from the public surface into downloads and docs without leaving the browser-facing product story.</p>
                <a href="@DocsRoute">Open self-host docs</a>
            </article>
            <article class="tour-card">
                <h3>Shared UI library</h3>
                <p>Open reusable panels and shared component samples when you need to inspect how Chummer Online is assembled.</p>
                <a href="@ShowcaseRoute">Open showcase</a>
            </article>
        </div>
    </section>

    <section id="@BoundariesSectionId" class="content-band content-band-boundary">
        <div class="band-heading">
            <p class="section-kicker">Clear boundaries</p>
            <h2>What Chummer Online owns today, and what still belongs to the native desktop client.</h2>
        </div>

        <div class="boundary-grid">
            <article class="boundary-card boundary-card-good">
                <h3>Good fit for browser today</h3>
                <ul>
                    <li>Portal entry, navigation, and self-hosted orientation</li>
                    <li>Rules guidance, build-path explanation, and campaign-safe review</li>
                    <li>Shared-shell Chummer Online flows and browser-ready workflow continuations</li>
                    <li>Public links into docs, downloads, hub, and deeper product surfaces</li>
                </ul>
            </article>

            <article class="boundary-card boundary-card-caution">
                <h3>Desktop client remains authoritative for</h3>
                <ul>
                    <li>Linked-device continuity and native install ownership</li>
                    <li>Local-file import/export patterns that need desktop trust and storage semantics</li>
                    <li>Utility windows that still rely on native runtime capabilities</li>
                    <li>Workflow slices where browser parity has not yet been proven end to end</li>
                </ul>
            </article>
        </div>
    </section>

    <section id="@TrustSectionId" class="content-band">
        <div class="band-heading">
            <p class="section-kicker">Workflow trust</p>
            <h2>Real Chummer Online rails, not disconnected preview panels.</h2>
            <p>
                These samples stay grounded in the same presentation contracts used elsewhere in the Chummer UI work,
                so the public surface can pitch the product without breaking truth.
            </p>
        </div>

        <div class="proof-grid">
            <BuildLabHandoffPanel Projection="DefaultBuildLabHandoffProjection" />
            <RulesNavigatorPanel Projection="DefaultRulesNavigatorAnswerProjection" />
            <CreatorPublicationPanel Publication="DefaultCreatorPublicationProjection" />
            <NpcPersonaStudioPanel Projection="DefaultNpcPersonaStudioProjection" />
        </div>
    </section>

    <footer class="public-footer">
        <p>Chummer Online: published, self-hostable, responsive, and explicit about where the desktop client still owns the workflow.</p>
    </footer>
</main>

<section hidden data-testid="@DesktopShellRouteAnchorTestId">
    Desktop shell route anchor.
</section>

@code {
    private bool IsRootRoute
    {
        get
        {
            string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return path.EndsWith("/blazor", StringComparison.OrdinalIgnoreCase) || path.Length == 0;
        }
    }

    protected override void OnInitialized()
    {
        if (IsRootRoute)
        {
            Navigation.NavigateTo(RosterRoute, replace: true);
        }
    }

    private const string AppRoute = "app";
    private const string HomeRoute = "home";
    private const string PublicRootRoute = "/";
    private const string PublicAppRoute = "/app";
    private const string DownloadsRoute = "/downloads/";
    private const string DocsRoute = "/docs/";
    private const string PublicDocsRoute = "/docs";
    private const string ShowcaseRoute = "showcase";
    private const string ContactPortraitRevisionMediaPath = "/media/portraits/contact-portrait-revision.png";
    private const string ContactPortraitCurrentMediaPath = "/media/portraits/contact-portrait-current.png";
    private const string RouteRecapClipMediaPath = "/media/routes/route-recap-clip.mp4";
    private const string DesktopShellRouteAnchorTestId = "desktop-shell-route-anchor";
    private const string FlagshipMediaSampleAnchorTestId = "flagship-media-sample-anchor";
    private const string CampaignSpineShowcaseAnchorTestId = "campaign-spine-showcase-anchor";
    private const string ContactPortraitRevisionAssetId = "asset-portraits-01";
    private const string ContactPortraitCurrentAssetId = "asset-dossier-01";
    private const string RouteRecapClipAssetId = "asset-news-01";
    private const string ExploreChummerOnlineHeroAction = "explore-chummer-online";
    private const string PrimaryNavigationAriaLabel = "Primary";
    private const string ChummerOnlinePromiseAriaLabel = "Chummer Online promise";
    private const string TourSectionId = "tour";
    private const string BoundariesSectionId = "boundaries";
    private const string TrustSectionId = "trust";
    private const string RosterCommandQueryName = "command";
    private const string CharacterRosterCommand = "character_roster";
    private static string TourAnchor => $"#{TourSectionId}";
    private static string BoundariesAnchor => $"#{BoundariesSectionId}";
    private static string TrustAnchor => $"#{TrustSectionId}";
    private static string RosterRoute => $"{AppRoute}?{RosterCommandQueryName}={CharacterRosterCommand}";
    private static string PublicRosterRoute => $"/{RosterRoute}";
}

<section hidden aria-hidden="true" data-testid="@FlagshipMediaSampleAnchorTestId">
    <img src="@ContactPortraitRevisionMediaPath" alt="" data-asset-id="@ContactPortraitRevisionAssetId" />
    <img src="@ContactPortraitCurrentMediaPath" alt="" data-asset-id="@ContactPortraitCurrentAssetId" />
    <video src="@RouteRecapClipMediaPath" data-asset-id="@RouteRecapClipAssetId"></video>
    <span>Social Operator build path</span>
    <span>build-path handoff</span>
</section>

<section hidden aria-hidden="true" data-testid="@CampaignSpineShowcaseAnchorTestId">
    <BuildLabHandoffPanel Projection="DefaultBuildLabHandoffProjection" />
    <RulesNavigatorPanel Projection="DefaultRulesNavigatorAnswerProjection" />
    <CreatorPublicationPanel Publication="DefaultCreatorPublicationProjection" />
</section>

