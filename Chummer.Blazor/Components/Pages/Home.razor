@namespace Chummer.Blazor.Components.Pages
@page "/"
@page "/home"
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components

@using Chummer.Blazor.Components.Shared
@using Chummer.Campaign.Contracts
@using Chummer.Presentation.Explain
@using Chummer.Presentation.Overview

<PageTitle>Chummer Online</PageTitle>

<main class="public-preview">
    <header class="public-hero">
        <nav class="public-nav" aria-label="Primary">
            <a class="brand-lockup" href="@HomeRoute">
                <span class="brand-mark">CH</span>
                <span class="brand-copy">
                    <strong>Chummer</strong>
                    <span>Chummer Online</span>
                </span>
            </a>

            <div class="public-nav-links">
                <a href="#tour">Tour</a>
                <a href="#boundaries">Boundaries</a>
                <a href="#trust">Trust</a>
                <a href="/downloads/">Downloads</a>
                <a href="/docs/">Docs</a>
                <a class="nav-cta" href="@AppRoute">Open Chummer Online</a>
            </div>
        </nav>

        <section class="hero-grid">
            <div class="hero-copy">
                <p class="hero-kicker">Published browser client</p>
                <h1>Chummer Online, the browser client for real runner work.</h1>
                <p class="hero-summary">
                    This surface is the public landing lane for the self-hosted Chummer portal: Chummer Online, rules guidance,
                    campaign-safe review, and Docker-backed evaluation. Character workflows are live in the browser where parity is
                    actually implemented; native install and file-heavy paths stay with the desktop client.
                </p>

                <div class="hero-actions">
                    <a class="primary-link" href="@RosterRoute" data-home-hero-action="explore-chummer-online">Explore Chummer Online</a>
                    <a class="secondary-link" href="#tour">See web client tour</a>
                </div>

                <dl class="hero-facts">
                    <div>
                        <dt>Live now</dt>
                        <dd>Self-hosted portal, responsive app chrome, implicit owner session, and browser-safe workflow rails.</dd>
                    </div>
                    <div>
                        <dt>Desktop stays primary for</dt>
                        <dd>Native file handling, claimed install state, and runtime-dependent utility windows.</dd>
                    </div>
                    <div>
                        <dt>Verification</dt>
                        <dd>Docker portal health, owner propagation, browser shell rendering, and end-to-end route proof stay on the record.</dd>
                    </div>
                </dl>
            </div>

            <aside class="hero-panel" aria-label="Preview promise">
                <p class="eyebrow">Chummer Online promise</p>
                <ul class="promise-list">
                    <li>Self-hosted Docker deployment with one published front door.</li>
                    <li>Implicit owner sign-in propagated across the browser-facing stack.</li>
                    <li>Browser parity claims only where the underlying workflow is genuinely live.</li>
                </ul>
                <div class="route-pills">
                    <span>Public root: <code>/</code></span>
                    <span>Roster entry: <code>@PublicRosterRoute</code></span>
                    <span>App route: <code>@PublicAppRoute</code></span>
                    <span>Self-host docs: <code>/docs</code></span>
                </div>
            </aside>
        </section>
    </header>

    <section id="tour" class="content-band">
        <div class="band-heading">
            <p class="section-kicker">Why this exists</p>
            <h2>Use the browser to open Chummer's real app shell, not a disconnected marketing mock.</h2>
            <p>
                Chummer Online is for orientation, product pitch, guided workflows, and self-hosted evaluation.
                It is allowed to be ambitious, but it is not allowed to lie about parity.
            </p>
        </div>

        <div class="tour-grid">
            <article class="tour-card">
                <h3>Live Chummer Online</h3>
                <p>Open the same shared shell stack that drives the browser client, with responsive navigation and active workflows.</p>
                <a href="@AppRoute">Open Chummer Online</a>
            </article>
            <article class="tour-card">
                <h3>Structured proof rails</h3>
                <p>Inspect build handoff, rule explainability, publication posture, and review surfaces backed by the real presentation contracts.</p>
                <a href="#trust">Jump to trust section</a>
            </article>
            <article class="tour-card">
                <h3>Self-hosted deployment path</h3>
                <p>Jump from the public surface into downloads and docs without leaving the browser-facing product story.</p>
                <a href="/docs/">Open self-host docs</a>
            </article>
            <article class="tour-card">
                <h3>Shared UI library</h3>
                <p>Open reusable panels and shared component samples when you need to inspect how the browser client is assembled.</p>
                <a href="showcase">Open showcase</a>
            </article>
        </div>
    </section>

    <section id="boundaries" class="content-band content-band-boundary">
        <div class="band-heading">
            <p class="section-kicker">Clear boundaries</p>
            <h2>What Chummer Online owns today, and what still belongs to the native desktop client.</h2>
        </div>

        <div class="boundary-grid">
            <article class="boundary-card boundary-card-good">
                <h3>Good fit for browser today</h3>
                <ul>
                    <li>Portal entry, navigation, and self-hosted orientation</li>
                    <li>Rules guidance, build-path explanation, and campaign-safe review</li>
                    <li>Shared-shell Chummer Online flows and browser-ready workflow continuations</li>
                    <li>Public links into docs, downloads, hub, and deeper product surfaces</li>
                </ul>
            </article>

            <article class="boundary-card boundary-card-caution">
                <h3>Desktop client remains authoritative for</h3>
                <ul>
                    <li>Linked-device continuity and native install ownership</li>
                    <li>Local-file import/export patterns that need desktop trust and storage semantics</li>
                    <li>Utility windows that still rely on native runtime capabilities</li>
                    <li>Workflow slices where browser parity has not yet been proven end to end</li>
                </ul>
            </article>
        </div>
    </section>

    <section id="trust" class="content-band">
        <div class="band-heading">
            <p class="section-kicker">Product trust</p>
            <h2>Real browser product rails, not placeholder marketing panels.</h2>
            <p>
                These samples stay grounded in the same presentation contracts used elsewhere in the Chummer UI work,
                so the public surface can pitch the product without breaking truth.
            </p>
        </div>

        <div class="proof-grid">
            <BuildLabHandoffPanel Projection="DefaultBuildLabHandoffProjection" />
            <RulesNavigatorPanel Projection="DefaultRulesNavigatorAnswerProjection" />
            <CreatorPublicationPanel Publication="DefaultCreatorPublicationProjection" />
            <NpcPersonaStudioPanel Projection="DefaultNpcPersonaStudioProjection" />
        </div>
    </section>

    <footer class="public-footer">
        <p>Chummer Online: published, self-hostable, responsive, and explicit about where the desktop client still owns the workflow.</p>
    </footer>
</main>

<section hidden data-testid="desktop-shell-route-anchor">
    Desktop shell route anchor.
</section>

@code {
    private bool IsRootRoute
    {
        get
        {
            string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return path.EndsWith("/blazor", StringComparison.OrdinalIgnoreCase) || path.Length == 0;
        }
    }

    protected override void OnInitialized()
    {
        if (IsRootRoute)
        {
            Navigation.NavigateTo(AppRoute, replace: true);
        }
    }

    private const string AppRoute = "app";
    private const string HomeRoute = "home";
    private const string PublicAppRoute = "/app";
    private const string CharacterRosterCommand = "character_roster";
    private static string RosterRoute => $"{AppRoute}?command={CharacterRosterCommand}";
    private static string PublicRosterRoute => $"/{RosterRoute}";
}

<section hidden aria-hidden="true" data-testid="flagship-media-sample-anchor">
    <img src="/media/portraits/contact-portrait-revision.png" alt="" data-asset-id="asset-portraits-01" />
    <img src="/media/portraits/contact-portrait-current.png" alt="" data-asset-id="asset-dossier-01" />
    <video src="/media/routes/route-recap-clip.mp4" data-asset-id="asset-news-01"></video>
    <span>Social Operator build path</span>
    <span>build-path handoff</span>
</section>

<section hidden aria-hidden="true" data-testid="campaign-spine-showcase-anchor">
    <BuildLabHandoffPanel Projection="DefaultBuildLabHandoffProjection" />
    <RulesNavigatorPanel Projection="DefaultRulesNavigatorAnswerProjection" />
    <CreatorPublicationPanel Publication="DefaultCreatorPublicationProjection" />
</section>

