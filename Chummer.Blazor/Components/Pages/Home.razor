<!-- Desktop shell route anchor: the main workbench stays off the root route. -->
<section hidden data-testid="desktop-shell-route-anchor">
    Desktop shell route anchor.
</section>

<section hidden aria-hidden="true" data-testid="npc-persona-studio-route-anchor">
