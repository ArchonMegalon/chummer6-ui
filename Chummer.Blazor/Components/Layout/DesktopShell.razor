

@namespace Chummer.Blazor.Components.Layout

@if (ShowInstallClaimGate)
{
    <div class="desktop-shell classic-desktop-shell"
         @ref="_shellRoot"
         tabindex="-1"
         @onkeydown="OnShellKeyDown">
        <a class="skip-link" href="#chummer-workspace-main">Skip to dossier</a>
        <header class="desktop-shell-topline desktop-shell-topline--gate" aria-label="Chummer install claim state">
            <div class="desktop-shell-title">
                <p>Chummer Online</p>
                <h1>Claim this installation</h1>
            </div>
            <dl class="desktop-shell-readiness">
                <div><dt>Install</dt><dd>Unclaimed</dd></div>
                <div><dt>Runtime</dt><dd>@InstallLinkingState.ChannelId @InstallLinkingState.ApplicationVersion</dd></div>
                <div><dt>Platform</dt><dd>@InstallLinkingState.Platform / @InstallLinkingState.Arch</dd></div>
            </dl>
        </header>
        <main id="chummer-workspace-main" class="center-pane" tabindex="-1">
            <section class="panel coach-panel" data-testid="desktop-install-claim-gate">
                <div class="coach-header">
                    <div>
                        <h2>Please claim your app</h2>
                        <p class="hint">This desktop stays locked until the signed-in install callback links this copy.</p>
                    </div>
                </div>

                <dl class="coach-facts">
                    <div><dt>Installation</dt><dd class="mono">@InstallLinkingState.InstallationId</dd></div>
                    <div><dt>Head</dt><dd class="mono">@InstallLinkingState.HeadId</dd></div>
                    <div><dt>Release</dt><dd>@InstallLinkingState.ChannelId @InstallLinkingState.ApplicationVersion</dd></div>
                    <div><dt>Platform</dt><dd>@InstallLinkingState.Platform / @InstallLinkingState.Arch</dd></div>
                </dl>

                <div class="mini-grid">
                    <a class="mini-btn"
                       data-testid="desktop-install-claim-start"
                       href="@BuildInstallClaimHref()">
                        Claim this app on chummer.run
                    </a>
                    <a class="mini-btn"
                       data-testid="desktop-install-claim-support"
                       href="@BuildInstallSupportHref()">
                        Open support
                    </a>
                    <a class="mini-btn"
                       data-testid="desktop-install-claim-downloads"
                       href="@BuildInstallDownloadsHref()">
                        Open downloads
                    </a>
                    <a class="mini-btn"
                       data-testid="desktop-install-origin-dossier"
                       href="@BuildInstallOriginDossierHref()">
                        Open clean Origin Dossier route
                    </a>
                </div>
            </section>
        </main>
    </div>
}
else
{
<section class="desktop-shell classic-desktop-shell @(State.ActiveDialog is not null ? "desktop-shell--dialog-open" : string.Empty) @(UseResponsiveBuildWorkspace ? "desktop-shell--responsive-build" : string.Empty)"
         @ref="_shellRoot"
         tabindex="-1"
         inert="@(State.ActiveDialog is not null)"
         aria-hidden="@(State.ActiveDialog is not null ? "true" : null)"
         aria-busy="@State.IsBusy"
         data-tab="@ClassicShellActiveTabId"
         data-ruleset="@ClassicShellRulesetId"
         data-active-workflow="@ClassicShellActiveWorkflowId"
         data-route-segment="@ClassicShellRouteSegment"
         data-active-runner="@ClassicShellActiveRunner"
         data-legacy-runner="@ClassicShellActiveRunner"
         @onkeydown="OnShellKeyDown">
    <a class="skip-link" href="#chummer-workspace-main">Skip to dossier</a>
    <MenuBar MenuRoots="@MenuRoots.ToArray()"
             CurrentLanguage="@CurrentLanguage"
             OpenMenuId="@_shellSurfaceState.OpenMenuId"
             IsBusy="@State.IsBusy"
             MenuCommands="@MenuCommands"
             IsCommandEnabled="@IsCommandEnabled"
             ToggleMenuRequested="@ToggleMenu"
             ExecuteCommandRequested="@ExecuteCommandAsync" />

    <ToolStrip Commands="@ToolStripCommands.ToArray()"
               CurrentLanguage="@CurrentLanguage"
               LastCommandId="@(_shellSurfaceState.LastCommandId ?? State.LastCommandId)"
               IsBusy="@State.IsBusy"
               IsCommandEnabled="@IsCommandEnabled"
               ExecuteCommandRequested="@ExecuteCommandAsync" />

    <header class="desktop-shell-topline" aria-label="Chummer Online session state">
        <div class="desktop-shell-title">
            <p>Chummer Online</p>
            <h1>@(State.Profile?.Alias ?? State.Profile?.Name ?? "Dossier")</h1>
        </div>
        <dl class="desktop-shell-readiness">
            <div><dt>Route</dt><dd>Browser app</dd></div>
            <div><dt>Dossiers</dt><dd>@_shellSurfaceState.OpenWorkspaces.Count open</dd></div>
            <div><dt>Ruleset</dt><dd>@(_shellSurfaceState.ActiveRulesetId ?? State.Rules?.GameEdition ?? "not set")</dd></div>
            <div><dt>State</dt><dd>@(State.IsBusy ? "Working" : string.IsNullOrWhiteSpace(_shellSurfaceState.Error) ? "Ready" : "Needs attention")</dd></div>
        </dl>
    </header>

    @if (_shellSurfaceState.OpenWorkspaces.Count > 1)
    {
        <MdiStrip OpenWorkspaces="@_shellSurfaceState.OpenWorkspaces"
                  ActiveWorkspaceId="@_shellSurfaceState.ActiveWorkspaceId"
                  RulesetId="@_shellSurfaceState.ActiveRulesetId"
                  IsBusy="@State.IsBusy"
                  OpenWorkspaceRequested="@OpenWorkspaceAsync"
                  CloseWorkspaceRequested="@CloseWorkspaceAsync" />
    }

    @if (!UseResponsiveBuildWorkspace)
    {
        <SummaryHeader State="@State"
                       ShellSurface="@_shellSurfaceState"
                       NavigationTabs="@NavigationTabs"
                       ActiveTabId="@_shellSurfaceState.ActiveTabId"
                       IsNavigationTabEnabled="@IsNavigationTabEnabled"
                       SelectTabRequested="@SelectTabAsync"
                       InspectRuntimeRequested="@OpenRuntimeInspectorAsync" />
    }

    @if (!string.IsNullOrWhiteSpace(State.Notice))
    {
        @if (OriginDossierNoticeHref is { } originDossierNoticeHref)
        {
            <div class="shell-notice" role="status" data-shell-notice data-shell-notice-kind="origin-dossier-link">
                <p>@State.Notice</p>
                <div class="shell-notice-actions">
                    <a href="@originDossierNoticeHref"
                       data-shell-notice-link="origin-dossier">
                        Open clean Origin Dossier route
                    </a>
                </div>
                <code class="shell-notice-code" data-shell-notice-route="origin-dossier">@originDossierNoticeHref</code>
            </div>
        }
        else if (DownloadNoticeReceipt is { } downloadNoticeReceipt)
        {
            <div class="shell-notice" role="status" data-shell-notice data-shell-notice-kind="download">
                <p>@State.Notice</p>
                <div class="shell-notice-actions">
                    <button type="button"
                            data-shell-notice-action="download"
                            @onclick="RetryPendingDownloadAsync">
                        Download again
                    </button>
                </div>
                <code class="shell-notice-code" data-shell-notice-file="download">@downloadNoticeReceipt.FileName</code>
            </div>
        }
        else if (ExportNoticeReceipt is { } exportNoticeReceipt)
        {
            <div class="shell-notice" role="status" data-shell-notice data-shell-notice-kind="export">
                <p>@State.Notice</p>
                <div class="shell-notice-actions">
                    <button type="button"
                            data-shell-notice-action="export"
                            @onclick="RetryPendingExportAsync">
                        Export again
                    </button>
                </div>
                <code class="shell-notice-code" data-shell-notice-file="export">@exportNoticeReceipt.FileName</code>
            </div>
        }
        else if (PrintNoticeReceipt is { } printNoticeReceipt)
        {
            <div class="shell-notice" role="status" data-shell-notice data-shell-notice-kind="print">
                <p>@State.Notice</p>
                <div class="shell-notice-actions">
                    <button type="button"
                            data-shell-notice-action="print"
                            @onclick="RetryPendingPrintAsync">
                        Open preview again
                    </button>
                </div>
                <code class="shell-notice-code" data-shell-notice-file="print">@printNoticeReceipt.FileName</code>
            </div>
        }
        else
        {
            <p class="shell-notice" role="status" data-shell-notice>@State.Notice</p>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_demoWorkspaceRouteWarning))
    {
        <div class="shell-notice shell-notice--warning" role="alert" data-demo-workspace-route-warning>
            <p>@_demoWorkspaceRouteWarning</p>
            <div class="shell-notice-actions">
                <a href="@DemoWorkspaceRecoveryAppHref"
                   data-demo-workspace-route-recovery="app">
                    Open seeded Build Lab on Chummer Online
                </a>
                <a href="@DemoWorkspaceRecoveryWorkbenchHref"
                   data-demo-workspace-route-recovery="workbench">
                    Open seeded compatibility shell
                </a>
            </div>
        </div>
    }

    @if (UseResponsiveBuildWorkspace)
    {
        <BuildPwaWorkspace State="@State"
                           ShellSurface="@_shellSurfaceState"
                           OpenWorkspaces="@_shellSurfaceState.OpenWorkspaces"
                           ActiveWorkspaceId="@_shellSurfaceState.ActiveWorkspaceId"
                           ActiveTabId="@_shellSurfaceState.ActiveTabId"
                           NavigationTabs="@NavigationTabs"
                           ActiveWorkspaceActions="@ActiveWorkspaceActions"
                           ActiveWorkflowSurfaceActions="@ActiveWorkflowSurfaceActions"
                           MobileCommands="@HeadCommands.ToArray()"
                           IsNavigationTabEnabled="@IsNavigationTabEnabled"
                           IsCommandEnabled="@IsCommandEnabled"
                           OpenWorkspaceRequested="@OpenWorkspaceAsync"
                           CloseWorkspaceRequested="@CloseWorkspaceAsync"
                           SelectTabRequested="@SelectTabAsync"
                           ExecuteWorkspaceActionRequested="@ExecuteWorkspaceActionAsync"
                           ExecuteWorkflowSurfaceRequested="@ExecuteWorkflowSurfaceAsync"
                           ExecuteCommandRequested="@ExecuteCommandAsync"
                           ExecuteUiControlRequested="@HandleUiControlAsync"
                           AttributeEditRequested="@HandleAttributeEditAsync"
                           LoadWorkspaceRequested="@(workspaceId => LoadWorkspaceAsync(workspaceId))"
                           DeletionCommitSource="@(Presenter as IWorkspaceDeletionCommitSource)"
                           RecoveryCopySource="@(Presenter as IWorkspaceRecoveryCopySource)"
                           InspectRuntimeRequested="@OpenRuntimeInspectorAsync" />
    }
    else
    {
        <div class="workspace-layout @(ShowLeftPane ? "workspace-layout--with-left-pane" : "workspace-layout--without-left-pane")">
            @if (ShowLeftPane)
            {
                <WorkspaceLeftPane State="@State"
                                   OpenWorkspaces="@_shellSurfaceState.OpenWorkspaces"
                                   ActiveWorkspaceId="@_shellSurfaceState.ActiveWorkspaceId"
                                   ActiveTabId="@_shellSurfaceState.ActiveTabId"
                                   NavigationTabs="@NavigationTabs"
                                   ActiveWorkspaceActions="@ActiveWorkspaceActions"
                                   ActiveWorkflowSurfaceActions="@ActiveWorkflowSurfaceActions"
                                   IsNavigationTabEnabled="@IsNavigationTabEnabled"
                                   OpenWorkspaceRequested="@OpenWorkspaceAsync"
                                   CloseWorkspaceRequested="@CloseWorkspaceAsync"
                                   SelectTabRequested="@SelectTabAsync"
                                   ExecuteWorkspaceActionRequested="@ExecuteWorkspaceActionAsync"
                                   ExecuteWorkflowSurfaceRequested="@ExecuteWorkflowSurfaceAsync" />
            }

            <main id="chummer-workspace-main" class="center-pane" tabindex="-1">
                <SectionPane State="@State"
                             IsCommandEnabled="@IsCommandEnabled"
                             ExecuteCommandRequested="@ExecuteCommandAsync"
                             ExecuteUiControlRequested="@HandleUiControlAsync"
                             AttributeEditRequested="@HandleAttributeEditAsync"
                             LoadWorkspaceRequested="@(workspaceId => LoadWorkspaceAsync(workspaceId))"
                             RetryPendingDownloadRequested="@RetryPendingDownloadAsync"
                             RetryPendingExportRequested="@RetryPendingExportAsync"
                             RetryPendingPrintRequested="@RetryPendingPrintAsync" />
            </main>
        </div>
    }

    <StatusStrip WorkspaceId="@_shellSurfaceState.ActiveWorkspaceId"
                 Error="@_shellSurfaceState.Error"
                 LastUiUtc="@_lastUiUtc"
                 ComplianceState="@ComplianceState" />
</section>

<DialogHost Dialog="@State.ActiveDialog"
            CloseRequested="@CloseDialogAsync"
            ExecuteDialogActionRequested="@ExecuteDialogActionAsync"
            FieldInputRequested="@OnDialogFieldInputAsync"
            FieldCheckboxRequested="@OnDialogCheckboxChangedAsync"
            RosterDropRequested="@OnDialogRosterDropAsync"
            OriginWizardAdvancedControlsOpen="@_originWizardAdvancedControlsOpen"
            OriginWizardAdvancedControlsOpenChanged="@OnOriginWizardAdvancedControlsOpenChangedAsync" />
}
