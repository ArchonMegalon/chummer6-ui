        {
            return BuildPublicAppHref(
                fixture,
                actionCommand.PreserveWorkspace ? workspace : null,
                null,
                command,
                null);
        }

        if (ResolveDialogFallbackCommand(command) is not null)
            return BuildPublicAppHref(fixture, null, null, command, null);

        if (ResolveDataPackCommand(command) is not null)
            return BuildPublicAppHref(fixture, null, null, command, null);

        return command switch
        {
            "new_character" or "new_character_origin" or "character_roster" or "master_index" or "global_settings" or "character_settings" or "switch_ruleset" or "report_bug" or "about" or OverviewCommandPolicy.RuntimeInspectorCommandId or "auto_alice" or "translator" or "xml_editor" or "hero_lab_importer"
