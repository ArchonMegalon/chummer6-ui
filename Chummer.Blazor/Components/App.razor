    private static string BuildWorkbenchHrefCore(
        string workspace,
        string? fixture,
        string? runner,
        string? tab,
        string? command,
        string? control,
        string? dialogAction)
    {
        var parts = new List<string>
        {
            $"workspace={Uri.EscapeDataString(NormalizeDataToken(workspace, "blue-workspace"))}"
        };

        AddNonDefaultQueryPart(parts, "fixture", fixture, "blue");
        AddNonDefaultQueryPart(parts, "runner", runner, "BLUE");

        AddQueryPart(parts, "tab", tab);
        AddQueryPart(parts, "command", command);
        AddQueryPart(parts, "control", control);
        AddQueryPart(parts, "dialog_action", dialogAction);
        return $"workbench?{string.Join("&", parts)}";
