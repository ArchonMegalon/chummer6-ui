    private string BuildBaseHref()
        => ShouldUseCleanPublicRouteBaseHref() ? "/" : BuildHostedBaseHref();

    private string BuildStaticAssetHref(string assetPath)
    {
        string normalizedAssetPath = NormalizeAssetPath(assetPath);
        string hostedBaseHref = BuildHostedBaseHref();
        string assetHref = hostedBaseHref == "/"
            ? $"/{normalizedAssetPath}"
            : $"{hostedBaseHref}{normalizedAssetPath}";
        return $"{assetHref}?{BuildPwaReleaseContract.QueryKey}={BuildPwaRelease.ContentRevision}";
    }

    private string BuildStaticAssetIntegrity(string assetPath)
    {
        string normalizedAssetPath = NormalizeAssetPath(assetPath);
        if (!BuildPwaRelease.Assets.TryGetValue(normalizedAssetPath, out BuildPwaReleaseAsset? asset))
            throw new InvalidOperationException(
                $"Build PWA direct asset '{normalizedAssetPath}' is outside the sealed release contract.");

        return asset.SubresourceIntegrity;
    }

    private BuildPwaReleaseSnapshot BuildPwaRelease
        => _buildPwaRelease ??= BuildPwaReleaseContract.GetSnapshot(BuildPwaEnvironment);

    private string BuildServiceWorkerScope()
        => BuildHostedBaseHref();

    private string BuildHostedBaseHref()
    {
        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? uri))
            return "/";

        if (string.IsNullOrWhiteSpace(uri.AbsolutePath) || string.Equals(uri.AbsolutePath, "/", StringComparison.Ordinal))
            return "/";

        if (uri.AbsolutePath.EndsWith("/", StringComparison.Ordinal))
            return uri.AbsolutePath;

        return $"{uri.AbsolutePath}/";
    }

    private bool ShouldUseCleanPublicRouteBaseHref()
    {
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out Uri? uri))
            return false;

        return IsCleanPublicRoute(uri.AbsolutePath);
    }

    private static bool IsCleanPublicRoute(string absolutePath)
    {
        if (string.IsNullOrWhiteSpace(absolutePath))
            return false;

        string normalizedPath = absolutePath.TrimEnd('/');
        if (normalizedPath.Length == 0)
            normalizedPath = "/";

        return string.Equals(normalizedPath, "/app", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalizedPath, "/online", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeAssetPath(string assetPath)
        => string.IsNullOrWhiteSpace(assetPath)
            ? string.Empty
            : assetPath.TrimStart('/');

    private RybbitAnalyticsOptions? BuildRybbitAnalyticsOptions()
    {
        if (!string.Equals(Configuration[AnalyticsProviderConfigKey], RybbitAnalyticsProvider, StringComparison.OrdinalIgnoreCase))
            return null;

        string? siteId = NormalizeAnalyticsToken(Configuration[RybbitSiteIdConfigKey]);
        if (siteId is null)
            return null;

        string? endpointUrl = ResolveRybbitTrackEndpointUrl();
        return endpointUrl is null ? null : new RybbitAnalyticsOptions(endpointUrl, siteId);
    }

    private string? ResolveRybbitTrackEndpointUrl()
    {
        string? configuredScriptUrl = NormalizeOptionalValue(Configuration[RybbitScriptUrlConfigKey]);
        if (configuredScriptUrl is not null)
            return TryBuildRybbitTrackEndpointFromScript(configuredScriptUrl, out string? scriptEndpoint)
                ? scriptEndpoint
                : null;

        string? baseUrl = NormalizeOptionalValue(Configuration[RybbitBaseUrlConfigKey]);
        if (baseUrl is not null)
            return TryBuildRybbitTrackEndpointFromBase(baseUrl, out string? baseEndpoint)
                ? baseEndpoint
                : null;

        return RybbitDefaultTrackUrl;
    }

    private bool TryBuildRybbitTrackEndpointFromScript(string value, out string? endpoint)
    {
        endpoint = null;
        if (!TryResolveSafeAnalyticsUri(value, out Uri? scriptUri)
            || scriptUri is null
            || !scriptUri.AbsolutePath.EndsWith(RybbitScriptSuffix, StringComparison.OrdinalIgnoreCase))
            return false;

        var builder = new UriBuilder(scriptUri)
        {
            Path = $"{scriptUri.AbsolutePath[..^RybbitScriptSuffix.Length]}/track"
        };
        endpoint = builder.Uri.ToString();
        return true;
    }

    private bool TryBuildRybbitTrackEndpointFromBase(string value, out string? endpoint)
    {
        endpoint = null;
        if (!TryResolveSafeAnalyticsUri(value, out Uri? baseUri)
            || baseUri is null)
            return false;

        var builder = new UriBuilder(baseUri)
        {
            Path = RybbitTrackPath
        };
        endpoint = builder.Uri.ToString();
        return true;
    }

    private bool TryResolveSafeAnalyticsUri(string value, out Uri? uri)
    {
        uri = null;
        if (value.Contains('\\')
            || value.Contains('?')
            || value.Contains('#'))
            return false;

        if (value.StartsWith("/", StringComparison.Ordinal)
            && !value.StartsWith("//", StringComparison.Ordinal)
            && Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? baseUri))
        {
            uri = new Uri(baseUri, value);
        }
        else if (!Uri.TryCreate(value, UriKind.Absolute, out uri))
        {
            return false;
        }

        if (!string.IsNullOrEmpty(uri.UserInfo))
            return false;
        if (string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out Uri? currentUri))
            return false;

        return string.Equals(uri.Scheme, currentUri.Scheme, StringComparison.OrdinalIgnoreCase)
            && string.Equals(uri.Host, currentUri.Host, StringComparison.OrdinalIgnoreCase)
            && uri.Port == currentUri.Port;
    }

    private static string? NormalizeAnalyticsToken(string? value)
    {
        string? normalized = NormalizeOptionalValue(value);
        if (normalized is null)
            return null;

        foreach (char c in normalized)
