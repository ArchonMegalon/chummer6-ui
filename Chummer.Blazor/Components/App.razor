    private static string? ResolveFallbackResultText(string command, string runner, string dialogAction)
    {
        string runnerLabel = string.IsNullOrWhiteSpace(runner) ? "BLUE" : runner;
        if (ResolveActionFallbackCommand(command) is { } actionCommand)
            return actionCommand.ResultText;

        if (ResolveDataPackCommand(command) is { } dataPackCommand)
            return dataPackCommand.ResultText;

        if (ResolveDialogFallbackCommand(command) is { } dialogCommand)
            return dialogCommand.ResultText;

        return command switch
        {
            "new_character" => "Continue Build Lab on Chummer Online.",
            "new_character_origin" => "Continue Origin Dossier on the clean route.",
            "character_roster" => "Continue Character Roster on Chummer Online.",
            "master_index" => "Continue Master Index on Chummer Online.",
