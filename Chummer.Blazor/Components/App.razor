    private static bool IsCleanPublicRoute(string absolutePath)
    {
        if (string.IsNullOrWhiteSpace(absolutePath))
            return false;

        string normalizedPath = absolutePath.TrimEnd('/');
        if (normalizedPath.Length == 0)
            normalizedPath = "/";

        return string.Equals(normalizedPath, "/app", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalizedPath, "/online", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeAssetPath(string assetPath)
        => string.IsNullOrWhiteSpace(assetPath)
