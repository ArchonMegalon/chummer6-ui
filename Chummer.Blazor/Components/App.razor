        if (!BuildPwaRelease.Assets.TryGetValue(normalizedAssetPath, out BuildPwaReleaseAsset? asset))
            throw new InvalidOperationException(
                $"Build PWA direct asset '{normalizedAssetPath}' is outside the sealed release contract.");

