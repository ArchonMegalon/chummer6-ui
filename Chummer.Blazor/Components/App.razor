</head>
<body>
<Routes @rendermode="new InteractiveServerRenderMode()" />
<script src="_framework/blazor.web.js"></script>
<script>
    window.chummerPwa = window.chummerPwa || {};
    (function(pwa) {
        const serviceWorkerScript = 'service-worker.js';
        const serviceWorkerScope = './';
        pwa.installState = pwa.installState || 'unsupported';
        if (!('serviceWorker' in navigator)) {
            return;
        }

        pwa.installState = 'pending';
        window.addEventListener('load', function() {
            navigator.serviceWorker.register(serviceWorkerScript, { scope: serviceWorkerScope })
                .then(function(registration) {
                    pwa.installState = 'ready';
                    pwa.registrationScope = registration.scope;
                })
                .catch(function(error) {
                    pwa.installState = 'failed';
                    pwa.installError = error && error.message ? error.message : String(error || 'unknown');
                });
        }, { once: true });
    })(window.chummerPwa);
    window.chummerUtilities = window.chummerUtilities || {};
    window.chummerUtilities.decodeBase64Utf8 = function(contentBase64) {
        const binary = atob(contentBase64 || '');
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
        }

        return new TextDecoder().decode(bytes);
    };
    window.chummerDownloads = window.chummerDownloads || {};
    window.chummerDownloads.downloadBase64 = function(fileName, contentBase64, mimeType) {
        if (!contentBase64) {
            return;
        }

        const anchor = document.createElement('a');
        anchor.href = `data:${mimeType || 'application/octet-stream'};base64,${contentBase64}`;
        anchor.download = fileName || 'chummer-download.dat';
        document.body.appendChild(anchor);
        anchor.click();
        document.body.removeChild(anchor);
    };
    window.chummerExports = window.chummerExports || {};
    window.chummerExports.downloadBase64 = function(fileName, contentBase64, mimeType) {
        window.chummerDownloads.downloadBase64(fileName, contentBase64, mimeType);
    };
    window.chummerAnalytics = window.chummerAnalytics || {};
    (function(analytics) {
        const maxQueueLength = 20;
        const eventPrefix = 'chummer_';
        const browserRouteEventName = 'browser_route';
        const hostClassBlazor = 'blazor';
        const analyticsScopeRouteWorkflowMetadataOnly = 'route-workflow-metadata-only';
        const analyticsDisabledPolicy = 'disabled';
        const propertyHostClass = 'host_class';
        const propertyAnalyticsScope = 'analytics_scope';
        const propertySessionReplay = 'session_replay';
        const propertyAutocapture = 'autocapture';
        const propertyRouteFamily = 'route_family';
        const propertyCommandId = 'command_id';
        const propertyTabId = 'tab_id';
        const propertyControlId = 'control_id';
        const propertyDialogActionId = 'dialog_action_id';
        const propertyHasWorkspace = 'has_workspace';
        const propertyHasDossier = 'has_dossier';
        const propertyHasFixture = 'has_fixture';
        const queryCommand = 'command';
        const queryTab = 'tab';
        const queryControl = 'control';
        const queryDialogAction = 'dialog_action';
        const queryWorkspace = 'workspace';
        const queryFixture = 'fixture';
        const allowedPropertyKeys = new Set([
            propertyHostClass,
            propertyAnalyticsScope,
            propertySessionReplay,
            propertyAutocapture,
            propertyRouteFamily,
            propertyCommandId,
            propertyTabId,
            propertyControlId,
            propertyDialogActionId,
            propertyHasWorkspace,
            propertyHasDossier,
            propertyHasFixture
        ]);
        const forbiddenPropertyPattern = /(alias|character|content|document|dossier|email|file|hash|name|owner|payload|workspace|xml)/i;
        const safeTokenPattern = /^[a-z0-9_.:-]{1,80}$/i;
        const analyticsScope = analyticsScopeRouteWorkflowMetadataOnly;
        const sessionReplayPolicy = analyticsDisabledPolicy;
        const autocapturePolicy = analyticsDisabledPolicy;
        const routeFamilyChummerApp = 'chummer_app';
        const routeFamilyPreview = 'preview';
        const routeFamilyShowcase = 'showcase';
        const routeFamilyDownloads = 'downloads';
        const routeFamilyDocs = 'docs';
        const routeFamilyOther = 'other';
        const pathBlazor = '/blazor';
        const pathBlazorSlash = '/blazor/';
        const pathApp = '/app';
        const pathOnline = '/online';
        const pathWorkbench = '/workbench';
        const pathPreview = '/preview';
        const pathShowcase = '/showcase';
        const pathDownloads = '/downloads';
        const pathDocs = '/docs';
        let lastRouteKey = '';

        analytics._queue = analytics._queue || [];

        function safeToken(value) {
            if (typeof value !== 'string') {
                return null;
            }

            const trimmed = value.trim();
            return safeTokenPattern.test(trimmed) ? trimmed : null;
        }

        function safePropertyKey(key) {
            const normalized = String(key || '')
                .trim()
                .toLowerCase()
                .replace(/[^a-z0-9_]/g, '_')
                .slice(0, 64);

            if (!normalized) {
                return null;
            }

            if (allowedPropertyKeys.has(normalized)) {
                return normalized;
            }

            if (forbiddenPropertyPattern.test(normalized)) {
                return null;
            }

            return null;
        }

        function safePropertyValue(value) {
            if (typeof value === 'number' && Number.isFinite(value)) {
                return value;
            }

            if (typeof value === 'boolean') {
                return value;
            }

            if (typeof value === 'string') {
                const trimmed = value.trim();
                return trimmed.length <= 120 && safeTokenPattern.test(trimmed) ? trimmed : null;
            }

            return null;
        }

        function sanitizeProperties(properties) {
            const safe = {};
            const entries = Object.entries(properties || {});
            for (const [key, value] of entries) {
                const safeKey = safePropertyKey(key);
                if (!safeKey) {
                    continue;
                }

                const safeValue = safePropertyValue(value);
                if (safeValue === null) {
                    continue;
                }

                safe[safeKey] = safeValue;
            }

            return safe;
        }

        function dispatch(eventName, properties) {
            const safeEventName = safeToken(eventName);
            if (!safeEventName) {
                return;
            }

            const payload = sanitizeProperties(properties);
            if (window.rybbit && typeof window.rybbit.event === 'function') {
                window.rybbit.event(`${eventPrefix}${safeEventName}`, payload);
                return;
            }

            if (analytics._queue.length < maxQueueLength) {
                analytics._queue.push([safeEventName, payload]);
            }
        }

        function flush() {
            if (!window.rybbit || typeof window.rybbit.event !== 'function') {
                return;
            }

            const queued = analytics._queue.splice(0, analytics._queue.length);
            for (const [eventName, payload] of queued) {
                window.rybbit.event(`${eventPrefix}${eventName}`, payload);
            }
        }

        function currentRouteProperties() {
            const url = new URL(window.location.href);
            const path = url.pathname.toLowerCase();
            const query = url.searchParams;
            let routeFamily = routeFamilyOther;

            if (path.endsWith(pathBlazor) || path.endsWith(pathBlazorSlash) || path.endsWith(pathApp) || path.endsWith(pathOnline) || path.endsWith(pathWorkbench)) {
                routeFamily = routeFamilyChummerApp;
            } else if (path.endsWith(pathPreview)) {
                routeFamily = routeFamilyPreview;
            } else if (path.endsWith(pathShowcase)) {
                routeFamily = routeFamilyShowcase;
            } else if (path.includes(pathDownloads)) {
                routeFamily = routeFamilyDownloads;
            } else if (path.includes(pathDocs)) {
                routeFamily = routeFamilyDocs;
            }

            return {
                [propertyHostClass]: hostClassBlazor,
                [propertyAnalyticsScope]: analyticsScope,
                [propertySessionReplay]: sessionReplayPolicy,
                [propertyAutocapture]: autocapturePolicy,
                [propertyRouteFamily]: routeFamily,
                [propertyCommandId]: safeToken(query.get(queryCommand)),
                [propertyTabId]: safeToken(query.get(queryTab)),
                [propertyControlId]: safeToken(query.get(queryControl)),
                [propertyDialogActionId]: safeToken(query.get(queryDialogAction)),
                [propertyHasWorkspace]: query.has(queryWorkspace),
                [propertyHasDossier]: query.has(queryWorkspace),
                [propertyHasFixture]: query.has(queryFixture)
            };
        }

        function trackRoute() {
            const properties = currentRouteProperties();
            const routeKey = JSON.stringify(properties);
            if (routeKey === lastRouteKey) {
                return;
            }

            lastRouteKey = routeKey;
            dispatch(browserRouteEventName, properties);
        }

        function scheduleRouteTracking() {
            window.setTimeout(trackRoute, 0);
        }

        const originalPushState = window.history.pushState;
        const originalReplaceState = window.history.replaceState;
        window.history.pushState = function() {
            const result = originalPushState.apply(this, arguments);
            scheduleRouteTracking();
            return result;
        };
        window.history.replaceState = function() {
            const result = originalReplaceState.apply(this, arguments);
            scheduleRouteTracking();
            return result;
        };

        analytics.event = dispatch;
        analytics.trackRoute = trackRoute;
        window.addEventListener('popstate', scheduleRouteTracking);
        window.setInterval(flush, 1000);
        scheduleRouteTracking();
    })(window.chummerAnalytics);
    window.chummerDialogs = window.chummerDialogs || {};
    window.chummerDialogs._lastRevealedBackdrop = window.chummerDialogs._lastRevealedBackdrop || null;
    window.chummerDialogs._lastRevealedDialogId = window.chummerDialogs._lastRevealedDialogId || null;
    window.chummerDialogs._pendingRevealResetHandle = window.chummerDialogs._pendingRevealResetHandle || null;
    window.chummerDialogs._pendingOriginAdvancedAnchor = window.chummerDialogs._pendingOriginAdvancedAnchor || null;
    window.chummerDialogs._pendingOriginFieldAnchor = window.chummerDialogs._pendingOriginFieldAnchor || null;
    window.chummerDialogs._pendingOriginAnchorCapturedAtMs = window.chummerDialogs._pendingOriginAnchorCapturedAtMs || 0;
    window.chummerDialogs._pendingSameDialogRefreshDialogId = window.chummerDialogs._pendingSameDialogRefreshDialogId || null;
    window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs || 0;
    window.chummerDialogs._pendingDialogScrollRestoreVersion = window.chummerDialogs._pendingDialogScrollRestoreVersion || 0;
    window.chummerDialogs._originSameDialogAnchorGraceWindowMs = window.chummerDialogs._originSameDialogAnchorGraceWindowMs || 4000;
    window.chummerDialogs._sameDialogRefreshArmWindowMs = window.chummerDialogs._sameDialogRefreshArmWindowMs || 4000;
    window.chummerDialogs._sameDialogRefreshGraceWindowMs = window.chummerDialogs._sameDialogRefreshGraceWindowMs || 750;
    window.chummerDialogs.clearPendingOriginAnchors = function() {
        window.chummerDialogs._pendingDialogScrollRestoreVersion =
            Number(window.chummerDialogs._pendingDialogScrollRestoreVersion || 0) + 1;
        window.chummerDialogs._pendingOriginAdvancedAnchor = null;
        window.chummerDialogs._pendingOriginFieldAnchor = null;
        window.chummerDialogs._pendingOriginAnchorCapturedAtMs = 0;
        window.chummerDialogs._pendingSameDialogRefreshDialogId = null;
        window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = 0;
    };
    window.chummerDialogs.armSameDialogRefresh = function(dialogId) {
        if (!dialogId) {
            window.chummerDialogs._pendingSameDialogRefreshDialogId = null;
            window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = 0;
            return;
        }

        window.chummerDialogs._pendingSameDialogRefreshDialogId = dialogId;
        window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = Date.now();
    };
    window.chummerDialogs.hasPendingSameDialogRefresh = function(dialogId) {
        const pendingDialogId = window.chummerDialogs._pendingSameDialogRefreshDialogId;
        if (!pendingDialogId) {
            return false;
        }

        if (dialogId && pendingDialogId !== dialogId) {
            return false;
        }

        const capturedAtMs = Number(window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs || 0);
        return capturedAtMs > 0
            && (Date.now() - capturedAtMs) <= window.chummerDialogs._sameDialogRefreshArmWindowMs;
    };
    window.chummerDialogs.hasPendingOriginAnchor = function(dialogId) {
        const matchesDialog = function(anchor) {
            if (!anchor) {
                return false;
            }

            if (!dialogId) {
                return true;
            }

            return !anchor.dialogId || anchor.dialogId === dialogId;
        };

        if (!matchesDialog(window.chummerDialogs._pendingOriginFieldAnchor)
            && !matchesDialog(window.chummerDialogs._pendingOriginAdvancedAnchor)) {
            return false;
        }

        const capturedAtMs = Number(window.chummerDialogs._pendingOriginAnchorCapturedAtMs || 0);
        return capturedAtMs <= 0
            || (Date.now() - capturedAtMs) <= window.chummerDialogs._originSameDialogAnchorGraceWindowMs;
    };
    window.chummerDialogs.resetRevealState = function() {
        if (window.chummerDialogs._pendingRevealResetHandle) {
            window.clearTimeout(window.chummerDialogs._pendingRevealResetHandle);
            window.chummerDialogs._pendingRevealResetHandle = null;
        }

        window.chummerDialogs._lastRevealedBackdrop = null;
        window.chummerDialogs._lastRevealedDialogId = null;
        window.chummerDialogs.clearPendingOriginAnchors();
    };
    window.chummerDialogs.scheduleRevealReset = function() {
        if (window.chummerDialogs._pendingRevealResetHandle) {
            return;
        }

        window.chummerDialogs._pendingRevealResetHandle = window.setTimeout(() => {
            window.chummerDialogs._pendingRevealResetHandle = null;
            if (window.chummerDialogs.hasPendingOriginAnchor(window.chummerDialogs._lastRevealedDialogId || null)
                || window.chummerDialogs.hasPendingSameDialogRefresh(window.chummerDialogs._lastRevealedDialogId || null)) {
                window.chummerDialogs.scheduleRevealReset();
                return;
            }

            window.chummerDialogs._lastRevealedBackdrop = null;
            window.chummerDialogs._lastRevealedDialogId = null;
            window.chummerDialogs.clearPendingOriginAnchors();
        }, window.chummerDialogs._sameDialogRefreshGraceWindowMs);
    };
    window.chummerDialogs.cancelRevealReset = function() {
        if (!window.chummerDialogs._pendingRevealResetHandle) {
            return;
        }

        window.clearTimeout(window.chummerDialogs._pendingRevealResetHandle);
        window.chummerDialogs._pendingRevealResetHandle = null;
    };
    window.chummerDialogs.hasLiveRevealedBackdrop = function() {
        return !!(window.chummerDialogs._lastRevealedBackdrop
            && document.body.contains(window.chummerDialogs._lastRevealedBackdrop));
    };
    window.chummerDialogs.isSameDialogRefresh = function(dialogId) {
        return !!(dialogId
            && (window.chummerDialogs._lastRevealedDialogId === dialogId
                || window.chummerDialogs.hasPendingSameDialogRefresh(dialogId)
                || window.chummerDialogs.hasPendingOriginAnchor(dialogId)));
    };
    window.chummerDialogs.revealActiveDialog = function() {
        return new Promise((resolve) => {
            const reveal = function() {
                const backdrop = document.getElementById('dialogBackdrop');
                if (!backdrop) {
                    window.chummerDialogs.scheduleRevealReset();
                    resolve();
                    return;
                }

                const dialogId = backdrop.getAttribute('data-dialog-id') || '';
                window.chummerDialogs.cancelRevealReset();
                if (window.chummerDialogs.isSameDialogRefresh(dialogId)) {
                    window.chummerDialogs._lastRevealedBackdrop = backdrop;
                    window.chummerDialogs._lastRevealedDialogId = dialogId || null;
                    resolve();
                    return;
                }

                window.chummerDialogs._lastRevealedBackdrop = backdrop;
                window.chummerDialogs._lastRevealedDialogId = dialogId || null;
                backdrop.scrollIntoView({ block: 'center', inline: 'center' });
                resolve();
            };

            if (window.requestAnimationFrame) {
                window.requestAnimationFrame(reveal);
                return;
            }

            window.setTimeout(reveal, 0);
        });
    };
    window.chummerDialogs.captureDialogScroll = function(element, fieldId) {
        if (!element) {
            window.chummerDialogs.clearPendingOriginAnchors();
            return [0, 0];
        }

        window.chummerDialogs._pendingDialogScrollRestoreVersion =
            Number(window.chummerDialogs._pendingDialogScrollRestoreVersion || 0) + 1;

        const backdrop = document.getElementById('dialogBackdrop');
        const dialogId = backdrop ? (backdrop.getAttribute('data-dialog-id') || '') : '';
        window.chummerDialogs.armSameDialogRefresh(dialogId || null);
        const normalizedFieldId = typeof fieldId === 'string' ? fieldId : '';
        const fieldAnchorElement = normalizedFieldId
            ? Array.from(element.querySelectorAll('[data-field-id]')).find(candidate => candidate.getAttribute('data-field-id') === normalizedFieldId)
            : null;
        const fieldAnchorInsideOriginWizard = !!(fieldAnchorElement && fieldAnchorElement.closest('[data-origin-wizard]'));
        if (fieldAnchorElement && fieldAnchorInsideOriginWizard) {
            const elementRect = element.getBoundingClientRect();
            const fieldRect = fieldAnchorElement.getBoundingClientRect();
            window.chummerDialogs._pendingOriginFieldAnchor = {
                dialogId: dialogId || null,
                fieldId: normalizedFieldId,
                top: fieldRect.top - elementRect.top
            };
        } else {
            window.chummerDialogs._pendingOriginFieldAnchor = null;
        }

        const advancedControls = element.querySelector('[data-origin-advanced-controls][data-expanded="true"]');
        if (advancedControls) {
            const elementRect = element.getBoundingClientRect();
            const advancedRect = advancedControls.getBoundingClientRect();
            window.chummerDialogs._pendingOriginAdvancedAnchor = {
                dialogId: dialogId || null,
                top: advancedRect.top - elementRect.top
            };
        } else {
            window.chummerDialogs._pendingOriginAdvancedAnchor = null;
        }

        window.chummerDialogs._pendingOriginAnchorCapturedAtMs =
            window.chummerDialogs._pendingOriginFieldAnchor || window.chummerDialogs._pendingOriginAdvancedAnchor
                ? Date.now()
                : 0;

        return [element.scrollTop || 0, element.scrollLeft || 0];
    };
    window.chummerDialogs.restoreDialogScroll = function(element, scrollOffset) {
        if (!element || !Array.isArray(scrollOffset) || scrollOffset.length < 2) {
            return;
        }

        const restoreVersion = Number(window.chummerDialogs._pendingDialogScrollRestoreVersion || 0);
        const top = Number(scrollOffset[0] || 0);
        const left = Number(scrollOffset[1] || 0);
        const hasOriginAnchor = function() {
            return !!window.chummerDialogs._pendingOriginFieldAnchor
                || !!window.chummerDialogs._pendingOriginAdvancedAnchor;
        };
        const restoreOriginFieldAnchor = function() {
            const anchor = window.chummerDialogs._pendingOriginFieldAnchor;
            if (!anchor) {
                return false;
            }

            const backdrop = document.getElementById('dialogBackdrop');
            const dialogId = backdrop ? (backdrop.getAttribute('data-dialog-id') || '') : '';
            if (anchor.dialogId && dialogId && anchor.dialogId !== dialogId) {
                window.chummerDialogs._pendingOriginFieldAnchor = null;
                return false;
            }

            const fieldAnchorElement = Array.from(element.querySelectorAll('[data-field-id]')).find(candidate => candidate.getAttribute('data-field-id') === anchor.fieldId);
            if (!fieldAnchorElement || !fieldAnchorElement.closest('[data-origin-wizard]')) {
                return false;
            }

            const elementRect = element.getBoundingClientRect();
            const fieldRect = fieldAnchorElement.getBoundingClientRect();
            const delta = (fieldRect.top - elementRect.top) - Number(anchor.top || 0);
            if (Math.abs(delta) <= 0.5) {
                return true;
            }

            element.scrollTop += delta;
            return true;
        };
        const restoreOriginAdvancedAnchor = function() {
            const anchor = window.chummerDialogs._pendingOriginAdvancedAnchor;
            if (!anchor) {
                return false;
            }

            const backdrop = document.getElementById('dialogBackdrop');
            const dialogId = backdrop ? (backdrop.getAttribute('data-dialog-id') || '') : '';
            if (anchor.dialogId && dialogId && anchor.dialogId !== dialogId) {
                window.chummerDialogs._pendingOriginAdvancedAnchor = null;
                return false;
            }

            const advancedControls = element.querySelector('[data-origin-advanced-controls][data-expanded="true"]');
            if (!advancedControls) {
                return false;
            }

            const elementRect = element.getBoundingClientRect();
            const advancedRect = advancedControls.getBoundingClientRect();
            const delta = (advancedRect.top - elementRect.top) - Number(anchor.top || 0);
            if (Math.abs(delta) <= 0.5) {
                return true;
            }

            element.scrollTop += delta;
            return true;
        };
        const shouldPreferOriginAdvancedAnchor = function() {
            return !!window.chummerDialogs._pendingOriginAdvancedAnchor;
        };
        const restore = function() {
            if (restoreVersion !== Number(window.chummerDialogs._pendingDialogScrollRestoreVersion || 0)) {
                return;
            }

            const anchoredRestorePending = hasOriginAnchor();
            if (!anchoredRestorePending) {
                element.scrollTop = top;
                element.scrollLeft = left;
            }

            if (shouldPreferOriginAdvancedAnchor()) {
                if (!restoreOriginAdvancedAnchor()) {
                    restoreOriginFieldAnchor();
                }
                return;
            }

            if (anchoredRestorePending && !restoreOriginFieldAnchor()) {
                restoreOriginAdvancedAnchor();
            }
        };

        restore();

        if (typeof window.requestAnimationFrame === 'function') {
            window.requestAnimationFrame(() => restore());
        }

        window.setTimeout(() => restore(), 0);
        window.setTimeout(() => restore(), 32);
        window.setTimeout(() => restore(), 96);
        window.setTimeout(() => restore(), 192);
    };
    window.chummerDialogs.startObserver = function() {
        if (window.chummerDialogs._observer) {
            return;
        }

        const revealIfNeeded = function() {
            const backdrop = document.getElementById('dialogBackdrop');
            if (!backdrop) {
                window.chummerDialogs.scheduleRevealReset();
                return;
            }

            const dialogId = backdrop.getAttribute('data-dialog-id') || '';
            if (window.chummerDialogs.hasLiveRevealedBackdrop()
                && window.chummerDialogs._lastRevealedBackdrop === backdrop
                && window.chummerDialogs._lastRevealedDialogId === dialogId
                && !window.chummerDialogs.hasPendingSameDialogRefresh(dialogId)
                && !window.chummerDialogs.hasPendingOriginAnchor(dialogId)) {
                return;
            }

            window.chummerDialogs.revealActiveDialog();
        };

        window.chummerDialogs._observer = new MutationObserver(revealIfNeeded);
        window.chummerDialogs._observer.observe(document.body, { childList: true, subtree: true });
        window.setTimeout(revealIfNeeded, 0);
    };
    window.chummerDialogs.startObserver();
    window.chummerPrints = window.chummerPrints || {};
    window.chummerPrints.openBase64 = function(fileName, contentBase64, mimeType, title) {
        if (!contentBase64) {
            return;
        }

        const printWindow = window.open('', '_blank');
        if (!printWindow) {
            throw new Error('Print window could not be opened.');
        }

        const decoded = window.chummerUtilities.decodeBase64Utf8(contentBase64);
        if ((mimeType || '').toLowerCase() === 'text/html') {
            printWindow.document.open();
            printWindow.document.write(decoded);
            printWindow.document.close();
        } else {
            printWindow.document.open();
            printWindow.document.write(`<pre>${decoded}</pre>`);
            printWindow.document.close();
        }

        if (title) {
            printWindow.document.title = title;
        } else if (fileName) {
            printWindow.document.title = fileName;
        }

        const triggerPrint = function() {
            printWindow.focus();
            if (printWindow.requestAnimationFrame) {
                printWindow.requestAnimationFrame(() => printWindow.print());
                return;
            }

            printWindow.print();
        };

        if (printWindow.document.readyState === 'complete') {
            triggerPrint();
            return;
        }

        printWindow.addEventListener('load', triggerPrint, { once: true });
    };
</script>
