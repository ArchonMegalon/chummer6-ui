    private static string NormalizeRouteDataKey(string? value)
    {
        string normalized = NormalizeDataToken(value);
        return string.IsNullOrWhiteSpace(normalized)
            ? "none"
            : normalized.Replace('_', '-').ToLowerInvariant();
    }

    private static string ResolveFallbackTab(string command, string control)
    {
        if (!string.IsNullOrWhiteSpace(control))
        {
            if (control.Contains("complex_form", StringComparison.OrdinalIgnoreCase))
                return "tab-technomancer";
            if (control.Contains("entry", StringComparison.OrdinalIgnoreCase))
                return "tab-calendar";
        }

        return string.Equals(command, "new_character", StringComparison.Ordinal)
            ? "tab-create"
            : "tab-info";
    }

    private static string ResolveFallbackTitle(string command, string control, string tab)
    {
        if (ResolveFallbackDialog(command, control) is { } dialog)
            return dialog.Title;

        if (!string.IsNullOrWhiteSpace(command))
            return command switch
            {
                "save_character_as" => "Download prepared",
                "print_character" => "Print preview prepared",
                _ => "Chummer Online"
            };

        return ResolveFallbackSectionHeading(tab);
    }

