@using Chummer.Blazor.Services
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IWebHostEnvironment BuildPwaEnvironment
@inject Chummer.Application.Owners.IOwnerContextAccessor OwnerContextAccessor
@inject HostedBuildOwnerInvalidationTokenService OwnerInvalidationTokens
@implements IDisposable

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f3b3e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Chummer Build" />
    <meta name="application-name" content="Chummer Build" />
    <base href="@BuildBaseHref()" />
    <title>Chummer Build</title>
    <link rel="manifest" href="@BuildStaticAssetHref("manifest.webmanifest")" />
    <link rel="icon" type="image/svg+xml" href="@BuildStaticAssetHref("icons/chummer-pwa.svg")" />
    <link rel="apple-touch-icon" href="@BuildStaticAssetHref("media/chummer6/chummer6-hero-baseline.png")" />
    <link rel="apple-touch-icon" sizes="180x180" href="@BuildStaticAssetHref("icons/chummer-build-180.png")" />
    <link rel="stylesheet" href="@BuildStaticAssetHref("Chummer.Blazor.styles.css")" integrity="@BuildStaticAssetIntegrity("Chummer.Blazor.styles.css")" crossorigin="anonymous" />
    <link rel="stylesheet" href="@BuildStaticAssetHref("app.css")" integrity="@BuildStaticAssetIntegrity("app.css")" crossorigin="anonymous" />
    <link rel="stylesheet" href="@BuildStaticAssetHref("build-pwa-install.css")" integrity="@BuildStaticAssetIntegrity("build-pwa-install.css")" crossorigin="anonymous" />
    @if (BuildRybbitAnalyticsOptions() is { } rybbitAnalytics)
    {
        <meta name="chummer-analytics-config"
              data-provider="rybbit"
              data-endpoint-url="@rybbitAnalytics.EndpointUrl"
              data-site-id="@rybbitAnalytics.SiteId"
              data-consent-default="denied"
              data-automatic-pageviews="disabled" />
    }
</head>
<body>
@if (BuildAppRouteFallback() is { } appRouteFallback)
{
    <section id="chummer-online-app"
             class="browser-app-roster"
             tabindex="-1"
             aria-label="@appRouteFallback.AriaLabel"
             data-ssr-app-route-fallback="true"
             data-enhance-nav="false"
             data-active-workflow="@appRouteFallback.ActiveWorkflow"
             data-route-family="@appRouteFallback.RouteFamily"
             data-route-segment="@appRouteFallback.RouteSegment"
             data-route-surface="@appRouteFallback.RouteSurface"
             data-canonical-route="@appRouteFallback.CanonicalRoute"
             data-route-alias="@appRouteFallback.RouteAlias"
             data-command="@appRouteFallback.CommandDataKey"
             data-tab="@appRouteFallback.TabDataKey"
             data-workspace="@appRouteFallback.WorkspaceDataKey"
             data-control="@appRouteFallback.ControlDataKey"
             data-dialog-action="@appRouteFallback.DialogActionDataKey"
             data-fixture="@appRouteFallback.FixtureDataKey"
             data-legacy-runner="@appRouteFallback.LegacyRunnerDataKey"
             data-chummer-app-startup-command="@appRouteFallback.StartupCommandLabel"
             data-browser-shell-command="@appRouteFallback.CommandDataKey">
        <header class="browser-app-roster-head">
            <div>
                <span>Chummer Online</span>
                <h1>@appRouteFallback.Title</h1>
                <p>@appRouteFallback.Description</p>
            </div>
            <nav class="browser-app-roster-actions" aria-label="Roster actions">
                <a href="@BuildAppNewRunnerHref(appRouteFallback)">New runner</a>
                <a href="@BuildAppHref(command: "new_character_origin")">Origin Dossier</a>
                <a href="@BuildAppHref(command: "open_character")">Import</a>
                <a href="@BuildAppSeedHref(appRouteFallback)">Open example</a>
            </nav>
        </header>

        @if (appRouteFallback.ShouldRenderStartupShell)
        {
            <section class="browser-preview-frame browser-preview-frame--app-route"
                     aria-label="@appRouteFallback.FrameLabel"
                     data-app-route-shared-shell="true"
                     data-app-route-workflow="@appRouteFallback.ActiveWorkflow">
                <div class="browser-preview-frame-header">
                    <div>
                        <p class="browser-preview-frame-kicker">@appRouteFallback.Title</p>
                        <h2>@appRouteFallback.FrameTitle</h2>
                    </div>
                    <p data-chummer-app-startup-command="@appRouteFallback.StartupCommandLabel">
                        <strong>@appRouteFallback.Title</strong>
                        @appRouteFallback.FrameSummary
                    </p>
                </div>
                <section class="desktop-shell classic-desktop-shell"
                         data-ssr-shared-shell-fallback="true"
                         data-active-workflow="@appRouteFallback.ActiveWorkflow"
                         data-route-segment="@appRouteFallback.RouteSegment"
                         data-command="@appRouteFallback.CommandDataKey"
                         data-tab="@appRouteFallback.TabDataKey"
                         data-workspace="@appRouteFallback.WorkspaceDataKey"
                         data-client-kind="browser">
                    <aside class="workspace-left-pane" aria-label="Recent work">
                        <a data-workbench-recovery-action="build-lab" href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-create")">Continue Build Lab</a>
                        <a data-workbench-recovery-action="continue-recent" href="@BuildAppSeedHref(appRouteFallback, tab: "tab-contacts")">Continue BLUE</a>
                        <a data-workbench-recovery-action="import" href="@BuildAppHref(command: "open_character")">Import runner XML</a>
                    </aside>
                    <main class="section-preview" aria-label="@appRouteFallback.SectionHeading">
                        <h2>@appRouteFallback.SectionHeading</h2>
                        <p>@appRouteFallback.SectionSummary</p>
                    </main>
                </section>
            </section>
        }
        else
        {
            <div class="browser-app-classic-chrome" data-app-classic-chrome="true">
                <nav class="browser-app-classic-menu-bar" aria-label="Chummer Online menu">
                    <details class="browser-app-classic-menu-root" data-app-menu-root="file">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="file">File</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="file">
                            <a href="@BuildAppNewRunnerHref(appRouteFallback)"
                               role="menuitem"
                               data-app-menu-item="new-runner">New runner</a>
                            <a href="@BuildAppHref(command: "open_character")"
                               role="menuitem"
                               data-app-menu-item="open-runner">Open Runner</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, command: "save_character_as")"
                               role="menuitem"
                               data-app-menu-item="save-download">Save/download</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, command: "print_character")"
                               role="menuitem"
                               data-app-menu-item="print">Print</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, command: "export_character", dialogAction: "download")"
                               role="menuitem"
                               data-app-menu-item="export">Export</a>
                        </div>
                    </details>
                    <details class="browser-app-classic-menu-root" data-app-menu-root="edit">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="edit">Edit</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="edit">
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-create")"
                               role="menuitem"
                               data-app-menu-item="build-lab">Build Lab</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-gear")"
                               role="menuitem"
                               data-app-menu-item="gear">Gear</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-info")"
                               role="menuitem"
                               data-app-menu-item="profile">Profile</a>
                        </div>
                    </details>
                    <details class="browser-app-classic-menu-root" data-app-menu-root="view">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="view">View</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="view">
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-info")"
                               role="menuitem"
                               data-app-menu-item="view-profile">Profile</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-rules")"
                               role="menuitem"
                               data-app-menu-item="view-rules">Rules</a>
                            <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-contacts")"
                               role="menuitem"
                               data-app-menu-item="view-contacts">Contacts</a>
                        </div>
                    </details>
                    <details class="browser-app-classic-menu-root" data-app-menu-root="runner">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="runner">Runner</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="runner">
                            <a href="@BuildAppHref(command: "character_roster")"
                               role="menuitem"
                               aria-current="@(IsCharacterRosterCommand(appRouteFallback.Command) ? "page" : null)"
                               data-app-menu-item="character-roster">Character Roster</a>
                            <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-contacts")"
                               role="menuitem"
                               data-app-menu-item="continue-runner">Continue runner</a>
                            <a href="@BuildAppHref(command: "open_character")"
                               role="menuitem"
                               data-app-menu-item="import-runner-xml">Import runner XML</a>
                        </div>
                    </details>
                    <details class="browser-app-classic-menu-root" data-app-menu-root="tools">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="tools">Tools</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="tools">
                            <a href="@BuildAppHref(command: "global_settings")"
                               role="menuitem"
                               data-app-menu-item="options">Options</a>
                            <a href="/status"
                               role="menuitem"
                               data-app-menu-item="status">Status</a>
                            <a href="/downloads/"
                               role="menuitem"
                               data-app-menu-item="desktop-installers">Desktop installers</a>
                        </div>
                    </details>
                    <details class="browser-app-classic-menu-root" data-app-menu-root="help">
                        <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="help">Help</summary>
                        <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="help">
                            <a href="/help"
                               role="menuitem"
                               data-app-menu-item="help">Help</a>
                            <a href="/docs/"
                               role="menuitem"
                               data-app-menu-item="docs">Docs</a>
                            <a href="/contact"
                               role="menuitem"
                               data-app-menu-item="support">Support</a>
                        </div>
                    </details>
                </nav>
                <nav class="browser-app-classic-toolstrip"
                     role="toolbar"
                     aria-label="Chummer Online quick actions"
                     data-app-toolstrip="classic">
                    <a href="@BuildAppNewRunnerHref(appRouteFallback)"
                       data-app-toolstrip-action="new-runner">New runner</a>
                    <a href="@BuildAppHref(command: "open_character")"
                       data-app-toolstrip-action="open-runner">Open Runner</a>
                    <a href="@BuildAppContinuationHref(appRouteFallback, command: "save_character_as")"
                       data-app-toolstrip-action="save-download">Save/download</a>
                    <a href="@BuildAppContinuationHref(appRouteFallback, command: "print_character")"
                       data-app-toolstrip-action="print">Print</a>
                    <a href="@BuildAppContinuationHref(appRouteFallback, command: "export_character", dialogAction: "download")"
                       data-app-toolstrip-action="export">Export</a>
                    <a href="@BuildAppHref(command: "character_roster")"
                       aria-current="@(IsCharacterRosterCommand(appRouteFallback.Command) ? "page" : null)"
                       data-app-toolstrip-action="character-roster">Character Roster</a>
                    <a href="@BuildAppContinuationHref(appRouteFallback, tab: "tab-create")"
                       data-app-toolstrip-action="build-lab">Build Lab</a>
                </nav>
            </div>
            <div class="browser-app-roster-grid">
            <aside class="browser-app-roster-tree" aria-label="Runner folders">
                <div class="browser-app-roster-toolbar" role="toolbar" aria-label="Organize runners">
                    <button type="button">New folder</button>
                    <button type="button">Rename</button>
                    <button type="button">Move</button>
                </div>
                <ul role="tree" aria-label="Character roster">
                    <li role="treeitem" aria-expanded="true" data-drop-target="runner-folder">
                        <span>Current table</span>
                        <ul role="group">
                            <li role="treeitem" aria-selected="true" draggable="true">
                                <a href="@BuildAppSeedHref(appRouteFallback)">Kestrel</a>
                            </li>
                            <li role="treeitem" draggable="true">
                                <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-technomancer")">Rook</a>
                            </li>
                        </ul>
                    </li>
                    <li role="treeitem" aria-expanded="true" data-drop-target="runner-folder">
                        <span>Examples</span>
                        <ul role="group">
                            <li role="treeitem" draggable="true">
                                <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-info")">Mara</a>
                            </li>
                            <li role="treeitem" draggable="true">
                                <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-rules")">Ash</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </aside>

            <section class="browser-app-runner-panel" aria-label="Selected runner">
                <header>
                    <span>Street samurai</span>
                    <h2>Kestrel</h2>
                    <p>Fast, direct, gear-heavy.</p>
                </header>
                    <div class="browser-app-runner-stats" aria-label="Runner summary">
                        <span><strong>SR5</strong><small>rules</small></span>
                        <span><strong>12</strong><small>karma</small></span>
                        <span><strong>8,450 nuyen</strong><small>cash</small></span>
                        <span><strong>5.4</strong><small>essence</small></span>
                    </div>
                    <nav class="browser-app-runner-actions" aria-label="Open Kestrel">
                    <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-create")">Build</a>
                    <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-gear")">Gear</a>
                    <a href="@BuildAppSeedHref(appRouteFallback, tab: "tab-contacts")">Contacts</a>
                    <a href="@BuildAppSeedHref(appRouteFallback, command: "save_character_as")">Download</a>
                </nav>
            </section>

            <section class="browser-app-example-panel" aria-label="Example archetypes">
                <h2>Examples</h2>
                <div class="browser-app-example-runners" role="list">
                    <a role="listitem" href="@BuildAppSeedHref(appRouteFallback)">
                        <span>Kestrel</span>
                        <strong>Street samurai</strong>
                        <small>Fast, direct, gear-heavy.</small>
                    </a>
                    <a role="listitem" href="@BuildAppSeedHref(appRouteFallback, tab: "tab-technomancer")">
                        <span>Rook</span>
                        <strong>Decker</strong>
                        <small>Matrix work and quiet entry.</small>
                    </a>
                    <a role="listitem" href="@BuildAppSeedHref(appRouteFallback, tab: "tab-info")">
                        <span>Mara</span>
                        <strong>Face</strong>
                        <small>Contacts, leverage, social pressure.</small>
                    </a>
                    <a role="listitem" href="@BuildAppSeedHref(appRouteFallback, tab: "tab-rules")">
                        <span>Ash</span>
                        <strong>Mage</strong>
                        <small>Spells, spirits, and astral risk.</small>
                    </a>
                </div>
            </section>
        </div>
        }
    </section>
}
@if (BuildWorkbenchFallback() is { } workbenchFallback)
{
    <section id="chummer-online-app"
             class="classic-chummer-shell"
             tabindex="-1"
             aria-label="Chummer Online classic desktop shell"
             data-ssr-workbench-fallback="true"
             data-chummer-classic-shell="true"
             data-active-workflow="@workbenchFallback.ActiveWorkflow"
             data-output-workflow="@workbenchFallback.OutputWorkflow"
             data-output-state="@workbenchFallback.OutputState"
             data-output-target="@workbenchFallback.OutputTarget"
             data-route-family="@workbenchFallback.RouteFamily"
             data-route-segment="workbench"
             data-route-surface="@workbenchFallback.RouteSurface"
             data-canonical-route="workbench"
             data-route-alias="@workbenchFallback.RouteAlias"
             data-command="@workbenchFallback.Command"
             data-tab="@workbenchFallback.Tab"
             data-workspace="@workbenchFallback.Workspace"
             data-active-runner="@workbenchFallback.Runner"
             data-roster-selected-node="@workbenchFallback.SelectedRosterNode"
             data-dossier-state="@workbenchFallback.DossierState"
             data-dossier-storage="@workbenchFallback.DossierStorage"
             data-legacy-runner="@workbenchFallback.Runner"
             data-ruleset="sr5"
             data-validation-state="@workbenchFallback.ValidationState"
             data-privacy-mode="@workbenchFallback.PrivacyMode"
             data-analytics-scope="@workbenchFallback.AnalyticsScope"
             data-hosting-mode="@workbenchFallback.HostingMode"
             data-deployment-target="@workbenchFallback.DeploymentTarget"
             data-self-hostable="@workbenchFallback.SelfHostable"
             data-container-target="@workbenchFallback.ContainerTarget"
             data-auth-gate="@workbenchFallback.AuthGate"
             data-session-state="@workbenchFallback.SessionState"
             data-login-target="@workbenchFallback.LoginTarget"
             data-auth-return-policy="@workbenchFallback.AuthReturnPolicy"
             data-fixture="@workbenchFallback.Fixture"
             data-control="@workbenchFallback.Control"
             data-dialog-action="@workbenchFallback.DialogAction"
             data-client-kind="@workbenchFallback.ClientKind"
             data-parity-target="@workbenchFallback.ParityTarget"
             data-calculation-owner="@workbenchFallback.CalculationOwner"
             data-statistics-runtime="@workbenchFallback.StatisticsRuntime"
             data-character-statistics="@workbenchFallback.CharacterStatistics"
             data-statistics-scope="@workbenchFallback.StatisticsScope"
             data-recommendation-mode="@workbenchFallback.RecommendationMode"
             data-recommendation-inputs="@workbenchFallback.RecommendationInputs"
             data-risk-model="@workbenchFallback.RiskModel"
             data-calculation-boundary="@workbenchFallback.CalculationBoundary"
             data-result-consumer="@workbenchFallback.ResultConsumer">
        <header class="classic-chummer-titlebar" aria-label="Chummer Online window title">
            <div class="classic-chummer-titlebar-title">Chummer Online - @workbenchFallback.Runner - @workbenchFallback.WorkflowLabel</div>
            <div class="classic-window-controls" aria-hidden="true"><span>_</span><span>[]</span><span>X</span></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(workbenchFallback.CommittedResult))
        {
            <section class="browser-workbench-committed-result"
                     role="status"
                     aria-live="polite"
                     data-workbench-committed-result="@NormalizeDataToken(workbenchFallback.CommittedResult)">
                <strong>@workbenchFallback.CommittedResult</strong>
            </section>
        }

        <nav class="classic-chummer-menu browser-app-classic-menu-bar" aria-label="Classic Chummer menu">
            <details class="browser-app-classic-menu-root" data-app-menu-root="file">
                <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="file">File</summary>
                <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="file">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create", command: "new_character")"
                       role="menuitem"
                       data-app-menu-item="new-runner">New runner</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create")"
                       role="menuitem"
                       data-app-menu-item="build-lab">Continue Build Lab</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback)"
                       role="menuitem"
                       data-app-menu-item="continue-runner">Continue @workbenchFallback.Runner</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, command: "open_character")"
                       role="menuitem"
                       data-app-menu-item="open-runner">Import runner XML</a>
                </div>
            </details>
            <details class="browser-app-classic-menu-root" data-app-menu-root="edit">
                <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="edit">Edit</summary>
                <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="edit">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create")" role="menuitem" data-app-menu-item="build-lab">Build Lab</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-info")" role="menuitem" data-app-menu-item="profile">Profile</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-gear")" role="menuitem" data-app-menu-item="gear">Gear</a>
                </div>
            </details>
            <details class="browser-app-classic-menu-root" data-app-menu-root="view">
                <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="view">View</summary>
                <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="view">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-rules")" role="menuitem" data-app-menu-item="view-rules">Rules</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-technomancer")" role="menuitem" data-app-menu-item="view-advanced">Advanced</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-calendar")" role="menuitem" data-app-menu-item="view-career">Career log</a>
                </div>
            </details>
            <details class="browser-app-classic-menu-root" data-app-menu-root="special">
                <summary role="button" tabindex="0" aria-expanded="false" data-app-menu-summary="special">Special</summary>
                <div class="browser-app-classic-menu-flyout" role="menu" data-app-menu-flyout="special">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-technomancer", control: "complex_form_add")" role="menuitem" data-app-menu-item="complex-form-add">Add complex form</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-cyberware", control: "cyberware_add")" role="menuitem" data-app-menu-item="cyberware-add">Add cyberware</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-magician", control: "spell_add")" role="menuitem" data-app-menu-item="spell-add">Add spell</a>
                </div>
            </details>
        </nav>

        <section class="desktop-shell classic-desktop-shell"
                 data-tab="@workbenchFallback.Tab"
                 data-ruleset="sr5"
                 data-active-workflow="@workbenchFallback.ActiveWorkflow"
                 data-route-segment="workbench"
                 data-active-runner="@workbenchFallback.Runner"
                 data-legacy-runner="@workbenchFallback.Runner">
            <aside class="workspace-left-pane" aria-label="Recent work">
                <a data-workbench-recent-workspace="true"
                   data-workbench-route-query="workspace"
                   href="@BuildFallbackWorkbenchHref(workbenchFallback)">Resume @workbenchFallback.Runner</a>
                <p data-workbench-recovery-workspace="true">Resume @workbenchFallback.Runner from the current table.</p>
                <nav aria-label="Recovery actions">
                    <a data-workbench-recovery-action="continue-recent" href="@BuildFallbackWorkbenchHref(workbenchFallback)">Continue @workbenchFallback.Runner</a>
                    <a data-workbench-recovery-action="build-lab" href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create")">Continue Build Lab</a>
                    <a data-workbench-recovery-action="restore-workspace" href="@BuildFallbackWorkbenchHref(workbenchFallback)">Restore @workbenchFallback.Runner</a>
                </nav>
                <section data-workbench-entry-card="restored-continuations" data-workbench-route-query="workspace">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-info")">Resume @workbenchFallback.Runner on profile</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-info", control: "identity_license_edit")">Resume @workbenchFallback.Runner on SIN/license review</a>
