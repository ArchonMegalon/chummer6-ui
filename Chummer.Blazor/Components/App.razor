    private bool TryBuildRybbitTrackEndpointFromScript(string value, out string? endpoint)
    {
        endpoint = null;
        if (!TryResolveSafeAnalyticsUri(value, out Uri? scriptUri)
            || scriptUri is null
            || !scriptUri.AbsolutePath.EndsWith(RybbitScriptSuffix, StringComparison.OrdinalIgnoreCase))
            return false;

        var builder = new UriBuilder(scriptUri)
        {
            Path = $"{scriptUri.AbsolutePath[..^RybbitScriptSuffix.Length]}/track"
        };
        endpoint = builder.Uri.ToString();
        return true;
    }

    private bool TryBuildRybbitTrackEndpointFromBase(string value, out string? endpoint)
    {
        endpoint = null;
        if (!TryResolveSafeAnalyticsUri(value, out Uri? baseUri)
            || baseUri is null)
            return false;

        var builder = new UriBuilder(baseUri)
        {
            Path = RybbitTrackPath
        };
        endpoint = builder.Uri.ToString();
        return true;
