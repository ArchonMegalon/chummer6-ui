        => BuildPublicAppHrefCore(null, workspace, tab, command, dialogAction);

    private static string BuildPublicAppHref(
        string? fixture,
        string? workspace,
        string? tab,
        string? command,
        string? dialogAction)
        => BuildPublicAppHrefCore(fixture, workspace, tab, command, dialogAction);

    private static string BuildPublicAppHrefCore(
        string? fixture,
        string? workspace,
        string? tab,
        string? command,
        string? dialogAction)
    {
        var parts = new List<string>();
        AddNonDefaultQueryPart(parts, "fixture", fixture, "blue");
        AddQueryPart(parts, "workspace", workspace);
        AddQueryPart(parts, "tab", tab);
        AddQueryPart(parts, "command", command);
        AddQueryPart(parts, "dialog_action", dialogAction);
        return parts.Count == 0
            ? "/app"
            : $"/app?{string.Join("&", parts)}";
    }

    private static string BuildFallbackActionHref(WorkbenchFallback fallback, WorkbenchFallbackAction action)
        => !string.IsNullOrWhiteSpace(action.Command)
            ? BuildPublicAppHref(fallback.Fixture, fallback.Workspace, null, action.Command, action.DialogAction)
            : BuildWorkbenchHrefCore(
                fallback.Workspace,
                fallback.Fixture,
                fallback.Runner,
                action.Tab,
                null,
                action.Control,
                action.DialogAction);

    private static string BuildFallbackActionLabel(WorkbenchFallbackAction action, string runner)
        => action.Label.Replace("BLUE", string.IsNullOrWhiteSpace(runner) ? "BLUE" : runner, StringComparison.Ordinal);

    private static void AddQueryPart(List<string> parts, string key, string? value)
    {
        string normalized = NormalizeDataToken(value);
        if (!string.IsNullOrWhiteSpace(normalized))
            parts.Add($"{key}={Uri.EscapeDataString(normalized)}");
    }

    private static void AddNonDefaultQueryPart(List<string> parts, string key, string? value, string defaultValue)
    {
        string normalized = NormalizeDataToken(value);
        if (!string.IsNullOrWhiteSpace(normalized) && !string.Equals(normalized, defaultValue, StringComparison.Ordinal))
            parts.Add($"{key}={Uri.EscapeDataString(normalized)}");
    }

    private static IReadOnlyDictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(query))
            return values;

        string trimmed = query.StartsWith("?", StringComparison.Ordinal) ? query[1..] : query;
        foreach (string part in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            string[] pair = part.Split('=', 2);
            string key = Uri.UnescapeDataString(pair[0]).Trim();
            if (string.IsNullOrWhiteSpace(key))
                continue;

            string value = pair.Length > 1 ? Uri.UnescapeDataString(pair[1]).Trim() : string.Empty;
            values[key] = value;
        }

        return values;
    }

    private static string GetQueryValue(IReadOnlyDictionary<string, string> query, string key)
        => query.TryGetValue(key, out string? value) ? value : string.Empty;

    private static string NormalizeDataToken(string? value, string fallback = "")
    {
        if (string.IsNullOrWhiteSpace(value))
            return fallback;

        string trimmed = value.Trim();
        Span<char> buffer = trimmed.Length <= 120 ? stackalloc char[trimmed.Length] : stackalloc char[120];
        int index = 0;
        foreach (char c in trimmed)
        {
            if (index >= buffer.Length)
                break;

            buffer[index++] = char.IsLetterOrDigit(c) || c is '-' or '_' or '.' ? c : '-';
        }

        return index == 0 ? fallback : new string(buffer[..index]);
    }

    private static bool IsAppRoute(string absolutePath)
    {
        if (string.IsNullOrWhiteSpace(absolutePath))
            return false;

        string normalizedPath = absolutePath.TrimEnd('/');
        if (normalizedPath.Length == 0)
            normalizedPath = "/";

        return normalizedPath.EndsWith("/app", StringComparison.OrdinalIgnoreCase)
            || normalizedPath.EndsWith("/online", StringComparison.OrdinalIgnoreCase);
    }

    private static string ResolveAppRouteSegment(string absolutePath)
    {
        string normalizedPath = string.IsNullOrWhiteSpace(absolutePath)
            ? string.Empty
            : absolutePath.TrimEnd('/');

        return normalizedPath.EndsWith("/online", StringComparison.OrdinalIgnoreCase)
            ? "online"
            : "app";
    }

    private static bool ShouldRenderAppFallbackStartupShell(IReadOnlyDictionary<string, string> query, string command)
    {
        if (!string.IsNullOrWhiteSpace(command)
            && !IsCharacterRosterCommand(command))
            return true;

        foreach (string key in AppFallbackStartupPayloadKeys)
        {
            if (!string.IsNullOrWhiteSpace(GetQueryValue(query, key)))
                return true;
        }

        return false;
    }

    private static string ResolveAppFallbackActiveWorkflow(string command, string tab)
    {
        if (IsCharacterRosterCommand(command))
            return "character-roster";
        if (string.Equals(command, "new_character_origin", StringComparison.OrdinalIgnoreCase))
            return "origin-dossier";
        if (string.Equals(command, "master_index", StringComparison.OrdinalIgnoreCase))
            return "master-index";
        if (string.Equals(command, "global_settings", StringComparison.OrdinalIgnoreCase))
            return "global-settings";
        if (string.Equals(command, "new_character", StringComparison.OrdinalIgnoreCase)
            || string.Equals(tab, "tab-create", StringComparison.OrdinalIgnoreCase))
            return "build-lab";
        if (string.Equals(command, "open_character", StringComparison.OrdinalIgnoreCase))
            return "open-dossier";
        if (string.Equals(command, "save_character", StringComparison.OrdinalIgnoreCase)
            || string.Equals(command, "save_character_as", StringComparison.OrdinalIgnoreCase))
            return "save";
        if (string.Equals(command, "print_character", StringComparison.OrdinalIgnoreCase)
            || string.Equals(command, "open_for_printing", StringComparison.OrdinalIgnoreCase))
            return "print";
        if (string.Equals(command, "export_character", StringComparison.OrdinalIgnoreCase)
            || string.Equals(command, "open_for_export", StringComparison.OrdinalIgnoreCase))
            return "export";
        if (string.Equals(tab, "tab-info", StringComparison.OrdinalIgnoreCase))
            return "profile";
        if (string.Equals(tab, "tab-rules", StringComparison.OrdinalIgnoreCase))
            return "rules";
        if (string.Equals(tab, "tab-gear", StringComparison.OrdinalIgnoreCase))
            return "gear";
        if (string.Equals(tab, "tab-combat", StringComparison.OrdinalIgnoreCase))
            return "combat";
        if (string.Equals(tab, "tab-magician", StringComparison.OrdinalIgnoreCase))
            return "magic";
        if (string.Equals(tab, "tab-technomancer", StringComparison.OrdinalIgnoreCase))
            return "matrix";
        if (string.Equals(tab, "tab-contacts", StringComparison.OrdinalIgnoreCase))
            return "contacts";
        if (string.Equals(tab, "tab-calendar", StringComparison.OrdinalIgnoreCase))
            return "career";
        if (string.IsNullOrWhiteSpace(command)
            || IsCharacterRosterCommand(command))
            return "character-roster";

        return "app-shell";
    }

