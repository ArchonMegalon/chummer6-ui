    private string? ResolveRybbitTrackEndpointUrl()
    {
        string? configuredScriptUrl = NormalizeOptionalValue(Configuration[RybbitScriptUrlConfigKey]);
        if (configuredScriptUrl is not null)
            return TryBuildRybbitTrackEndpointFromScript(configuredScriptUrl, out string? scriptEndpoint)
                ? scriptEndpoint
                : null;

        string? baseUrl = NormalizeOptionalValue(Configuration[RybbitBaseUrlConfigKey]);
        if (baseUrl is not null)
            return TryBuildRybbitTrackEndpointFromBase(baseUrl, out string? baseEndpoint)
                ? baseEndpoint
                : null;

        return RybbitDefaultTrackUrl;
