        AddQueryPart(parts, "tab", tab);
        AddQueryPart(parts, "command", command);
        AddQueryPart(parts, "control", control);
        AddQueryPart(parts, "dialog_action", dialogAction);
        return $"workbench?{string.Join("&", parts)}";
    }

