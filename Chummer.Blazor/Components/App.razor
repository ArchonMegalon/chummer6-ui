@inject NavigationManager Navigation
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f3b3e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Chummer Online" />
    <meta name="application-name" content="Chummer Online" />
    <base href="@BuildBaseHref()" />
    <title>Chummer Online</title>
    <link rel="manifest" href="@BuildStaticAssetHref("manifest.webmanifest")" />
    <link rel="icon" type="image/svg+xml" href="@BuildStaticAssetHref("icons/chummer-pwa.svg")" />
    <link rel="apple-touch-icon" href="@BuildStaticAssetHref("media/chummer6/chummer6-hero-baseline.png")" />
    <link rel="stylesheet" href="@BuildStaticAssetHref("Chummer.Blazor.styles.css")" />
    <link rel="stylesheet" href="@BuildStaticAssetHref("app.css")" />
    @if (BuildRybbitAnalyticsOptions() is { } rybbitAnalytics)
    {
        <script src="@rybbitAnalytics.ScriptUrl"
                async
                data-site-id="@rybbitAnalytics.SiteId"
                data-chummer-analytics-provider="rybbit"
                data-chummer-analytics-scope="route-workflow-metadata-only"
                data-chummer-session-replay="disabled"
                data-chummer-autocapture="disabled"></script>
    }
</head>
<body>
@if (BuildWorkbenchFallback() is { } workbenchFallback)
{
    <section id="chummer-online-app"
             class="classic-chummer-shell"
             tabindex="-1"
             aria-label="Chummer Online classic desktop shell"
             data-ssr-workbench-fallback="true"
             data-chummer-classic-shell="true"
             data-active-workflow="@workbenchFallback.ActiveWorkflow"
             data-output-workflow="@workbenchFallback.OutputWorkflow"
             data-output-state="@workbenchFallback.OutputState"
             data-output-target="@workbenchFallback.OutputTarget"
             data-route-family="@workbenchFallback.RouteFamily"
             data-route-segment="workbench"
             data-route-surface="@workbenchFallback.RouteSurface"
             data-canonical-route="workbench"
             data-route-alias="@workbenchFallback.RouteAlias"
             data-command="@workbenchFallback.Command"
             data-tab="@workbenchFallback.Tab"
             data-workspace="@workbenchFallback.Workspace"
             data-active-runner="@workbenchFallback.Runner"
             data-roster-selected-node="@workbenchFallback.SelectedRosterNode"
             data-dossier-state="@workbenchFallback.DossierState"
             data-dossier-storage="@workbenchFallback.DossierStorage"
             data-legacy-runner="@workbenchFallback.Runner"
             data-ruleset="sr5"
             data-validation-state="@workbenchFallback.ValidationState"
             data-privacy-mode="@workbenchFallback.PrivacyMode"
             data-analytics-scope="@workbenchFallback.AnalyticsScope"
             data-hosting-mode="@workbenchFallback.HostingMode"
             data-deployment-target="@workbenchFallback.DeploymentTarget"
             data-self-hostable="@workbenchFallback.SelfHostable"
             data-container-target="@workbenchFallback.ContainerTarget"
             data-auth-gate="@workbenchFallback.AuthGate"
             data-session-state="@workbenchFallback.SessionState"
             data-login-target="@workbenchFallback.LoginTarget"
             data-auth-return-policy="@workbenchFallback.AuthReturnPolicy"
             data-fixture="@workbenchFallback.Fixture"
             data-control="@workbenchFallback.Control"
             data-dialog-action="@workbenchFallback.DialogAction"
             data-client-kind="@workbenchFallback.ClientKind"
             data-parity-target="@workbenchFallback.ParityTarget"
             data-calculation-owner="@workbenchFallback.CalculationOwner"
             data-statistics-runtime="@workbenchFallback.StatisticsRuntime"
             data-character-statistics="@workbenchFallback.CharacterStatistics"
             data-statistics-scope="@workbenchFallback.StatisticsScope"
             data-recommendation-mode="@workbenchFallback.RecommendationMode"
             data-recommendation-inputs="@workbenchFallback.RecommendationInputs"
             data-risk-model="@workbenchFallback.RiskModel"
             data-calculation-boundary="@workbenchFallback.CalculationBoundary"
             data-result-consumer="@workbenchFallback.ResultConsumer">
        <header class="classic-chummer-titlebar" aria-label="Chummer Online window title">
            <div class="classic-chummer-titlebar-title">Chummer Online - @workbenchFallback.Runner - @workbenchFallback.WorkflowLabel</div>
            <div class="classic-window-controls" aria-hidden="true"><span>_</span><span>[]</span><span>X</span></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(workbenchFallback.CommittedResult))
        {
            <section class="browser-workbench-committed-result"
                     role="status"
                     aria-live="polite"
                     data-workbench-committed-result="@NormalizeDataToken(workbenchFallback.CommittedResult)">
                <strong>@workbenchFallback.CommittedResult</strong>
            </section>
        }

        <nav class="classic-chummer-menu" aria-label="Classic Chummer menu">
            <a href="@BuildFallbackWorkbenchHref(workbenchFallback, command: "new_character")">File</a>
            <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create")">Edit</a>
            <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-rules")">View</a>
            <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-technomancer", control: "complex_form_add")">Special</a>
        </nav>

        <section class="desktop-shell classic-desktop-shell"
                 data-tab="@workbenchFallback.Tab"
                 data-ruleset="sr5"
                 data-active-workflow="@workbenchFallback.ActiveWorkflow"
                 data-route-segment="workbench"
                 data-active-runner="@workbenchFallback.Runner"
                 data-legacy-runner="@workbenchFallback.Runner">
            <aside class="workspace-left-pane" aria-label="Recent work">
                <a data-workbench-recent-workspace="true"
                   data-workbench-route-query="workspace"
                   href="@BuildFallbackWorkbenchHref(workbenchFallback)">Resume @workbenchFallback.Runner</a>
                <p data-workbench-recovery-workspace="true">Resume @workbenchFallback.Runner from the current table.</p>
                <nav aria-label="Recovery actions">
                    <a data-workbench-recovery-action="continue-recent" href="@BuildFallbackWorkbenchHref(workbenchFallback)">Continue @workbenchFallback.Runner</a>
                    <a data-workbench-recovery-action="build-lab" href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-create")">Continue Build Lab</a>
                    <a data-workbench-recovery-action="restore-workspace" href="@BuildFallbackWorkbenchHref(workbenchFallback)">Restore @workbenchFallback.Runner</a>
                </nav>
                <section data-workbench-entry-card="restored-continuations" data-workbench-route-query="workspace">
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-info")">Resume @workbenchFallback.Runner on profile</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-info", control: "identity_license_edit")">Resume @workbenchFallback.Runner on SIN/license review</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-rules")">Resume @workbenchFallback.Runner on rules</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-gear")">Resume @workbenchFallback.Runner on gear</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-calendar")">Resume @workbenchFallback.Runner on career log</a>
                    <a href="@BuildFallbackWorkbenchHref(workbenchFallback, tab: "tab-technomancer")">Resume @workbenchFallback.Runner on advanced</a>
                </section>
                <section data-workbench-entry-card="restored-actions" data-workbench-route-query="workspace">
                    @foreach (WorkbenchFallbackAction action in WorkbenchFallbackActions)
                    {
                        <a href="@BuildFallbackActionHref(workbenchFallback, action)">@BuildFallbackActionLabel(action, workbenchFallback.Runner)</a>
                    }
                </section>
            </aside>

            <main class="section-preview" aria-label="@workbenchFallback.Title">
                <h2>@workbenchFallback.SectionHeading</h2>
                <p>@workbenchFallback.SectionSummary</p>
                @if (!string.IsNullOrWhiteSpace(workbenchFallback.ResultText))
                {
                    @if (!string.IsNullOrWhiteSpace(workbenchFallback.ResultRouteHref))
                    {
                        <section class="result-panel"
                                 role="status"
                                 data-result-panel-kind="@workbenchFallback.ActiveWorkflow">
                            <p>@workbenchFallback.ResultText</p>
                            <div class="shell-notice-actions">
                                <a href="@workbenchFallback.ResultRouteHref"
                                   data-result-route-link="@workbenchFallback.ActiveWorkflow">
                                    @BuildFallbackResultRouteLinkLabel(workbenchFallback.ActiveWorkflow)
                                </a>
                            </div>
                            <code class="shell-notice-code"
                                  data-result-route="@workbenchFallback.ActiveWorkflow">@workbenchFallback.ResultRouteHref</code>
                        </section>
                    }
                    else
                    {
                        <section class="result-panel" role="status">@workbenchFallback.ResultText</section>
                    }
                }
                @if (workbenchFallback.Dialog is { } dialog)
                {
                    <section class="desktop-dialog" role="dialog" aria-label="@dialog.Title" data-origin-wizard="@dialog.IsOriginWizard.ToString().ToLowerInvariant()">
                        <h2>@dialog.Title</h2>
                        @foreach (string line in dialog.Lines)
                        {
                            <p>@line</p>
                        }
                        @if (dialog.IsOriginWizard)
                        {
                            <section data-origin-wizard-details="true">
                                <h3>Advanced story controls</h3>
                                <p>Pick only the basics, then build the story. Advanced controls are optional.</p>
                                <h3>Story Preview</h3>
                            </section>
                        }
                    </section>
                }
            </main>
        </section>

        <footer class="classic-chummer-status" aria-label="Classic Chummer status">
            <span><strong>Ready</strong><em>Local</em></span>
            <span><strong>Dirty</strong><em>Unsaved dossier</em></span>
            <span><strong>Rules</strong><em>SR5</em></span>
            <span><strong>Checks</strong><em>Review required</em></span>
            <span><strong>Privacy</strong><em>Local-first</em></span>
            <span><strong>Workflow</strong><em>@workbenchFallback.WorkflowLabel</em></span>
        </footer>
    </section>
}
<Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
<script src="@BuildStaticAssetHref("_framework/blazor.web.js")"></script>
<script>
    window.chummerWorkbenchFallback = window.chummerWorkbenchFallback || {};
    window.chummerWorkbenchFallback.removeWhenInteractiveShellAppears = function() {
        const fallback = document.querySelector('[data-ssr-workbench-fallback="true"]');
        if (!fallback) {
            return;
        }

        const hasInteractiveShell = !!document.querySelector('section.classic-chummer-shell:not([data-ssr-workbench-fallback])');
        if (hasInteractiveShell) {
            fallback.remove();
        }
    };
    window.chummerWorkbenchFallback.observe = function() {
        window.chummerWorkbenchFallback.removeWhenInteractiveShellAppears();
        if (window.chummerWorkbenchFallback._observer) {
            return;
        }

        window.chummerWorkbenchFallback._observer = new MutationObserver(window.chummerWorkbenchFallback.removeWhenInteractiveShellAppears);
        window.chummerWorkbenchFallback._observer.observe(document.body, { childList: true, subtree: true });
    };
    window.chummerWorkbenchFallback.observe();

    window.chummerPwa = window.chummerPwa || {};
    (function(pwa) {
        const serviceWorkerScript = '@BuildStaticAssetHref("service-worker.js")';
        const serviceWorkerScope = '@BuildServiceWorkerScope()';
        pwa.installState = pwa.installState || 'unsupported';
        if (!('serviceWorker' in navigator)) {
            return;
        }

        pwa.installState = 'pending';
        window.addEventListener('load', function() {
            navigator.serviceWorker.register(serviceWorkerScript, { scope: serviceWorkerScope })
                .then(function(registration) {
                    pwa.installState = 'ready';
                    pwa.registrationScope = registration.scope;
                })
                .catch(function(error) {
                    pwa.installState = 'failed';
                    pwa.installError = error && error.message ? error.message : String(error || 'unknown');
                });
        }, { once: true });
    })(window.chummerPwa);
    window.chummerUtilities = window.chummerUtilities || {};
    window.chummerUtilities.decodeBase64Utf8 = function(contentBase64) {
        const binary = atob(contentBase64 || '');
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
        }

        return new TextDecoder().decode(bytes);
    };
    window.chummerDownloads = window.chummerDownloads || {};
    window.chummerDownloads.downloadBase64 = function(fileName, contentBase64, mimeType) {
        if (!contentBase64) {
            return;
        }

        const anchor = document.createElement('a');
        anchor.href = `data:${mimeType || 'application/octet-stream'};base64,${contentBase64}`;
        anchor.download = fileName || 'chummer-download.dat';
        document.body.appendChild(anchor);
        anchor.click();
        document.body.removeChild(anchor);
    };
    window.chummerExports = window.chummerExports || {};
    window.chummerExports.downloadBase64 = function(fileName, contentBase64, mimeType) {
        window.chummerDownloads.downloadBase64(fileName, contentBase64, mimeType);
    };
    window.chummerAnalytics = window.chummerAnalytics || {};
    (function(analytics) {
        const maxQueueLength = 20;
        const eventPrefix = 'chummer_';
        const browserRouteEventName = 'browser_route';
        const hostClassBlazor = 'blazor';
        const analyticsScopeRouteWorkflowMetadataOnly = 'route-workflow-metadata-only';
        const analyticsDisabledPolicy = 'disabled';
        const propertyHostClass = 'host_class';
        const propertyAnalyticsScope = 'analytics_scope';
        const propertySessionReplay = 'session_replay';
        const propertyAutocapture = 'autocapture';
        const propertyRouteFamily = 'route_family';
        const propertyCommandId = 'command_id';
        const propertyTabId = 'tab_id';
        const propertyControlId = 'control_id';
        const propertyDialogActionId = 'dialog_action_id';
        const propertyHasWorkspace = 'has_workspace';
        const propertyHasDossier = 'has_dossier';
        const propertyHasFixture = 'has_fixture';
        const queryCommand = 'command';
        const queryTab = 'tab';
        const queryControl = 'control';
        const queryDialogAction = 'dialog_action';
        const queryWorkspace = 'workspace';
        const queryFixture = 'fixture';
        const allowedPropertyKeys = new Set([
            propertyHostClass,
            propertyAnalyticsScope,
            propertySessionReplay,
            propertyAutocapture,
            propertyRouteFamily,
            propertyCommandId,
            propertyTabId,
            propertyControlId,
            propertyDialogActionId,
            propertyHasWorkspace,
            propertyHasDossier,
            propertyHasFixture
        ]);
        const forbiddenPropertyPattern = /(alias|character|content|document|dossier|email|file|hash|name|owner|payload|workspace|xml)/i;
        const safeTokenPattern = /^[a-z0-9_.:-]{1,80}$/i;
        const analyticsScope = analyticsScopeRouteWorkflowMetadataOnly;
        const sessionReplayPolicy = analyticsDisabledPolicy;
        const autocapturePolicy = analyticsDisabledPolicy;
        const routeFamilyChummerApp = 'chummer_app';
        const routeFamilyPreview = 'preview';
        const routeFamilyShowcase = 'showcase';
        const routeFamilyDownloads = 'downloads';
        const routeFamilyDocs = 'docs';
        const routeFamilyOther = 'other';
        const pathBlazor = '/blazor';
        const pathBlazorSlash = '/blazor/';
        const pathApp = '/app';
        const pathOnline = '/online';
        const pathWorkbench = '/workbench';
        const pathPreview = '/preview';
        const pathShowcase = '/showcase';
        const pathDownloads = '/downloads';
        const pathDocs = '/docs';
        let lastRouteKey = '';

        analytics._queue = analytics._queue || [];

        function safeToken(value) {
            if (typeof value !== 'string') {
                return null;
            }

            const trimmed = value.trim();
            return safeTokenPattern.test(trimmed) ? trimmed : null;
        }

        function safePropertyKey(key) {
            const normalized = String(key || '')
                .trim()
                .toLowerCase()
                .replace(/[^a-z0-9_]/g, '_')
                .slice(0, 64);

            if (!normalized) {
                return null;
            }

            if (allowedPropertyKeys.has(normalized)) {
                return normalized;
            }

            if (forbiddenPropertyPattern.test(normalized)) {
                return null;
            }

            return null;
        }

        function safePropertyValue(value) {
            if (typeof value === 'number' && Number.isFinite(value)) {
                return value;
            }

            if (typeof value === 'boolean') {
                return value;
            }

            if (typeof value === 'string') {
                const trimmed = value.trim();
                return trimmed.length <= 120 && safeTokenPattern.test(trimmed) ? trimmed : null;
            }

            return null;
        }

        function sanitizeProperties(properties) {
            const safe = {};
            const entries = Object.entries(properties || {});
            for (const [key, value] of entries) {
                const safeKey = safePropertyKey(key);
                if (!safeKey) {
                    continue;
                }

                const safeValue = safePropertyValue(value);
                if (safeValue === null) {
                    continue;
                }

                safe[safeKey] = safeValue;
            }

            return safe;
        }

        function dispatch(eventName, properties) {
            const safeEventName = safeToken(eventName);
            if (!safeEventName) {
                return;
            }

            const payload = sanitizeProperties(properties);
            if (window.rybbit && typeof window.rybbit.event === 'function') {
                window.rybbit.event(`${eventPrefix}${safeEventName}`, payload);
                return;
            }

            if (analytics._queue.length < maxQueueLength) {
                analytics._queue.push([safeEventName, payload]);
            }
        }

        function flush() {
            if (!window.rybbit || typeof window.rybbit.event !== 'function') {
                return;
            }

            const queued = analytics._queue.splice(0, analytics._queue.length);
            for (const [eventName, payload] of queued) {
                window.rybbit.event(`${eventPrefix}${eventName}`, payload);
            }
        }

        function currentRouteProperties() {
            const url = new URL(window.location.href);
            const path = url.pathname.toLowerCase();
            const query = url.searchParams;
            let routeFamily = routeFamilyOther;

            if (path.endsWith(pathBlazor) || path.endsWith(pathBlazorSlash) || path.endsWith(pathApp) || path.endsWith(pathOnline) || path.endsWith(pathWorkbench)) {
                routeFamily = routeFamilyChummerApp;
            } else if (path.endsWith(pathPreview)) {
                routeFamily = routeFamilyPreview;
            } else if (path.endsWith(pathShowcase)) {
                routeFamily = routeFamilyShowcase;
            } else if (path.includes(pathDownloads)) {
                routeFamily = routeFamilyDownloads;
            } else if (path.includes(pathDocs)) {
                routeFamily = routeFamilyDocs;
            }

            return {
                [propertyHostClass]: hostClassBlazor,
                [propertyAnalyticsScope]: analyticsScope,
                [propertySessionReplay]: sessionReplayPolicy,
                [propertyAutocapture]: autocapturePolicy,
                [propertyRouteFamily]: routeFamily,
                [propertyCommandId]: safeToken(query.get(queryCommand)),
                [propertyTabId]: safeToken(query.get(queryTab)),
                [propertyControlId]: safeToken(query.get(queryControl)),
                [propertyDialogActionId]: safeToken(query.get(queryDialogAction)),
                [propertyHasWorkspace]: query.has(queryWorkspace),
                [propertyHasDossier]: query.has(queryWorkspace),
                [propertyHasFixture]: query.has(queryFixture)
            };
        }

        function trackRoute() {
            const properties = currentRouteProperties();
            const routeKey = JSON.stringify(properties);
            if (routeKey === lastRouteKey) {
                return;
            }

            lastRouteKey = routeKey;
            dispatch(browserRouteEventName, properties);
        }

        function scheduleRouteTracking() {
            window.setTimeout(trackRoute, 0);
        }

        const originalPushState = window.history.pushState;
        const originalReplaceState = window.history.replaceState;
        window.history.pushState = function() {
            const result = originalPushState.apply(this, arguments);
            scheduleRouteTracking();
            return result;
        };
        window.history.replaceState = function() {
            const result = originalReplaceState.apply(this, arguments);
            scheduleRouteTracking();
            return result;
        };

        analytics.event = dispatch;
        analytics.trackRoute = trackRoute;
        window.addEventListener('popstate', scheduleRouteTracking);
        window.setInterval(flush, 1000);
        scheduleRouteTracking();
    })(window.chummerAnalytics);
    window.chummerDialogs = window.chummerDialogs || {};
    window.chummerDialogs._lastRevealedBackdrop = window.chummerDialogs._lastRevealedBackdrop || null;
    window.chummerDialogs._lastRevealedDialogId = window.chummerDialogs._lastRevealedDialogId || null;
    window.chummerDialogs._pendingRevealResetHandle = window.chummerDialogs._pendingRevealResetHandle || null;
    window.chummerDialogs._pendingOriginAdvancedAnchor = window.chummerDialogs._pendingOriginAdvancedAnchor || null;
    window.chummerDialogs._pendingOriginFieldAnchor = window.chummerDialogs._pendingOriginFieldAnchor || null;
    window.chummerDialogs._pendingOriginAnchorCapturedAtMs = window.chummerDialogs._pendingOriginAnchorCapturedAtMs || 0;
    window.chummerDialogs._pendingSameDialogRefreshDialogId = window.chummerDialogs._pendingSameDialogRefreshDialogId || null;
    window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs || 0;
    window.chummerDialogs._pendingDialogScrollOffset = window.chummerDialogs._pendingDialogScrollOffset || null;
    window.chummerDialogs._pendingDialogScrollRestoreVersion = window.chummerDialogs._pendingDialogScrollRestoreVersion || 0;
    window.chummerDialogs._originSameDialogAnchorGraceWindowMs = window.chummerDialogs._originSameDialogAnchorGraceWindowMs || 4000;
    window.chummerDialogs._sameDialogRefreshArmWindowMs = window.chummerDialogs._sameDialogRefreshArmWindowMs || 4000;
    window.chummerDialogs._sameDialogRefreshGraceWindowMs = window.chummerDialogs._sameDialogRefreshGraceWindowMs || 750;
    window.chummerDialogs.clearPendingOriginAnchors = function() {
        window.chummerDialogs._pendingDialogScrollRestoreVersion =
            Number(window.chummerDialogs._pendingDialogScrollRestoreVersion || 0) + 1;
        window.chummerDialogs._pendingDialogScrollOffset = null;
        window.chummerDialogs._pendingOriginAdvancedAnchor = null;
        window.chummerDialogs._pendingOriginFieldAnchor = null;
        window.chummerDialogs._pendingOriginAnchorCapturedAtMs = 0;
        window.chummerDialogs._pendingSameDialogRefreshDialogId = null;
        window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = 0;
    };
    window.chummerDialogs.armSameDialogRefresh = function(dialogId) {
        if (!dialogId) {
            window.chummerDialogs._pendingSameDialogRefreshDialogId = null;
            window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = 0;
            return;
        }

        window.chummerDialogs._pendingSameDialogRefreshDialogId = dialogId;
        window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs = Date.now();
    };
    window.chummerDialogs.hasPendingSameDialogRefresh = function(dialogId) {
        const pendingDialogId = window.chummerDialogs._pendingSameDialogRefreshDialogId;
        if (!pendingDialogId) {
            return false;
        }

        if (dialogId && pendingDialogId !== dialogId) {
            return false;
        }

        const capturedAtMs = Number(window.chummerDialogs._pendingSameDialogRefreshCapturedAtMs || 0);
        return capturedAtMs > 0
            && (Date.now() - capturedAtMs) <= window.chummerDialogs._sameDialogRefreshArmWindowMs;
    };
    window.chummerDialogs.hasPendingOriginAnchor = function(dialogId) {
        const matchesDialog = function(anchor) {
            if (!anchor) {
                return false;
            }

            if (!dialogId) {
                return true;
            }

            return !anchor.dialogId || anchor.dialogId === dialogId;
        };

        if (!matchesDialog(window.chummerDialogs._pendingOriginFieldAnchor)
            && !matchesDialog(window.chummerDialogs._pendingOriginAdvancedAnchor)) {
            return false;
        }

        const capturedAtMs = Number(window.chummerDialogs._pendingOriginAnchorCapturedAtMs || 0);
        return capturedAtMs <= 0
            || (Date.now() - capturedAtMs) <= window.chummerDialogs._originSameDialogAnchorGraceWindowMs;
    };
    window.chummerDialogs.hasPendingDialogScrollRestore = function(dialogId) {
        const pendingOffset = window.chummerDialogs._pendingDialogScrollOffset;
        if (!Array.isArray(pendingOffset) || pendingOffset.length < 2) {
            return false;
        }

        return window.chummerDialogs.hasPendingSameDialogRefresh(dialogId)
            || window.chummerDialogs.hasPendingOriginAnchor(dialogId);
    };
    window.chummerDialogs.resetRevealState = function() {
        if (window.chummerDialogs._pendingRevealResetHandle) {
            window.clearTimeout(window.chummerDialogs._pendingRevealResetHandle);
            window.chummerDialogs._pendingRevealResetHandle = null;
        }

        window.chummerDialogs._lastRevealedBackdrop = null;
        window.chummerDialogs._lastRevealedDialogId = null;
        window.chummerDialogs.clearPendingOriginAnchors();
    };
    window.chummerDialogs.scheduleRevealReset = function() {
        if (window.chummerDialogs._pendingRevealResetHandle) {
            return;
        }

        window.chummerDialogs._pendingRevealResetHandle = window.setTimeout(() => {
            window.chummerDialogs._pendingRevealResetHandle = null;
