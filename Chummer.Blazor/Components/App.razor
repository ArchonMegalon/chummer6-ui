@code {
    private string BuildBaseHref()
    {
        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? uri))
            return "/";

        if (string.IsNullOrWhiteSpace(uri.AbsolutePath) || string.Equals(uri.AbsolutePath, "/", StringComparison.Ordinal))
            return "/";

        if (uri.AbsolutePath.EndsWith("/", StringComparison.Ordinal))
            return uri.AbsolutePath;

        return $"{uri.AbsolutePath}/";
    }

    private RybbitAnalyticsOptions? BuildRybbitAnalyticsOptions()
    {
        if (!string.Equals(Configuration[AnalyticsProviderConfigKey], RybbitAnalyticsProvider, StringComparison.OrdinalIgnoreCase))
            return null;

        string? siteId = NormalizeAnalyticsToken(Configuration[RybbitSiteIdConfigKey]);
        if (siteId is null)
            return null;

        string scriptUrl = ResolveRybbitScriptUrl();
        return new RybbitAnalyticsOptions(scriptUrl, siteId);
    }

    private string ResolveRybbitScriptUrl()
    {
        string? configuredScriptUrl = NormalizeOptionalValue(Configuration[RybbitScriptUrlConfigKey]);
        if (configuredScriptUrl is not null && IsSafeScriptUrl(configuredScriptUrl))
            return configuredScriptUrl;

        string? baseUrl = NormalizeOptionalValue(Configuration[RybbitBaseUrlConfigKey]);
        if (baseUrl is not null && Uri.TryCreate(baseUrl, UriKind.Absolute, out Uri? uri))
        {
            return new Uri(uri, RybbitScriptPath).ToString();
        }

        return RybbitDefaultScriptUrl;
    }

    private static bool IsSafeScriptUrl(string value)
        => value.StartsWith("/", StringComparison.Ordinal)
            || (Uri.TryCreate(value, UriKind.Absolute, out Uri? uri)
                && (string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)));

    private static string? NormalizeAnalyticsToken(string? value)
    {
        string? normalized = NormalizeOptionalValue(value);
        if (normalized is null)
            return null;

        foreach (char c in normalized)
        {
            if (!char.IsLetterOrDigit(c) && c is not '-' and not '_')
                return null;
        }

        return normalized.Length <= 128 ? normalized : null;
    }

    private static string? NormalizeOptionalValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private const string AnalyticsProviderConfigKey = "CHUMMER_ANALYTICS_PROVIDER";
    private const string RybbitAnalyticsProvider = "rybbit";
    private const string RybbitSiteIdConfigKey = "CHUMMER_RYBBIT_SITE_ID";
    private const string RybbitScriptUrlConfigKey = "CHUMMER_RYBBIT_SCRIPT_URL";
    private const string RybbitBaseUrlConfigKey = "CHUMMER_RYBBIT_BASE_URL";
    private const string RybbitScriptPath = "/api/script.js";
    private const string RybbitDefaultScriptUrl = "https://app.rybbit.io/api/script.js";

    private sealed record RybbitAnalyticsOptions(string ScriptUrl, string SiteId);
}
