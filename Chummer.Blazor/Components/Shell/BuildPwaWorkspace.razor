    private long _integrityRetryOwner;
    private ExternalWorkspaceRevision? _externalRevision;
    private ElementReference _integrityAlert;
    private bool _focusIntegrityAlert;
    private bool _updateDeferred;
    private string? _integrityNotice;
    private string? _publishedWorkspaceId;
    private long _publishedContentRevision;
    private long _publishedSavedRevision;
    private long? _recoveryCopyPreparedGeneration;
    private WorkspaceRecoveryCopyAvailability? _activeRecoveryReadiness;
    private readonly CancellationTokenSource _componentLifetime = new();
    private bool _disposed;

    private const long MaxJavaScriptSafeInteger = 9_007_199_254_740_991L;
    private static readonly TimeSpan IntegrityInteropDeadline = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan IntegrityTeardownDeadline = TimeSpan.FromSeconds(1);

    private static readonly HashSet<string> AllowedExternalMutationKinds = new(StringComparer.Ordinal)
    {
        "workspace-update",
        "checkpoint",
        "delete"
    };

    public sealed record BuildPwaIntegritySnapshot(
        string? WorkspaceId,
        long ContentRevision,
        long SavedRevision,
        bool IsDirty,
        bool HasConflict,
        bool UpdateDeferred,
        bool BridgeAvailable);

    private bool HasValidatedRecoveryCopy
        => _externalRevision?.IsDeleted == true
            && _externalRevision.Recovery is { Available: true } recovery
            && recovery.SourceRevision == State.ContentRevision
            && recovery.LocalGeneration > 0;

    private bool RecoveryExportPrepared
        => HasValidatedRecoveryCopy
            && _externalRevision?.Recovery is { ExportPrepared: true } recovery
            && _recoveryCopyPreparedGeneration == recovery.LocalGeneration;

    private bool RecoveryExportConfirmed
        => HasValidatedRecoveryCopy
            && _externalRevision?.Recovery is { ExportConfirmed: true };

    private bool RecoveryAwaitingExplicitUserAck
        => HasValidatedRecoveryCopy
            && _externalRevision?.Recovery is { AwaitingExplicitUserAck: true };

    private string RecoveryUnavailableReason
        => _externalRevision?.Recovery?.UnavailableReason
            ?? "Recovery capacity or canonical validation is not ready.";

    private sealed record ExternalWorkspaceRevision(
        string WorkspaceId,
        long Revision,
        bool IsDeleted,
        WorkspaceRecoveryCopyAvailability? Recovery);

    private int StepCount => NavigationTabs.Count;

    private int ActiveTabIndex
    {
        get
        {
            for (int index = 0; index < NavigationTabs.Count; index++)
            {
                if (string.Equals(NavigationTabs[index].Id, ActiveTabId, StringComparison.Ordinal))
                    return index;
            }

            return -1;
        }
    }

    private int CurrentStepNumber => ActiveTabIndex >= 0 ? ActiveTabIndex + 1 : 1;

    private string CurrentSectionLabel => ActiveTabIndex >= 0
        ? FormatNavigationTabLabel(NavigationTabs[ActiveTabIndex])
        : "Choose a section";

    private string CurrentStepText => StepCount == 0
        ? "No builder sections available"
        : $"Section {CurrentStepNumber} of {StepCount}: {CurrentSectionLabel}";

    private string BuilderTitle => State.Profile?.Alias
        ?? State.Profile?.Name
        ?? "Runner workspace";

    private string WorkspaceStatusText => State.IsBusy
        ? "Updating"
        : !string.IsNullOrWhiteSpace(ShellSurface.Error) || !string.IsNullOrWhiteSpace(State.Error)
            ? "Needs attention"
            : State.ActiveBuildLab is { CanContinue: false }
                ? "Continue the intake"
                : "Ready for edits";

    private string RuntimeStatusText => !string.IsNullOrWhiteSpace(ShellSurface.Error) || !string.IsNullOrWhiteSpace(State.Error)
        ? "Unavailable"
        : State.IsBusy
            ? "Updating"
            : "Available";

    private NavigationTabDefinition? PreviousTab => FindEnabledTab(-1);

    private NavigationTabDefinition? NextTab => FindEnabledTab(1);

    private NavigationTabDefinition? FindEnabledTab(int direction)
    {
        if (ActiveTabIndex < 0)
            return null;

        for (int index = ActiveTabIndex + direction;
             index >= 0 && index < NavigationTabs.Count;
             index += direction)
        {
            NavigationTabDefinition tab = NavigationTabs[index];
            if (IsNavigationTabEnabled(tab))
                return tab;
        }

        return null;
    }

    private Task SelectPreviousTabAsync()
        => PreviousTab is { } tab
            ? SelectTabRequested.InvokeAsync(tab.Id)
            : Task.CompletedTask;

    private Task SelectNextTabAsync()
        => NextTab is { } tab
            ? SelectTabRequested.InvokeAsync(tab.Id)
            : Task.CompletedTask;

    private string BuildNavigationTabsHeading()
        => RulesetUiDirectiveCatalog.BuildNavigationTabsHeading(ResolveActiveRulesetId());

    private string BuildSectionActionsHeading()
        => RulesetUiDirectiveCatalog.BuildSectionActionsHeading(ResolveActiveRulesetId());

    private string BuildWorkflowSurfacesHeading()
        => RulesetUiDirectiveCatalog.BuildWorkflowSurfacesHeading(ResolveActiveRulesetId());

    private string FormatNavigationTabLabel(NavigationTabDefinition tab)
        => RulesetUiDirectiveCatalog.FormatNavigationTabLabel(tab.RulesetId, tab.Id, tab.Label);

    private string FormatWorkspaceActionLabel(WorkspaceSurfaceActionDefinition action)
        => RulesetUiDirectiveCatalog.FormatWorkspaceActionLabel(action.RulesetId, action.Id, action.TargetId, action.Label);

    private string FormatWorkflowSurfaceLabel(WorkflowSurfaceActionBinding surface)
        => RulesetUiDirectiveCatalog.FormatWorkflowSurfaceLabel(ResolveActiveRulesetId(), surface.ActionId, surface.Label);

    private string BuildStepAriaLabel(NavigationTabDefinition tab, int index)
        => $"Section {index + 1} of {StepCount}: {FormatNavigationTabLabel(tab)}";

    private string? ResolveActiveRulesetId()
    {
        string? workspaceRulesetId = OpenWorkspaces
            .FirstOrDefault(workspace => string.Equals(workspace.Id.Value, ActiveWorkspaceId?.Value, StringComparison.Ordinal))
            ?.RulesetId;
        return RulesetDefaults.NormalizeOptional(NavigationTabs.FirstOrDefault()?.RulesetId)
            ?? RulesetDefaults.NormalizeOptional(ActiveWorkspaceActions.FirstOrDefault()?.RulesetId)
            ?? RulesetDefaults.NormalizeOptional(workspaceRulesetId)
            ?? RulesetDefaults.NormalizeOptional(OpenWorkspaces.FirstOrDefault()?.RulesetId);
    }
