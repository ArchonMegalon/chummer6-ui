@namespace Chummer.Blazor.Components.Shell
@using Chummer.Contracts.Workspaces
@using Chummer.Presentation.UiKit
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<div class="status-strip classic-status-strip"
     role="@AccessibilityPrimitiveBoundary.StatusRegionRole"
     aria-live="@AccessibilityPrimitiveBoundary.PoliteAnnouncementMode"
     aria-atomic="true"
     aria-label="@BuildStatusAnnouncement()">
    <span id="routeState" data-status-route-family="@BuildRouteFamily()">Route: @BuildRouteLabel()</span>
    <span id="charState">Runner: @(WorkspaceId is null ? "none" : "loaded")</span>
    <span id="serviceState">Service: @(string.IsNullOrWhiteSpace(Error) ? "online" : "error")</span>
    <span id="timeState">Time: @LastUiUtc</span>
    <span id="complianceState">@ComplianceState</span>
</div>

@code {
    [Parameter]
    public CharacterWorkspaceId? WorkspaceId { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string LastUiUtc { get; set; } = string.Empty;

    [Parameter]
    public string ComplianceState { get; set; } = "Ruleset: unresolved | Workflows: 0 defs / 0 surfaces | Prefs: 100%/classic/en-us";

    private string BuildStatusAnnouncement()
    {
        return AccessibilityPrimitiveBoundary.BuildStatusAnnouncement(
            characterState: $"Route: {BuildRouteLabel()} | Runner: {(WorkspaceId is null ? "none" : "loaded")}",
            serviceState: $"Service: {(string.IsNullOrWhiteSpace(Error) ? "online" : "error")}",
            timeState: $"Time: {LastUiUtc}",
            complianceState: ComplianceState);
    }

    private string BuildRouteLabel()
    {
        return BuildRouteFamily() switch
        {
            ChummerAppRouteFamily => "Chummer Online",
            HomeRouteFamily => "Chummer Online overview",
            PreviewRouteFamily => "Preview/support tools",
            WorkbenchCompatibilityRouteFamily => "Chummer Online compatibility",
            _ => "Browser client"
        };
    }

    private string BuildRouteFamily()
    {
        string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (path.EndsWith(AppPathSuffix, StringComparison.Ordinal))
            return ChummerAppRouteFamily;
        if (path.EndsWith(HomePathSuffix, StringComparison.Ordinal))
            return HomeRouteFamily;
        if (path.EndsWith(PreviewPathSuffix, StringComparison.Ordinal))
            return PreviewRouteFamily;
        if (path.EndsWith(WorkbenchPathSuffix, StringComparison.Ordinal))
            return WorkbenchCompatibilityRouteFamily;
        if (path.EndsWith(BlazorPathSuffix, StringComparison.Ordinal) || path.Length == 0)
            return ChummerAppRouteFamily;
        return BrowserClientRouteFamily;
    }

    private const string ChummerAppRouteFamily = "chummer_app";
    private const string HomeRouteFamily = "home";
    private const string PreviewRouteFamily = "preview";
    private const string WorkbenchCompatibilityRouteFamily = "workbench_compat";
    private const string BrowserClientRouteFamily = "browser_client";
    private const string AppPathSuffix = "/app";
    private const string HomePathSuffix = "/home";
    private const string PreviewPathSuffix = "/preview";
    private const string WorkbenchPathSuffix = "/workbench";
    private const string BlazorPathSuffix = "/blazor";

}
