@namespace Chummer.Blazor.Components.Shell
@using Chummer.Contracts.Workspaces
@using Chummer.Presentation.UiKit
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<div class="status-strip classic-status-strip"
     role="@AccessibilityPrimitiveBoundary.StatusRegionRole"
     aria-live="@AccessibilityPrimitiveBoundary.PoliteAnnouncementMode"
     aria-atomic="true"
     aria-label="@BuildStatusAnnouncement()">
    <span id="routeState" data-status-route-family="@BuildRouteFamily()">Route: @BuildRouteLabel()</span>
    <span id="charState">Character: @(WorkspaceId is null ? "none" : "loaded")</span>
    <span id="serviceState">Service: @(string.IsNullOrWhiteSpace(Error) ? "online" : "error")</span>
    <span id="timeState">Time: @LastUiUtc</span>
    <span id="complianceState">@ComplianceState</span>
</div>

@code {
    [Parameter]
    public CharacterWorkspaceId? WorkspaceId { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string LastUiUtc { get; set; } = string.Empty;

    [Parameter]
    public string ComplianceState { get; set; } = "Ruleset: unresolved | Workflows: 0 defs / 0 surfaces | Prefs: 100%/classic/en-us";

    private string BuildStatusAnnouncement()
    {
        return AccessibilityPrimitiveBoundary.BuildStatusAnnouncement(
            characterState: $"Route: {BuildRouteLabel()} | Character: {(WorkspaceId is null ? "none" : "loaded")}",
            serviceState: $"Service: {(string.IsNullOrWhiteSpace(Error) ? "online" : "error")}",
            timeState: $"Time: {LastUiUtc}",
            complianceState: ComplianceState);
    }

    private string BuildRouteLabel()
    {
        return BuildRouteFamily() switch
        {
            "chummer_app" => "Chummer Online",
            "home" => "Home",
            "preview" => "Preview tools",
            "workbench_compat" => "Chummer Online compatibility",
            _ => "Browser client"
        };
    }

    private string BuildRouteFamily()
    {
        string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (path.EndsWith("/app", StringComparison.Ordinal))
            return "chummer_app";
        if (path.EndsWith("/home", StringComparison.Ordinal))
            return "home";
        if (path.EndsWith("/preview", StringComparison.Ordinal))
            return "preview";
        if (path.EndsWith("/workbench", StringComparison.Ordinal))
            return "workbench_compat";
        if (path.EndsWith("/blazor", StringComparison.Ordinal) || path.Length == 0)
            return "chummer_app";
        return "browser_client";
    }

}
