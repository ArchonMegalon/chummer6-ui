@namespace Chummer.Blazor.Components.Shell
@using Chummer.Presentation.Rulesets
@using Chummer.Presentation
@using Chummer.Contracts.Workspaces

<section class="panel results" data-result-panel>
    <h2>@BuildResultHeading()</h2>
    <p class="hint">@BuildResultPostureHint()</p>
    <p class="note" data-result-notice>@(State.Notice ?? BuildResultReadyNotice())</p>
    @if (string.Equals(State.LastCommandId, SaveCharacterCommandId, StringComparison.Ordinal) && State.HasSavedWorkspace)
    {
        <aside class="trust-receipt" data-result-dispatch="save">
            <strong>Saved in this browser</strong>
            <p class="hint"><strong>Runner:</strong> @(State.WorkspaceId?.Value ?? "none")</p>
            <p class="hint"><strong>Status:</strong> This runner is saved and ready to reopen.</p>
            <p class="hint"><strong>Command:</strong> @State.LastCommandId</p>
        </aside>
    }
    @if (State.PendingDownload is { } pendingDownload)
    {
        <aside class="trust-receipt" data-result-dispatch="download">
            <strong>Download ready</strong>
            <p class="hint"><strong>File:</strong> @pendingDownload.FileName</p>
            <p class="hint"><strong>Format:</strong> @pendingDownload.Format</p>
            <p class="hint"><strong>Length:</strong> @pendingDownload.DocumentLength bytes</p>
        </aside>
    }
    @if (State.PendingPrint is { } pendingPrint)
    {
        <aside class="trust-receipt" data-result-dispatch="print">
            <strong>Print file ready</strong>
            <p class="hint"><strong>Title:</strong> @pendingPrint.Title</p>
            <p class="hint"><strong>File:</strong> @pendingPrint.FileName</p>
            <p class="hint"><strong>Type:</strong> @pendingPrint.MimeType</p>
            <p class="hint"><strong>Length:</strong> @pendingPrint.DocumentLength bytes</p>
        </aside>
    }
    @if (State.PendingExport is { } pendingExport)
    {
        <aside class="trust-receipt" data-result-dispatch="export">
            <strong>Export ready</strong>
            <p class="hint"><strong>File:</strong> @pendingExport.FileName</p>
            <p class="hint"><strong>Format:</strong> @pendingExport.Format</p>
            <p class="hint"><strong>Length:</strong> @pendingExport.DocumentLength bytes</p>
        </aside>
    }
    @if (State.LatestPortabilityActivity is { } portability)
    {
        <p class="hint"><strong>@UndetectableHumanizerCopyAdapter.Humanize(portability.Title):</strong> @UndetectableHumanizerCopyAdapter.Humanize(portability.Receipt.ReceiptSummary)</p>
        <p class="hint"><strong>Next step:</strong> @UndetectableHumanizerCopyAdapter.Humanize(portability.Receipt.NextSafeAction)</p>
        @if (BuildImportWarning(portability.Receipt) is { } importWarning)
        {
            <p class="result-portability-warning" role="status"><strong>Warning:</strong> @importWarning</p>
        }
        <details class="result-portability-details" data-result-trust-receipt>
            <summary>Import details</summary>
            <dl class="facts compact">
                <div><dt>Format</dt><dd>@BuildImportFormatLabel(portability.Receipt.FormatId)</dd></div>
                <div><dt>Compatibility</dt><dd>@HumanizeReceiptToken(portability.Receipt.CompatibilityState)</dd></div>
                @if (portability.Receipt.SupportedExchangeModes.Count > 0)
                {
                    <div><dt>Available actions</dt><dd>@string.Join(", ", portability.Receipt.SupportedExchangeModes.Select(HumanizeReceiptToken))</dd></div>
                }
                <div><dt>Reference</dt><dd class="mono">@BuildImportReceiptCorrelationKey(portability.Receipt)</dd></div>
                @if (!string.IsNullOrWhiteSpace(portability.Receipt.ProvenanceSummary))
                {
                    <div><dt>Provenance</dt><dd>@UndetectableHumanizerCopyAdapter.Humanize(portability.Receipt.ProvenanceSummary)</dd></div>
                }
            </dl>
            @if (BuildInformationalImportNotes(portability.Receipt) is { Count: > 0 } informationalNotes)
            {
                <p class="hint"><strong>Notes:</strong> @string.Join(" ", informationalNotes)</p>
            }
        </details>
    }
    @if (!string.IsNullOrWhiteSpace(State.Error))
    {
        <p class="error">Error: @State.Error</p>
    }
</section>

@code {
    private const string SaveCharacterCommandId = "save_character";

    [Parameter]
    public string? RulesetId { get; set; }

    [Parameter]
    public CharacterOverviewState State { get; set; } = CharacterOverviewState.Empty;

    private string BuildResultHeading()
        => RulesetUiDirectiveCatalog.BuildResultHeading(RulesetId);

    private string BuildResultPostureHint()
        => RulesetUiDirectiveCatalog.BuildResultPostureHint(RulesetId);

    private string BuildResultReadyNotice()
        => RulesetUiDirectiveCatalog.BuildResultReadyNotice(RulesetId);

    private static string BuildImportReceiptCorrelationKey(WorkspacePortabilityReceipt receipt)
    {
        string payload = string.IsNullOrWhiteSpace(receipt.PayloadSha256)
            ? "no-payload-hash"
            : receipt.PayloadSha256.Trim();
        return $"import/{receipt.FormatId}/{receipt.CompatibilityState}/{payload}";
    }

    private static string? BuildImportWarning(WorkspacePortabilityReceipt receipt)
    {
        WorkspacePortabilityNote? blocker = receipt.Notes
            .FirstOrDefault(note => !string.Equals(note.Severity, WorkspacePortabilityNoteSeverities.Info, StringComparison.OrdinalIgnoreCase));
        if (blocker is not null && !string.IsNullOrWhiteSpace(blocker.Summary))
        {
            return UndetectableHumanizerCopyAdapter.Humanize(blocker.Summary);
        }

        return string.Equals(receipt.CompatibilityState, WorkspacePortabilityCompatibilityStates.Compatible, StringComparison.OrdinalIgnoreCase)
            ? null
            : $"Review required: {HumanizeReceiptToken(receipt.CompatibilityState)}.";
    }

    private static IReadOnlyList<string> BuildInformationalImportNotes(WorkspacePortabilityReceipt receipt)
        => receipt.Notes
            .Where(note => string.Equals(note.Severity, WorkspacePortabilityNoteSeverities.Info, StringComparison.OrdinalIgnoreCase))
            .Select(note => UndetectableHumanizerCopyAdapter.Humanize(note.Summary))
            .Where(static summary => !string.IsNullOrWhiteSpace(summary))
            .Take(2)
            .ToArray();

    private static string BuildImportFormatLabel(string? formatId)
        => formatId switch
        {
            WorkspacePortabilityFormatIds.NativeWorkspaceXmlV1 => "Native XML workspace",
            WorkspacePortabilityFormatIds.PortableDossierV1 => "Portable dossier",
            _ => HumanizeReceiptToken(formatId)
        };

    private static string HumanizeReceiptToken(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Unknown";
        }

        string normalized = value.Trim().Replace('-', ' ').Replace('_', ' ').Replace('.', ' ');
        return string.Concat(char.ToUpperInvariant(normalized[0]), normalized.Substring(1));
    }
}
