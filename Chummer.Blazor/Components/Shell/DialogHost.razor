@namespace Chummer.Blazor.Components.Shell
@using System.Globalization
@using System.IO
@using Chummer.Presentation.UiKit
@using Chummer.Presentation.Overview
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@* m104: blazor_dialog_surface *@
@if (GetRenderedDialog() is { } dialog)
{
    <div id="dialogBackdrop"
         class="dialog-backdrop"
         data-dialog-id="@dialog.Id"
         @onclick="CloseAsync">
        <div class="desktop-dialog classic-dialog"
             @ref="_dialogRoot"
             role="@AccessibilityPrimitiveBoundary.DialogRole"
             aria-modal="true"
             aria-labelledby="dialogTitle"
             aria-describedby="@AccessibilityPrimitiveBoundary.BuildDialogDescriptionId(dialog.Id)"
             tabindex="-1"
             @onclick:stopPropagation="true">
            <div class="dialog-titlebar classic-dialog-titlebar">
                <span id="dialogTitle">@dialog.Title</span>
                <button id="dialogClose"
                        class="dialog-close classic-dialog-close"
                        type="button"
                        title="Close dialog"
                        aria-label="Close dialog"
                        aria-description="Close the current dialog."
                        @onclick="CloseAsync">X</button>
            </div>
            <div id="@AccessibilityPrimitiveBoundary.BuildDialogDescriptionId(dialog.Id)"
                 class="dialog-body classic-dialog-grid"
                 @ref="_dialogBody">
                @if (!string.IsNullOrWhiteSpace(dialog.Message))
                {
                    <p class="dialog-note">@dialog.Message</p>
                }
                @if (IsPriorityWorkflowDialog(dialog))
                {
                    PriorityWorkflowDialogRuntimeState priorityRuntimeState = GetPriorityRuntimeState(dialog);
                    <div class="dialog-priority-workflow" data-priority-workflow>
                        <section class="dialog-priority-panel dialog-priority-panel--allocation">
                            <header>
                                <h3>Priority Allocation</h3>
                                <p>Assign the five lanes, then follow through on metatype and talent-dependent choices.</p>
                            </header>
                            <div class="dialog-priority-matrix">
                                @RenderPriorityMatrixField(dialog, "newCharacterPriorityHeritage")
                                @RenderPriorityMatrixField(dialog, "newCharacterPriorityAttributes")
                                @RenderPriorityMatrixField(dialog, "newCharacterPriorityTalent")
                                @RenderPriorityMatrixField(dialog, "newCharacterPrioritySkills")
                                @RenderPriorityMatrixField(dialog, "newCharacterPriorityResources")
                                @RenderPriorityMatrixField(dialog, "newCharacterPriorityTalentChoice")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(priorityRuntimeState.SumToTenLabel))
                            {
                                <p class="dialog-priority-callout" data-priority-sum-to-ten>@priorityRuntimeState.SumToTenLabel</p>
                            }
                        </section>

                        <div class="dialog-priority-center">
                            <section class="dialog-priority-panel" data-priority-browse-lane>
                                <header>
                                    <h3>Browse Metatypes</h3>
                                    <p>Filter the catalog first, then choose the exact metatype from the browser list.</p>
                                </header>
                                <div class="dialog-priority-browse">
                                    @RenderPriorityStackedField(dialog, "newCharacterMetatypeCategory")
                                    @RenderPrioritySelectField(dialog, "newCharacterMetatype", size: 12, cssClass: "dialog-input dialog-input--list dialog-priority-listbox")
                                </div>
                            </section>

                            <section class="dialog-priority-panel" data-priority-detail-lane>
                                <header>
                                    <h3>Selection Detail</h3>
                                    <p>Review karma, special attributes, source, and inherited qualities before confirming.</p>
                                </header>
                                <div class="dialog-priority-detail-grid">
                                    @RenderPrioritySelectField(
                                        GetPriorityMetavariantField(dialog, priorityRuntimeState),
                                        cssClass: "dialog-input dialog-priority-select",
                                        labelOverride: "Metavariant")
                                    @RenderPriorityFact("Karma", priorityRuntimeState.MetatypeKarma)
                                    @RenderPriorityFact("Special Attributes", priorityRuntimeState.SpecialAttributes)
                                    @RenderPriorityFact("Source", priorityRuntimeState.Source)
                                    @if (priorityRuntimeState.ForceVisible)
                                    {
                                        @RenderPriorityFact("Force", priorityRuntimeState.Force.ToString())
                                    }
                                    @if (priorityRuntimeState.PossessionVisible)
                                    {
                                        @RenderPriorityFact("Possession", priorityRuntimeState.PossessionBased ? "Possession-based" : "No possession")
                                    }
                                </div>
                                @if (priorityRuntimeState.InspectAttributes.Count > 0)
                                {
                                    <span class="dialog-label" data-priority-attributes-heading>Natural Ranges</span>
                                    <div class="dialog-priority-attributes" data-priority-attributes>
                                        @foreach (PriorityWorkflowInspectAttributeState inspectAttribute in priorityRuntimeState.InspectAttributes)
                                        {
                                            <div class="dialog-priority-attribute">
                                                <span class="dialog-priority-attribute-label">@inspectAttribute.Label</span>
                                                <span class="dialog-priority-attribute-value">@inspectAttribute.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="dialog-priority-qualities">
                                    <span class="dialog-label">Qualities</span>
                                    <ul data-priority-qualities>
                                        @if (priorityRuntimeState.Qualities.Count == 0)
                                        {
                                            <li>No innate qualities</li>
                                        }
                                        else
                                        {
                                            @foreach (string quality in priorityRuntimeState.Qualities)
                                            {
                                                <li>@quality</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </section>
                        </div>

                        @if (HasPrioritySkillChoiceFields(priorityRuntimeState))
                        {
                            <section class="dialog-priority-panel" data-priority-skill-choices>
                                <header>
                                    <h3>Choice Follow-Through</h3>
                                    <p>Complete the skill choices unlocked by the selected priorities.</p>
                                </header>
                                <div class="dialog-priority-skill-choices">
                                    @if (!string.IsNullOrWhiteSpace(priorityRuntimeState.SkillSelectionLabel))
                                    {
                                        <p class="dialog-priority-callout">@priorityRuntimeState.SkillSelectionLabel</p>
                                    }
                                    @if (priorityRuntimeState.SkillChoice1.Visible)
                                    {
                                        @RenderPrioritySelectField(GetPrioritySkillChoiceField(dialog, "newCharacterPrioritySkillChoice1", "Skill Choice 1", priorityRuntimeState.SkillChoice1))
                                    }
                                    @if (priorityRuntimeState.SkillChoice2.Visible)
                                    {
                                        @RenderPrioritySelectField(GetPrioritySkillChoiceField(dialog, "newCharacterPrioritySkillChoice2", "Skill Choice 2", priorityRuntimeState.SkillChoice2))
                                    }
                                    @if (priorityRuntimeState.SkillChoice3.Visible)
                                    {
                                        @RenderPrioritySelectField(GetPrioritySkillChoiceField(dialog, "newCharacterPrioritySkillChoice3", "Skill Choice 3", priorityRuntimeState.SkillChoice3))
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
                else if (IsOriginWizardDialog(dialog))
                {
                    <div class="dialog-origin-shell" data-origin-wizard>
                        <section class="dialog-origin-panel">
                            <header>
                                <h3>Story</h3>
                                <p>Pick only the basics, then build the story. Advanced controls are optional.</p>
                            </header>
                            <div class="dialog-origin-story-grid">
                                @RenderOriginField(dialog, "newCharacterOriginMetatypePreference")
                                @RenderOriginField(dialog, "newCharacterOriginArchetypeIntent")
                            </div>
                            <div class="dialog-origin-summary-strip" data-origin-summary-strip>
                                @RenderOriginSummaryMetric("Metatype", GetDialogFieldValue(dialog, "newCharacterOriginMetatype"))
                                @RenderOriginSummaryMetric("Archetype", GetDialogFieldValue(dialog, "newCharacterOriginArchetype"))
                                @RenderOriginSummaryMetric("Path", GetDialogFieldValue(dialog, "newCharacterOriginPathSummary"))
                            </div>
                        </section>

                        <section class="dialog-origin-panel dialog-origin-panel--advanced"
                                 data-origin-advanced-controls
                                 data-expanded="@(CurrentOriginWizardAdvancedControlsOpen ? "true" : "false")">
                            <button type="button"
                                    class="dialog-origin-advanced-toggle"
                                    data-origin-advanced-toggle
                                    aria-expanded="@(CurrentOriginWizardAdvancedControlsOpen ? "true" : "false")"
                                    aria-controls="origin-wizard-advanced-story-controls"
                                    @onclick="ToggleOriginWizardAdvancedControls">
                                Advanced story controls
                            </button>
                            <div id="origin-wizard-advanced-story-controls"
                                 class="dialog-origin-advanced-content"
                                 data-origin-advanced-content
                                 hidden="@(!CurrentOriginWizardAdvancedControlsOpen)">
                                <p class="dialog-note">Optional runner identity, life-path steering, and GM guidance for the story packet.</p>
                                <div class="dialog-origin-advanced-grid">
                                    <section class="dialog-origin-subpanel">
                                        <h4>Runner</h4>
                                        <div class="dialog-origin-story-grid">
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterName"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterAlias"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterRulesetId"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginBuildPreference"))
                                        </div>
                                    </section>

                                    <section class="dialog-origin-subpanel">
                                        <h4>Life Path</h4>
                                        <div class="dialog-origin-life-grid">
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginBackground"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginTurningPoint"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginTrainingPath"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginUpgradeExposure"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginPressureCost"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginMotivation"))
                                            @RenderOriginField(GetDialogField(dialog, "newCharacterOriginTone"))
                                        </div>
                                    </section>
                                </div>

                                <section class="dialog-origin-subpanel">
                                    <h4>GM Steering</h4>
                                    <div class="dialog-origin-story-grid">
                                        @RenderOriginField(GetDialogField(dialog, "newCharacterOriginGmConstraintPreset"))
                                        @RenderOriginField(GetDialogField(dialog, "newCharacterOriginGmRequirements"))
                                    </div>
                                    <div class="dialog-origin-summary-strip">
                                        @RenderOriginSummaryMetric("Applied GM Constraint", GetDialogFieldValue(dialog, "newCharacterOriginGmRequirementSummary"))
                                        @RenderOriginSummaryMetric("Pressure", GetDialogFieldValue(dialog, "newCharacterOriginQualityFocus"))
                                    </div>
                                </section>
                            </div>
                        </section>

                        <section class="dialog-origin-panel">
                            <header>
                                <h3>Story Preview</h3>
                                <p>Review the story seed first. Mechanics can follow after the story is accepted.</p>
                            </header>
                            <div class="dialog-origin-preview" data-origin-story-preview>
                                @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginSummary"))
                            </div>
                        </section>
                    </div>
                }
                else if (IsOriginBuildDialog(dialog))
                {
                    <div class="dialog-origin-shell" data-origin-build>
                        <section class="dialog-origin-panel">
                            <header>
                                <h3>Build Handoff</h3>
                            </header>
                            <div class="dialog-origin-summary-strip">
                                @RenderOriginSummaryMetric("Runner", GetDialogFieldValue(dialog, "newCharacterWorkflowAlias"))
                                @RenderOriginSummaryMetric("Ruleset", (GetDialogFieldValue(dialog, "newCharacterWorkflowRulesetId") ?? string.Empty).ToUpperInvariant())
                                @RenderOriginSummaryMetric("Method", GetDialogFieldValue(dialog, "newCharacterWorkflowBuildMethod"))
                            </div>
                        </section>

                        <section class="dialog-origin-panel" data-origin-dossier-link>
                            <header>
                                <h3>Origin Dossier Link</h3>
                                <p>Use this route to reopen the Origin Dossier workflow without publishing the story text.</p>
                            </header>
                            <div class="dialog-origin-story-grid">
                                @RenderOriginField(GetDialogField(dialog, "newCharacterOriginDossierLink"))
                            </div>
                            <div class="dialog-origin-preview">
                                @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginDossierLinkNotes"))
                            </div>
                        </section>

                        <div class="dialog-origin-review-grid">
                            <section class="dialog-origin-panel">
                                <header>
                                    <h3>Book Preview</h3>
                                    <p>Read this first. Character creation starts after the story feels right.</p>
                                </header>
                                <div class="dialog-origin-preview dialog-origin-preview--book" data-origin-book-preview>
                                    @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginBookPreview"))
                                </div>
                            </section>

                            <section class="dialog-origin-panel">
                                <header>
                                    <h3>Story</h3>
                                    <p>Alice can use this text later; it does not change the sheet by itself.</p>
                                </header>
                                <div class="dialog-origin-preview">
                                    @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginStory"))
                                </div>
                            </section>

                            <div class="dialog-origin-support-grid" data-origin-build-support>
                                <section class="dialog-origin-panel">
                                    <header>
                                        <h3>Build Translation</h3>
                                        <p>The handoff translates the story into a normal guided character-creation path.</p>
                                    </header>
                                    <div class="dialog-origin-preview">
                                        @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginBuildLogic"))
                                    </div>
                                </section>
                                <section class="dialog-origin-panel">
                                    <header>
                                        <h3>Constraints</h3>
                                        <p>GM grants and requirements stay visible before opening chargen.</p>
                                    </header>
                                    <div class="dialog-origin-preview">
                                        @RenderOriginReadonlyField(GetDialogField(dialog, "newCharacterOriginImplications"))
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (DesktopDialogField field in GetVisibleDialogFields(dialog))
                    {
                        <label class="dialog-field classic-dialog-field @(string.Equals(field.InputType, "checkbox", StringComparison.Ordinal) ? "dialog-field--checkbox" : string.Empty) @(BuildDialogFieldLayoutClass(field)) @(BuildDialogFieldVisualClass(field))"
                               title="@field.ToolTip"
                               data-field-id="@field.Id"
                               data-roster-hierarchy-field="@IsRosterHierarchyField(field)">
                            @if (string.Equals(field.InputType, "checkbox", StringComparison.Ordinal))
                            {
                                <input type="checkbox"
                                       aria-label="@field.AccessibleName"
                                       aria-description="@field.HelpText"
                                       checked="@IsDialogCheckboxChecked(field)"
                                       disabled="@field.IsReadOnly"
                                       @onchange="e => OnDialogCheckboxChangedAsync(field, e.Value)" />
                                <span class="dialog-label">@field.Label</span>
                            }
                            else if (field.IsMultiline)
                            {
                                <span class="dialog-label">@field.Label</span>
                                @if (field.IsReadOnly && !string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Default, StringComparison.Ordinal))
                                {
                                    <div class="@BuildDialogVisualClass(field)"
                                         aria-label="@field.AccessibleName"
                                         aria-description="@field.HelpText"
                                         data-field-id="@field.Id"
                                         data-roster-hierarchy-field="@IsRosterHierarchyField(field)">
                                        @if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Tabs, StringComparison.Ordinal))
                                        {
                                            @foreach (string item in SplitVisualLines(field.Value))
                                            {
                                                <span class="dialog-tab-chip">@item</span>
                                            }
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Image, StringComparison.Ordinal))
                                        {
                                            string? imageDataUri = TryBuildImageDataUri(field.Value);
                                            string imageTitle = SplitVisualLines(field.Value).FirstOrDefault() ?? "Mugshot Preview";
                                            <div class="dialog-image-placeholder">
                                                <div class="dialog-image-box">
                                                    @if (!string.IsNullOrWhiteSpace(imageDataUri))
                                                    {
                                                        <img class="dialog-image-preview" src="@imageDataUri" alt="@imageTitle" />
                                                    }
                                                    else
                                                    {
                                                        @imageTitle
                                                    }
                                                </div>
                                                @foreach (string item in SplitVisualLines(field.Value).Skip(1))
                                                {
                                                    <div>@item</div>
                                                }
                                            </div>
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Grid, StringComparison.Ordinal))
                                        {
                                            <div class="dialog-grid">
                                                @foreach ((string key, string value) in SplitGridRows(field.Value))
                                                {
                                                    <div class="dialog-grid-row">
                                                        <span class="dialog-grid-key">@key</span>
                                                        <span class="dialog-grid-value">@value</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Snippet, StringComparison.Ordinal))
                                        {
                                            <div class="dialog-snippet">@field.Value</div>
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Narrative, StringComparison.Ordinal))
                                        {
                                            @RenderNarrativeParagraphs(field.Value, "dialog-narrative")
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Tree, StringComparison.Ordinal))
                                        {
                                            @if (IsRosterHierarchyField(field))
                                            {
                                                <div class="dialog-roster-toolbar"
                                                     data-roster-hierarchy-toolbar="@field.Id">
                                                    <div>
                                                        <strong>@BuildRosterHierarchyToolbarTitle(field)</strong>
                                                        <p>@BuildRosterHierarchyToolbarSummary(field)</p>
                                                    </div>
                                                    <span class="dialog-roster-mode" data-roster-hierarchy-mode="@RosterActiveSourceMode">
                                                        @(string.IsNullOrWhiteSpace(RosterActiveSourceLine) ? "Ready to organize" : "Move pending")
                                                    </span>
                                                </div>
                                            }
                                            <div class="dialog-roster-tree"
                                                 role="@BuildRosterHierarchyContainerRole(field)"
                                                 aria-label="@BuildRosterHierarchyContainerLabel(field)"
                                                 aria-orientation="@BuildRosterHierarchyContainerOrientation(field)"
                                                 data-roster-drag-root="@IsRosterHierarchyField(field)">
                                                @if (IsRosterKeyboardStatusHost(field))
                                                {
                                                    <div id="@RosterKeyboardHintId" class="dialog-roster-keyboard-hint" role="note">Keyboard: Enter or Space selects a source row, Enter or Space on a directory drops it, Escape clears the source.</div>
                                                }
                                                @if (IsRosterKeyboardStatusHost(field) && !string.IsNullOrWhiteSpace(RosterActiveSourceLine))
                                                {
                                                    <div id="@RosterKeyboardStatusId" class="dialog-roster-keyboard-status" role="status" aria-live="polite" aria-atomic="true">@BuildRosterKeyboardStatus()</div>
                                                }
                                                @foreach (string item in SplitVisualLines(field.Value))
                                                {
                                                    <div class="@BuildRosterHierarchyLineClass(field, item)"
                                                         draggable="@IsRosterDraggableLine(field, item)"
                                                         title="@BuildRosterHierarchyLineTitle(field, item)"
                                                         aria-label="@BuildRosterHierarchyLineTitle(field, item)"
                                                         aria-describedby="@BuildRosterHierarchyLineDescriptionId(field, item)"
                                                         role="@BuildRosterHierarchyLineRole(field, item)"
                                                         aria-level="@BuildRosterHierarchyLineLevel(field, item)"
                                                         aria-selected="@BuildRosterHierarchyLineSelected(field, item)"
                                                         aria-expanded="@BuildRosterHierarchyLineExpanded(field, item)"
                                                         aria-keyshortcuts="@BuildRosterHierarchyLineKeyShortcuts(field, item)"
                                                         tabindex="@BuildRosterHierarchyLineTabIndex(field, item)"
                                                         @ondragstart="() => StartRosterDrag(field, item)"
                                                         @ondragend="ClearRosterDragSource"
                                                         @ondragover:preventDefault="@IsRosterDropTargetLine(field, item)"
                                                         @ondrop="() => DropRosterLineAsync(field, item)"
                                                         @onkeydown="args => HandleRosterLineKeyDownAsync(field, item, args)"
                                                         data-roster-line-kind="@BuildRosterHierarchyLineKind(field, item)"
                                                         data-roster-folder-scope="@BuildRosterHierarchyFolderScope(field, item)"
                                                         data-roster-source-item="@BuildRosterHierarchySourceItem(field, item)"
                                                         data-roster-drop-action="@BuildRosterHierarchyDropAction(field, item)"
                                                         data-roster-accepts-drop-kinds="@BuildRosterHierarchyAcceptedDropKinds(field, item)"
                                                         data-roster-tree-line="@item">
                                                        @item
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.List, StringComparison.Ordinal))
                                        {
                                            <div class="dialog-roster-list" data-roster-guide="@IsRosterHierarchyField(field)">
                                                @foreach (string item in SplitVisualLines(field.Value))
                                                {
                                                    <div class="@BuildRosterHierarchyLineClass(field, item)"
                                                         data-roster-line-kind="@BuildRosterHierarchyLineKind(field, item)"
                                                         data-roster-folder-scope="@BuildRosterHierarchyFolderScope(field, item)"
                                                         data-roster-source-item="@BuildRosterHierarchySourceItem(field, item)"
                                                         data-roster-drop-action="@BuildRosterHierarchyDropAction(field, item)"
                                                         data-roster-accepts-drop-kinds="@BuildRosterHierarchyAcceptedDropKinds(field, item)"
                                                         data-roster-list-line="@item">@item</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <pre class="dialog-visual-pre">@field.Value</pre>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <textarea class="@BuildDialogInputClass(field)"
                                              aria-label="@field.AccessibleName"
                                              aria-description="@field.HelpText"
                                              value="@field.Value"
                                              placeholder="@field.Placeholder"
                                              readonly="@field.IsReadOnly"
                                              @oninput="e => OnDialogFieldInputAsync(field, e.Value?.ToString())"></textarea>
                                }
                            }
                            else if (string.Equals(field.InputType, "select", StringComparison.Ordinal))
                            {
                                <span class="dialog-label">@field.Label</span>
                                <select class="@BuildDialogInputClass(field)"
                                        data-field-id="@field.Id"
                                        aria-label="@field.AccessibleName"
                                        aria-description="@field.HelpText"
                                        disabled="@field.IsReadOnly"
                                        value="@field.Value"
                                        @onfocus="(_) => PrepareDialogFieldInteractionAsync(field)"
                                        @onpointerdown="(_) => PrepareDialogFieldInteractionAsync(field)"
                                        @onchange="e => OnDialogFieldInputAsync(field, e.Value?.ToString())">
                                    @foreach (DesktopDialogFieldOption option in field.Options ?? [])
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="dialog-label">@field.Label</span>
                                <input class="@BuildDialogInputClass(field)"
                                       aria-label="@field.AccessibleName"
                                       aria-description="@field.HelpText"
                                       type="@field.InputType"
                                       value="@field.Value"
                                       placeholder="@field.Placeholder"
                                       readonly="@field.IsReadOnly"
                                       @oninput="e => OnDialogFieldInputAsync(field, e.Value?.ToString())" />
                            }
                        </label>
                    }
                }
            </div>
            @{
                IReadOnlyList<DialogTrustReceiptSection> trustSections = BuildDialogTrustReceiptSections(dialog);
                bool renderFallbackTrustReceipt = trustSections.Count == 0 && LooksLikeTrustDialog(dialog);
            }
            @if (trustSections.Count > 0 || renderFallbackTrustReceipt)
            {
                string trustReceipt = DialogTrustReceiptText.BuildDialogReceipt(dialog);
                @* m104: blazor_dialog_surface *@
                <aside class="dialog-trust-receipt" data-dialog-trust-receipt data-dialog-explain-receipt>
                    <strong>Explanation and environment details</strong>
                    <p class="dialog-note">@(renderFallbackTrustReceipt ? BuildFallbackDialogTrustReceipt(dialog) : trustReceipt)</p>
                    <dl class="facts compact">
                        <div><dt>Before</dt><dd>@(renderFallbackTrustReceipt ? ReadDialogTrustField(dialog, "before") : DialogTrustReceiptText.BuildDialogBefore(dialog))</dd></div>
                        <div><dt>Explanation</dt><dd>@(renderFallbackTrustReceipt ? ReadDialogTrustField(dialog, "receipt") : DialogTrustReceiptText.BuildDialogExplainReceipt(dialog))</dd></div>
                        <div><dt>Support reuse</dt><dd>@(renderFallbackTrustReceipt ? ReadDialogTrustField(dialog, "support") : DialogTrustReceiptText.BuildDialogSupportReuse(dialog))</dd></div>
                    </dl>
                    @foreach (DialogTrustReceiptSection receiptSection in trustSections)
                    {
                        <section class="dialog-trust-receipt-section">
                            <h4>@receiptSection.Title</h4>
                            <ul>
                                @foreach (string line in receiptSection.Lines)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </section>
                    }
                </aside>
            }
            <div id="dialogFooter" class="dialog-footer classic-dialog-footer">
                @foreach (DesktopDialogAction action in dialog.Actions)
                {
                    <button class="action-btn classic-dialog-action @(action.IsPrimary ? "primary" : string.Empty)"
                            type="button"
                            title="@action.ToolTip"
                            aria-label="@action.AccessibleName"
                            aria-description="@action.HelpText"
                            disabled="@IsDialogActionDisabled(dialog, action)"
                            @onclick="() => ExecuteDialogActionAsync(action.Id)">
                        @action.Label
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public DesktopDialogState? Dialog { get; set; }

    [Parameter]
    public EventCallback CloseRequested { get; set; }

    [Parameter]
    public EventCallback<string> ExecuteDialogActionRequested { get; set; }

    [Parameter]
    public EventCallback<DialogFieldInputChange> FieldInputRequested { get; set; }

    [Parameter]
    public EventCallback<DialogFieldCheckboxChange> FieldCheckboxRequested { get; set; }

    [Parameter]
    public EventCallback<DialogRosterDropIntent> RosterDropRequested { get; set; }

    [Parameter]
    public bool OriginWizardAdvancedControlsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OriginWizardAdvancedControlsOpenChanged { get; set; }

    private string? _rosterMouseDragSourceLine;
    private string? _rosterKeyboardSourceLine;
    private bool _originWizardAdvancedControlsOpen;
    private bool _preserveOriginWizardAdvancedControlsAcrossTransientNull;
    private bool _renderOriginWizardTransientFallback;
    private DesktopDialogState? _cachedOriginWizardDialog;

    private ElementReference _dialogRoot;
    private ElementReference _dialogBody;
    private string? _focusedDialogId;
    private string? _lastDialogId;
    private double[]? _pendingDialogScrollRestore;
    private string? _pendingDialogScrollDialogId;
    private DesktopDialogState? _scrollRestoreSourceDialog;
    private string? _armedDialogScrollFieldId;
    private string? _armedDialogScrollDialogId;
    private bool _pendingDialogScrollRestoreRequested;
    private bool IsOriginWizardAdvancedControlsOpenBound => OriginWizardAdvancedControlsOpenChanged.HasDelegate;
    private bool CurrentOriginWizardAdvancedControlsOpen =>
        OriginWizardAdvancedControlsOpen || _originWizardAdvancedControlsOpen;

    private bool ShouldPreserveLocalOriginWizardAdvancedControlsOpenOnBoundRefresh()
    {
        if (OriginWizardAdvancedControlsOpen || !_originWizardAdvancedControlsOpen)
        {
            return false;
        }

        if (Dialog is not null)
        {
            return IsOriginWizardDialog(Dialog);
        }

        return _renderOriginWizardTransientFallback
            || (_cachedOriginWizardDialog is not null && IsOriginWizardDialog(_cachedOriginWizardDialog));
    }

    protected override void OnParametersSet()
    {
        if (IsOriginWizardAdvancedControlsOpenBound)
        {
            if (!ShouldPreserveLocalOriginWizardAdvancedControlsOpenOnBoundRefresh())
            {
                _originWizardAdvancedControlsOpen = OriginWizardAdvancedControlsOpen;
            }
        }

        if (Dialog is null)
        {
            if ((_preserveOriginWizardAdvancedControlsAcrossTransientNull || CurrentOriginWizardAdvancedControlsOpen)
                && _cachedOriginWizardDialog is not null
                && IsOriginWizardDialog(_cachedOriginWizardDialog))
            {
                _renderOriginWizardTransientFallback = true;
                _preserveOriginWizardAdvancedControlsAcrossTransientNull = false;
                return;
            }

            _renderOriginWizardTransientFallback = false;
            _cachedOriginWizardDialog = null;

            if (!_preserveOriginWizardAdvancedControlsAcrossTransientNull)
            {
                _lastDialogId = null;
                SyncOriginWizardAdvancedControlsOpen(false);
                ClearPendingDialogScrollRestore();
            }

            return;
        }

        _renderOriginWizardTransientFallback = false;
        _preserveOriginWizardAdvancedControlsAcrossTransientNull = false;
        _cachedOriginWizardDialog = IsOriginWizardDialog(Dialog) ? Dialog : null;

        if (!string.Equals(Dialog.Id, _lastDialogId, StringComparison.Ordinal))
        {
            _lastDialogId = Dialog.Id;
            if (!IsOriginWizardDialog(Dialog) || !CurrentOriginWizardAdvancedControlsOpen)
            {
                SyncOriginWizardAdvancedControlsOpen(false);
            }
        }

        if (!string.Equals(Dialog.Id, _pendingDialogScrollDialogId, StringComparison.Ordinal))
        {
            ClearPendingDialogScrollRestore();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        DesktopDialogState? renderedDialog = GetRenderedDialog();
        if (renderedDialog is null)
        {
            return;
        }

        bool restoredPendingScroll = await RestorePendingDialogScrollAsync(renderedDialog);
        if (!restoredPendingScroll)
        {
            await RestorePendingDialogScrollAcrossRemountAsync(renderedDialog);
        }

        if (Dialog is null || string.Equals(_focusedDialogId, renderedDialog.Id, StringComparison.Ordinal))
            return;

        bool sameDialogRefresh = await JsRuntime.InvokeAsync<bool>(
            "chummerDialogs.isSameDialogRefresh",
            renderedDialog.Id);
        _focusedDialogId = renderedDialog.Id;
        if (sameDialogRefresh)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("chummerDialogs.revealActiveDialog");
        await _dialogRoot.FocusAsync();
    }

    private Task CloseAsync()
    {
        return CloseRequested.InvokeAsync();
    }

    private Task ExecuteDialogActionAsync(string actionId)
    {
        return ExecuteDialogActionRequested.InvokeAsync(actionId);
    }

    private async Task ToggleOriginWizardAdvancedControls()
    {
        bool nextIsOpen = !CurrentOriginWizardAdvancedControlsOpen;
        await SetOriginWizardAdvancedControlsOpenAsync(nextIsOpen);
        if (nextIsOpen)
        {
            RememberOriginWizardTransientState();
            return;
        }

        _preserveOriginWizardAdvancedControlsAcrossTransientNull = false;
    }

    private async Task PrepareDialogFieldInteractionAsync(DesktopDialogField field)
    {
        if (field.IsReadOnly)
            return;

        if (!ShouldPreservePendingOriginWizardSelectScrollCapture(field))
        {
            await CaptureDialogScrollForFieldInteractionAsync(field.Id);
        }

        RememberOriginWizardTransientState();
    }

    private async Task OnDialogFieldInputAsync(DesktopDialogField field, string? value)
    {
        if (field.IsReadOnly)
            return;

        bool preservePendingOriginWizardSelectScrollCapture =
            ShouldPreservePendingOriginWizardSelectScrollCapture(field);
        bool shouldRefreshScrollCaptureForCurrentInput =
            string.Equals(field.InputType, "select", StringComparison.Ordinal);
        if (!preservePendingOriginWizardSelectScrollCapture
            && (shouldRefreshScrollCaptureForCurrentInput
            || !IsDialogScrollCaptureArmedForField(field.Id)))
        {
            await CaptureDialogScrollForFieldInteractionAsync(field.Id);
        }

        RememberOriginWizardTransientState();
        ArmPendingDialogScrollRestoreRequest();
        await FieldInputRequested.InvokeAsync(new DialogFieldInputChange(field.Id, value));
    }

    private async Task OnDialogCheckboxChangedAsync(DesktopDialogField field, object? value)
    {
        if (field.IsReadOnly)
            return;

        bool parsed = value is bool direct
            ? direct
            : bool.TryParse(value?.ToString(), out bool parsedBool) && parsedBool;
        await CaptureDialogScrollForFieldInteractionAsync(field.Id);
        RememberOriginWizardTransientState();
        ArmPendingDialogScrollRestoreRequest();
        await FieldCheckboxRequested.InvokeAsync(new DialogFieldCheckboxChange(field.Id, parsed));
    }

    private void SyncOriginWizardAdvancedControlsOpen(bool isOpen)
    {
        _originWizardAdvancedControlsOpen = isOpen;
    }

    private async Task SetOriginWizardAdvancedControlsOpenAsync(bool isOpen)
    {
        SyncOriginWizardAdvancedControlsOpen(isOpen);
        if (IsOriginWizardAdvancedControlsOpenBound && OriginWizardAdvancedControlsOpen != isOpen)
        {
            await OriginWizardAdvancedControlsOpenChanged.InvokeAsync(isOpen);
        }
    }

    private void RememberOriginWizardTransientState()
    {
        if (Dialog is not null && IsOriginWizardDialog(Dialog))
        {
            _cachedOriginWizardDialog = Dialog;
            _preserveOriginWizardAdvancedControlsAcrossTransientNull = true;
        }
    }

    private DesktopDialogState? GetRenderedDialog()
        => Dialog ?? (_renderOriginWizardTransientFallback ? _cachedOriginWizardDialog : null);

    private bool ShouldPreservePendingOriginWizardSelectScrollCapture(DesktopDialogField field)
    {
        if (!string.Equals(field.InputType, "select", StringComparison.Ordinal))
        {
            return false;
        }

        DesktopDialogState? renderedDialog = GetRenderedDialog();
        return renderedDialog is not null
            && IsOriginWizardDialog(renderedDialog)
            && CurrentOriginWizardAdvancedControlsOpen
            && _pendingDialogScrollRestore is { Length: >= 2 }
            && string.Equals(renderedDialog.Id, _pendingDialogScrollDialogId, StringComparison.Ordinal);
    }

    private bool IsDialogScrollCaptureArmedForField(string fieldId)
    {
        DesktopDialogState? renderedDialog = GetRenderedDialog();
        return renderedDialog is not null
            && _pendingDialogScrollRestore is { Length: >= 2 }
            && string.Equals(renderedDialog.Id, _armedDialogScrollDialogId, StringComparison.Ordinal)
            && string.Equals(fieldId, _armedDialogScrollFieldId, StringComparison.Ordinal);
    }

    private async Task CaptureDialogScrollForFieldInteractionAsync(string fieldId)
    {
        DesktopDialogState? renderedDialog = GetRenderedDialog();
        if (renderedDialog is null)
        {
            ClearPendingDialogScrollRestore();
            return;
        }

        double[]? scrollOffset = await JsRuntime.InvokeAsync<double[]?>(
            "chummerDialogs.captureDialogScroll",
            _dialogBody,
            fieldId);

        if (scrollOffset is not { Length: >= 2 })
        {
            ClearPendingDialogScrollRestore();
            return;
        }

        _pendingDialogScrollRestore = scrollOffset;
        _pendingDialogScrollDialogId = renderedDialog.Id;
        _scrollRestoreSourceDialog = Dialog ?? renderedDialog;
        _armedDialogScrollFieldId = fieldId;
        _armedDialogScrollDialogId = renderedDialog.Id;
    }

    private void ArmPendingDialogScrollRestoreRequest()
    {
        DesktopDialogState? renderedDialog = GetRenderedDialog();
        _pendingDialogScrollRestoreRequested = renderedDialog is not null
            && _pendingDialogScrollRestore is { Length: >= 2 }
            && string.Equals(renderedDialog.Id, _pendingDialogScrollDialogId, StringComparison.Ordinal);
    }

    private async Task<bool> RestorePendingDialogScrollAsync(DesktopDialogState renderedDialog)
    {
        if (!_pendingDialogScrollRestoreRequested
            || _pendingDialogScrollRestore is not { Length: >= 2 } scrollOffset
            || !string.Equals(renderedDialog.Id, _pendingDialogScrollDialogId, StringComparison.Ordinal))
        {
            return false;
        }

        // Clear the component-local pending state before awaiting JS so overlapping
        // rerenders in the same refresh cycle cannot replay an older restore payload.
        ClearPendingDialogScrollRestore();

        await JsRuntime.InvokeVoidAsync(
            "chummerDialogs.restoreDialogScroll",
            _dialogBody,
            scrollOffset);

        return true;
    }

    private async Task RestorePendingDialogScrollAcrossRemountAsync(DesktopDialogState renderedDialog)
    {
        await JsRuntime.InvokeAsync<bool>(
            "chummerDialogs.restorePendingDialogScroll",
            _dialogBody,
            renderedDialog.Id);
    }

    private void ClearPendingDialogScrollRestore()
    {
        _pendingDialogScrollRestore = null;
        _pendingDialogScrollDialogId = null;
        _scrollRestoreSourceDialog = null;
        _armedDialogScrollFieldId = null;
        _armedDialogScrollDialogId = null;
        _pendingDialogScrollRestoreRequested = false;
    }

    private static bool IsDialogCheckboxChecked(DesktopDialogField field)
    {
        if (bool.TryParse(field.Value, out bool value))
            return value;

        return string.Equals(field.Value, "1", StringComparison.Ordinal)
            || string.Equals(field.Value, "on", StringComparison.OrdinalIgnoreCase)
            || string.Equals(field.Value, "yes", StringComparison.OrdinalIgnoreCase);
    }

    private static IReadOnlyList<DialogTrustReceiptSection> BuildDialogTrustReceiptSections(DesktopDialogState dialog)
        => DialogTrustReceiptText.BuildDialogReceiptSections(dialog);

    private static bool LooksLikeTrustDialog(DesktopDialogState dialog)
        => dialog.Fields.Any(static field =>
            string.Equals(field.Id, "before", StringComparison.Ordinal)
            || string.Equals(field.Id, "after", StringComparison.Ordinal)
            || string.Equals(field.Id, "receipt", StringComparison.Ordinal)
            || string.Equals(field.Id, "support", StringComparison.Ordinal));

    private static string ReadDialogTrustField(DesktopDialogState dialog, string fieldId)
        => dialog.Fields.FirstOrDefault(field => string.Equals(field.Id, fieldId, StringComparison.Ordinal))?.Value
            ?? string.Empty;

    private static string BuildFallbackDialogTrustReceipt(DesktopDialogState dialog)
    {
        string environment = ReadDialogTrustField(dialog, "environment");
        string before = ReadDialogTrustField(dialog, "before");
        string after = ReadDialogTrustField(dialog, "after");
        string receipt = ReadDialogTrustField(dialog, "receipt");
        string support = ReadDialogTrustField(dialog, "support");
        return string.Join(" ", new[] { environment, before, after, receipt, support }.Where(static value => !string.IsNullOrWhiteSpace(value)));
    }

    private static bool IsPriorityWorkflowDialog(DesktopDialogState dialog)
        => string.Equals(dialog.Id, "dialog.new_character.priority_workflow", StringComparison.Ordinal);

    private static bool IsOriginWizardDialog(DesktopDialogState dialog)
        => string.Equals(dialog.Id, "dialog.new_character.origin_wizard", StringComparison.Ordinal);

    private static bool IsOriginBuildDialog(DesktopDialogState dialog)
        => string.Equals(dialog.Id, "dialog.new_character.origin_build", StringComparison.Ordinal);

    private static IEnumerable<DesktopDialogField> GetVisibleDialogFields(DesktopDialogState dialog)
        => dialog.Fields.Where(field => !string.Equals(field.LayoutSlot, DesktopDialogFieldLayoutSlots.Hidden, StringComparison.Ordinal));

    private static DesktopDialogField GetDialogField(DesktopDialogState dialog, string fieldId)
        => dialog.Fields.First(field => string.Equals(field.Id, fieldId, StringComparison.Ordinal));

    private static string GetDialogFieldValue(DesktopDialogState dialog, string fieldId)
        => dialog.Fields.FirstOrDefault(field => string.Equals(field.Id, fieldId, StringComparison.Ordinal))?.Value ?? string.Empty;

    private static bool IsDialogActionDisabled(DesktopDialogState dialog, DesktopDialogAction action)
    {
        if (!IsPriorityWorkflowDialog(dialog)
            || !string.Equals(action.Id, "complete_new_character_workflow", StringComparison.Ordinal))
        {
            return false;
        }

        return !GetPriorityCanCommit(dialog);
    }

    private static bool GetPriorityCanCommit(DesktopDialogState dialog)
    {
        DesktopDialogField? canCommitField = dialog.Fields.FirstOrDefault(field =>
            string.Equals(field.Id, "newCharacterPriorityWorkflowCanCommit", StringComparison.Ordinal));

        return canCommitField is null || IsDialogCheckboxChecked(canCommitField);
    }

    private static PriorityWorkflowDialogRuntimeState GetPriorityRuntimeState(DesktopDialogState dialog)
        => PriorityWorkflowDialogRuntimeStateSerializer.Parse(
            dialog.Fields.FirstOrDefault(field => string.Equals(field.Id, "newCharacterPriorityWorkflowState", StringComparison.Ordinal))?.Value);

    private static bool HasPrioritySkillChoiceFields(PriorityWorkflowDialogRuntimeState runtimeState)
        => runtimeState.SkillChoice1.Visible || runtimeState.SkillChoice2.Visible || runtimeState.SkillChoice3.Visible;

    private static DesktopDialogField FindRequiredDialogField(DesktopDialogState dialog, string fieldId)
        => dialog.Fields.First(field => string.Equals(field.Id, fieldId, StringComparison.Ordinal));

    private static DesktopDialogField GetPriorityMetavariantField(
        DesktopDialogState dialog,
        PriorityWorkflowDialogRuntimeState runtimeState)
        => dialog.Fields.FirstOrDefault(field => string.Equals(field.Id, "newCharacterMetavariant", StringComparison.Ordinal))
            ?? new DesktopDialogField(
                "newCharacterMetavariant",
                "Metavariant",
                runtimeState.SelectedMetavariant,
                runtimeState.SelectedMetavariant,
                InputType: "select",
                Options: runtimeState.MetavariantOptions);

    private static DesktopDialogField GetPrioritySkillChoiceField(
        DesktopDialogState dialog,
        string fieldId,
        string label,
        PriorityWorkflowChoiceState choiceState)
        => dialog.Fields.FirstOrDefault(field => string.Equals(field.Id, fieldId, StringComparison.Ordinal))
            ?? new DesktopDialogField(
                fieldId,
                label,
                choiceState.Value,
                choiceState.Value,
                InputType: "select",
                Options: choiceState.Options);

    private static string BuildDialogFieldLayoutClass(DesktopDialogField field)
    {
        return field.LayoutSlot switch
        {
            DesktopDialogFieldLayoutSlots.Left => "dialog-field--left",
            DesktopDialogFieldLayoutSlots.Right => "dialog-field--right",
            _ => "dialog-field--full"
        };
    }

    private static string BuildDialogFieldVisualClass(DesktopDialogField field)
    {
        string visualClass = field.VisualKind switch
        {
            DesktopDialogFieldVisualKinds.List => "dialog-field--list",
            DesktopDialogFieldVisualKinds.Tree => "dialog-field--tree",
            DesktopDialogFieldVisualKinds.Grid => "dialog-field--grid",
            DesktopDialogFieldVisualKinds.Detail => "dialog-field--detail",
            DesktopDialogFieldVisualKinds.Summary => "dialog-field--summary",
            DesktopDialogFieldVisualKinds.Snippet => "dialog-field--snippet",
            DesktopDialogFieldVisualKinds.Narrative => "dialog-field--narrative",
            DesktopDialogFieldVisualKinds.Tabs => "dialog-field--tabs",
            DesktopDialogFieldVisualKinds.Image => "dialog-field--image",
            _ => string.Empty
        };

        return IsRosterHierarchyField(field)
            ? string.Join(" ", new[] { visualClass, "dialog-field--roster-hierarchy" }.Where(static item => !string.IsNullOrWhiteSpace(item)))
            : visualClass;
    }

    private static string BuildDialogInputClass(DesktopDialogField field)
    {
        return field.VisualKind switch
        {
            DesktopDialogFieldVisualKinds.List => "dialog-input dialog-input--list",
            DesktopDialogFieldVisualKinds.Tree => "dialog-input dialog-input--tree",
            DesktopDialogFieldVisualKinds.Grid => "dialog-input dialog-input--grid",
            DesktopDialogFieldVisualKinds.Detail => "dialog-input dialog-input--detail",
            DesktopDialogFieldVisualKinds.Summary => "dialog-input dialog-input--summary",
            DesktopDialogFieldVisualKinds.Snippet => "dialog-input dialog-input--snippet",
            DesktopDialogFieldVisualKinds.Narrative => "dialog-input dialog-input--summary",
            _ => "dialog-input"
        };
    }

    private static string BuildDialogVisualClass(DesktopDialogField field)
    {
        string visualClass = field.VisualKind switch
        {
            DesktopDialogFieldVisualKinds.Tabs => "dialog-visual dialog-visual--tabs",
            DesktopDialogFieldVisualKinds.Image => "dialog-visual dialog-visual--image",
            DesktopDialogFieldVisualKinds.Tree => "dialog-visual dialog-visual--tree",
            DesktopDialogFieldVisualKinds.Grid => "dialog-visual dialog-visual--grid",
            DesktopDialogFieldVisualKinds.List => "dialog-visual dialog-visual--list",
            DesktopDialogFieldVisualKinds.Snippet => "dialog-visual dialog-visual--snippet",
            DesktopDialogFieldVisualKinds.Narrative => "dialog-visual dialog-visual--narrative",
            _ => "dialog-visual"
        };

        return IsRosterHierarchyField(field)
            ? $"{visualClass} dialog-visual--roster-hierarchy"
            : visualClass;
    }


    private const string RosterFieldPrefix = "roster";
    private const string RosterTreeFieldId = "rosterTree";
    private const string RosterCustomFoldersFieldId = "rosterCustomFolders";
    private const string RosterMoveTargetsFieldId = "rosterMoveTargets";
    private const string RosterDragDropGuideFieldId = "rosterDragDropGuide";
    private const string RosterHierarchyPolicyFieldId = "rosterHierarchyPolicy";
    private const string RosterHierarchyStatusFieldId = "rosterHierarchyStatus";
    private const string RosterSystemFolderScope = "system";
    private const string RosterCustomFolderScope = "custom";
    private const string RosterNoFolderScope = "none";
    private const string RosterFolderScopeSeparator = " · ";
    private const string RosterMoveRunnerToGroupCommand = "move_runner_to_group";
    private const string RosterReorderTreeCommand = "reorder_roster_tree";
    private static readonly string RosterSystemFolderMarker = $"{RosterFolderScopeSeparator}{RosterSystemFolderScope}";
    private static readonly string RosterCustomFolderMarker = $"{RosterFolderScopeSeparator}{RosterCustomFolderScope}";

    private static bool IsRosterHierarchyField(DesktopDialogField field)
        => field.Id.StartsWith(RosterFieldPrefix, StringComparison.Ordinal)
            && (string.Equals(field.Id, RosterTreeFieldId, StringComparison.Ordinal)
                || string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
                || string.Equals(field.Id, RosterMoveTargetsFieldId, StringComparison.Ordinal)
                || string.Equals(field.Id, RosterDragDropGuideFieldId, StringComparison.Ordinal)
                || string.Equals(field.Id, RosterHierarchyPolicyFieldId, StringComparison.Ordinal)
                || string.Equals(field.Id, RosterHierarchyStatusFieldId, StringComparison.Ordinal));

    private static bool IsRosterDraggableLine(DesktopDialogField field, string line)
        => IsRosterHierarchyField(field)
            && !string.IsNullOrWhiteSpace(line)
            && !line.TrimStart().StartsWith("[", StringComparison.Ordinal)
            && !(string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
                && line.Contains(RosterSystemFolderMarker, StringComparison.OrdinalIgnoreCase))
            && !line.Contains("no watched files", StringComparison.OrdinalIgnoreCase)
            && !line.Contains("no saved runners", StringComparison.OrdinalIgnoreCase)
            && !line.Contains("empty", StringComparison.OrdinalIgnoreCase);

    private void StartRosterDrag(DesktopDialogField field, string line)
    {
        if (!IsRosterDraggableLine(field, line))
            return;

        _rosterMouseDragSourceLine = line;
    }

    private void ClearRosterDragSource()
    {
        _rosterMouseDragSourceLine = null;
    }

    private async Task DropRosterLineAsync(DesktopDialogField field, string line)
    {
        string? sourceLine = RosterActiveSourceLine;
        if (!IsRosterDropTargetLine(field, line) || string.IsNullOrWhiteSpace(sourceLine))
            return;

        string targetFolder = ExtractRosterFolderName(line);
        if (string.IsNullOrWhiteSpace(targetFolder))
            return;

        string sourceFolder = IsRosterDropTargetLine(field, sourceLine)
            ? ExtractRosterFolderName(sourceLine)
            : string.Empty;
        await RosterDropRequested.InvokeAsync(new DialogRosterDropIntent(
            sourceLine,
            line,
            targetFolder,
            string.IsNullOrWhiteSpace(sourceFolder) ? RosterMoveRunnerToGroupCommand : RosterReorderTreeCommand,
            sourceFolder,
            ExtractRosterFolderName(sourceLine),
            BuildRosterHierarchyLineKind(field, sourceLine),
            BuildRosterHierarchyFolderScope(field, sourceLine),
            BuildRosterHierarchyFolderScope(field, line)));
        _rosterMouseDragSourceLine = null;
        _rosterKeyboardSourceLine = null;
    }

    private async Task HandleRosterLineKeyDownAsync(
        DesktopDialogField field,
        string line,
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (!IsRosterHierarchyField(field))
            return;

        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            _rosterKeyboardSourceLine = null;
            return;
        }

        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal)
            && !string.Equals(args.Key, " ", StringComparison.Ordinal)
            && !string.Equals(args.Code, "Space", StringComparison.Ordinal))
            return;

        if (IsRosterDropTargetLine(field, line) && !string.IsNullOrWhiteSpace(RosterActiveSourceLine))
        {
            await DropRosterLineAsync(field, line);
            return;
        }

        if (IsRosterDraggableLine(field, line))
            _rosterKeyboardSourceLine = line;
    }

    private static bool IsRosterDropTargetLine(DesktopDialogField field, string line)
        => IsRosterHierarchyField(field)
            && string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
            && !string.IsNullOrWhiteSpace(line)
            && !line.TrimStart().StartsWith("[", StringComparison.Ordinal)
            && (line.Contains(RosterSystemFolderMarker, StringComparison.OrdinalIgnoreCase)
                || line.Contains(RosterCustomFolderMarker, StringComparison.OrdinalIgnoreCase));

    private static string ExtractRosterFolderName(string line)
    {
        string cleaned = line.Trim()
            .TrimStart('├', '└', '─', '│', ' ', '*', '-')
            .Trim();
        int suffixIndex = cleaned.IndexOf(RosterFolderScopeSeparator, StringComparison.Ordinal);
        return suffixIndex > 0 ? cleaned[..suffixIndex].Trim() : cleaned;
    }

    private string BuildRosterHierarchyLineClass(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field))
            return "dialog-roster-line";

        string trimmed = line.TrimStart();
        string kind = trimmed.StartsWith("[", StringComparison.Ordinal)
            ? "root"
            : trimmed.Contains("├─", StringComparison.Ordinal) || trimmed.Contains("└─", StringComparison.Ordinal)
                ? "branch"
                : "leaf";
        string selected = trimmed.Contains("* ", StringComparison.Ordinal) ? " is-selected" : string.Empty;
        string draggable = IsRosterDraggableLine(field, line) ? " is-draggable" : string.Empty;
        string dropTarget = IsRosterDropTargetLine(field, line) ? " is-drop-target" : string.Empty;
        string dragSource = string.Equals(RosterActiveSourceLine, line, StringComparison.Ordinal) ? " is-drag-source" : string.Empty;
        string sourceMode = string.Equals(_rosterKeyboardSourceLine, line, StringComparison.Ordinal)
            ? " is-keyboard-source"
            : string.Equals(_rosterMouseDragSourceLine, line, StringComparison.Ordinal)
                ? " is-mouse-source"
                : string.Empty;
        return $"dialog-roster-line dialog-roster-line--{kind}{selected}{draggable}{dropTarget}{dragSource}{sourceMode}";
    }

    private static string BuildRosterHierarchyLineKind(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field) || string.IsNullOrWhiteSpace(line))
            return "presentation";

        string trimmed = line.TrimStart();
        if (trimmed.StartsWith("[", StringComparison.Ordinal))
            return "heading";
        if (string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
            && (line.Contains(RosterSystemFolderMarker, StringComparison.OrdinalIgnoreCase)
                || line.Contains(RosterCustomFolderMarker, StringComparison.OrdinalIgnoreCase)))
            return "directory";
        if (line.Contains(" · watched_file", StringComparison.OrdinalIgnoreCase))
            return "watched-file";
        if (line.Contains(" · folder_shortcut", StringComparison.OrdinalIgnoreCase))
            return "folder-shortcut";
        return "runner";
    }

    private static string BuildRosterHierarchyFolderScope(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field)
            || !string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal))
            return RosterNoFolderScope;
        if (line.Contains(RosterSystemFolderMarker, StringComparison.OrdinalIgnoreCase))
            return RosterSystemFolderScope;
        if (line.Contains(RosterCustomFolderMarker, StringComparison.OrdinalIgnoreCase))
            return RosterCustomFolderScope;
        return RosterNoFolderScope;
    }

    private static string BuildRosterHierarchySourceItem(DesktopDialogField field, string line)
        => IsRosterHierarchyField(field) && IsRosterDraggableLine(field, line)
            ? ExtractRosterFolderName(line)
            : string.Empty;

    private string BuildRosterHierarchyDropAction(DesktopDialogField field, string line)
    {
        if (!IsRosterDropTargetLine(field, line))
            return string.Empty;

        return string.Equals(BuildRosterHierarchyFolderScope(field, RosterActiveSourceLine ?? string.Empty), RosterCustomFolderScope, StringComparison.Ordinal)
            ? RosterReorderTreeCommand
            : RosterMoveRunnerToGroupCommand;
    }

    private static string BuildRosterHierarchyAcceptedDropKinds(DesktopDialogField field, string line)
        => IsRosterDropTargetLine(field, line)
            ? "runner watched-file folder-shortcut custom-directory"
            : string.Empty;

    private static string BuildRosterHierarchyLineTitle(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field))
            return string.Empty;

        if (IsRosterDropTargetLine(field, line))
            return "Drop a runner/link row here to move it into this roster directory, or drop a custom directory here to nest it. Keyboard: Enter/Space drops the selected source here.";

        if (IsRosterDraggableLine(field, line))
            return "Drag this roster row to a directory. Keyboard: Enter/Space selects this source; Escape clears it. Moves are virtual metadata only until explicitly committed.";

        return "Roster hierarchy row.";
    }

    private static string BuildRosterHierarchyLineTabIndex(DesktopDialogField field, string line)
        => IsRosterDraggableLine(field, line) || IsRosterDropTargetLine(field, line) ? "0" : "-1";

    private static string? BuildRosterHierarchyLineKeyShortcuts(DesktopDialogField field, string line)
        => IsRosterDraggableLine(field, line) || IsRosterDropTargetLine(field, line)
            ? "Enter Space Escape"
            : null;

    private string RosterKeyboardHintId => BuildRosterKeyboardDomId("roster-keyboard-hint");

    private string RosterKeyboardStatusId => BuildRosterKeyboardDomId("roster-keyboard-status");

    private string BuildRosterKeyboardDomId(string suffix)
    {
        string normalizedDialogId = NormalizeRosterDomId(Dialog?.Id ?? "dialog");
        return $"dialog-{normalizedDialogId}-{suffix}";
    }

    private static string NormalizeRosterDomId(string value)
    {
        return value
            .Replace('.', '-')
            .Replace('_', '-')
            .Replace(':', '-')
            .Replace(' ', '-');
    }

    private string? BuildRosterHierarchyLineDescriptionId(DesktopDialogField field, string line)
        => IsRosterDraggableLine(field, line) || IsRosterDropTargetLine(field, line)
            ? string.IsNullOrWhiteSpace(RosterActiveSourceLine)
                ? RosterKeyboardHintId
                : $"{RosterKeyboardHintId} {RosterKeyboardStatusId}"
            : null;

    private static string BuildRosterHierarchyContainerRole(DesktopDialogField field)
        => IsRosterHierarchyField(field) ? "tree" : "group";

    private static string? BuildRosterHierarchyContainerLabel(DesktopDialogField field)
        => IsRosterHierarchyField(field) ? field.Label : null;

    private static string? BuildRosterHierarchyContainerOrientation(DesktopDialogField field)
        => IsRosterHierarchyField(field) ? "vertical" : null;

    private static string BuildRosterHierarchyToolbarTitle(DesktopDialogField field)
        => string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
            ? "Character library tree"
            : "Roster organization";

    private static string BuildRosterHierarchyToolbarSummary(DesktopDialogField field)
        => string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal)
            ? "Create your own folder hierarchy, then drag runners or custom folders onto any directory. Keyboard users can select a row with Enter or Space and drop it on a directory."
            : "This roster view keeps groups, folders, move targets, and hierarchy policy visible before the app commits library changes.";

    private static bool IsRosterKeyboardStatusHost(DesktopDialogField field)
        => string.Equals(field.Id, RosterCustomFoldersFieldId, StringComparison.Ordinal);

    private static string BuildRosterHierarchyLineRole(DesktopDialogField field, string line)
        => IsRosterHierarchyField(field) && !line.TrimStart().StartsWith("[", StringComparison.Ordinal)
            ? "treeitem"
            : "presentation";

    private static string? BuildRosterHierarchyLineLevel(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field) || line.TrimStart().StartsWith("[", StringComparison.Ordinal))
            return null;

        int level = 1;
        for (int index = 0; index < line.Length; index++)
        {
            char character = line[index];
            if (character is '│' or ' ')
                continue;

            level += index / 3;
            break;
        }

        return level.ToString(CultureInfo.InvariantCulture);
    }

    private string? BuildRosterHierarchyLineSelected(DesktopDialogField field, string line)
    {
        if (!IsRosterHierarchyField(field) || line.TrimStart().StartsWith("[", StringComparison.Ordinal))
            return null;

        return line.TrimStart().Contains("* ", StringComparison.Ordinal)
            || string.Equals(RosterActiveSourceLine, line, StringComparison.Ordinal)
            ? "true"
            : "false";
    }

    private static string? BuildRosterHierarchyLineExpanded(DesktopDialogField field, string line)
        => IsRosterDropTargetLine(field, line) ? "true" : null;

    private string BuildRosterKeyboardStatus()
        => string.IsNullOrWhiteSpace(RosterActiveSourceLine)
            ? string.Empty
            : $"{RosterActiveSourceMode} source selected: {RosterActiveSourceLine.Trim()}. {RosterActiveSourceInstruction}";

    private string? RosterActiveSourceLine => _rosterKeyboardSourceLine ?? _rosterMouseDragSourceLine;

    private string RosterActiveSourceMode => !string.IsNullOrWhiteSpace(_rosterKeyboardSourceLine)
        ? "Keyboard"
        : "Mouse";

    private string RosterActiveSourceInstruction => !string.IsNullOrWhiteSpace(_rosterKeyboardSourceLine)
        ? "Press Enter or Space on a directory to drop, or Escape to clear."
        : "Drop on a directory to move or nest, or release outside a directory to cancel.";

    private static IReadOnlyList<string> SplitVisualLines(string value)
    {
        return value.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private static IReadOnlyList<(string Key, string Value)> SplitGridRows(string value)
    {
        return value
            .Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line =>
            {
                string[] parts = line.Split('|', 2, StringSplitOptions.TrimEntries);
                return parts.Length == 2 ? (parts[0], parts[1]) : (line, string.Empty);
            })
            .ToArray();
    }

    private static string? TryBuildImageDataUri(string value)
    {
        string? portraitSource = SplitVisualLines(value)
            .FirstOrDefault(line => line.StartsWith("Portrait Source | ", StringComparison.Ordinal))
            ?.Substring("Portrait Source | ".Length)
            ?.Trim();

        if (string.IsNullOrWhiteSpace(portraitSource) || !File.Exists(portraitSource))
        {
            return null;
        }

        string extension = Path.GetExtension(portraitSource).ToLowerInvariant();
        string? mimeType = extension switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".gif" => "image/gif",
            ".bmp" => "image/bmp",
            _ => null
        };

        if (mimeType is null)
        {
            return null;
        }

        try
        {
            return $"data:{mimeType};base64,{Convert.ToBase64String(File.ReadAllBytes(portraitSource))}";
        }
        catch
        {
            return null;
        }
    }

