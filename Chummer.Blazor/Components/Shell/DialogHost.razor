    private RenderFragment RenderPrioritySelectControl(
        DesktopDialogField field,
        string cssClass,
        int? size = null) => builder =>
    {
        builder.OpenElement(0, "select");
        builder.SetKey($"dialog-select:{field.Id}");
        builder.AddAttribute(1, "class", cssClass);
        builder.AddAttribute(2, "data-field-id", field.Id);
        builder.AddAttribute(3, "aria-label", field.AccessibleName);
        builder.AddAttribute(4, "aria-description", field.HelpText);
        builder.AddAttribute(5, "disabled", field.IsReadOnly);
        if (size.HasValue)
        {
            builder.AddAttribute(6, "size", size.Value);
        }

        builder.AddAttribute(7, "value", field.Value);
        builder.AddAttribute(8, "onfocus", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.FocusEventArgs>(
            this,
            _ => PrepareDialogFieldInteractionAsync(field)));
        builder.AddAttribute(9, "onpointerdown", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.PointerEventArgs>(
            this,
            _ => PrepareDialogFieldInteractionAsync(field)));
        builder.AddAttribute(10, "onchange", EventCallback.Factory.CreateBinder<string?>(
            this,
            value => OnDialogFieldInputAsync(field, value),
            field.Value));

        int sequence = 11;
        foreach (DesktopDialogFieldOption option in field.Options ?? [])
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", option.Value);
            builder.AddContent(sequence++, option.Label);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

