    private RenderFragment RenderOriginField(DesktopDialogField field) => builder =>
    {
        builder.OpenElement(0, "label");
        builder.SetKey($"dialog-origin-field:{field.Id}");
        builder.AddAttribute(1, "class", "dialog-origin-field");
        builder.AddAttribute(2, "data-field-id", field.Id);
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "dialog-label");
        builder.AddContent(5, field.Label);
        builder.CloseElement();

        if (string.Equals(field.InputType, "select", StringComparison.Ordinal))
        {
            builder.AddContent(6, RenderPrioritySelectControl(field, "dialog-input dialog-priority-select"));
        }
        else if (field.IsMultiline)
        {
            builder.OpenElement(7, "textarea");
            builder.AddAttribute(8, "class", "dialog-input dialog-origin-textarea");
            builder.AddAttribute(9, "aria-label", field.AccessibleName);
            builder.AddAttribute(10, "aria-description", field.HelpText);
            builder.AddAttribute(11, "placeholder", field.Placeholder);
            builder.AddAttribute(12, "readonly", field.IsReadOnly);
            builder.AddAttribute(13, "value", field.Value);
            builder.AddAttribute(14, "oninput", EventCallback.Factory.CreateBinder<string?>(
                this,
                value => OnDialogFieldInputAsync(field, value),
                field.Value));
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(15, "input");
            builder.AddAttribute(16, "class", "dialog-input");
            builder.AddAttribute(17, "aria-label", field.AccessibleName);
            builder.AddAttribute(18, "aria-description", field.HelpText);
            builder.AddAttribute(19, "value", field.Value);
            builder.AddAttribute(20, "placeholder", field.Placeholder);
            builder.AddAttribute(21, "readonly", field.IsReadOnly);
            builder.AddAttribute(22, "type", field.InputType);
            builder.AddAttribute(23, "oninput", EventCallback.Factory.CreateBinder<string?>(
                this,
                value => OnDialogFieldInputAsync(field, value),
                field.Value));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static RenderFragment RenderOriginReadonlyField(DesktopDialogField field) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "dialog-origin-readonly");
        builder.AddContent(2, RenderOriginReadonlyContent(field));
        builder.CloseElement();
    };

    private static RenderFragment RenderOriginReadonlyContent(DesktopDialogField field) => builder =>
    {
        if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Book, StringComparison.Ordinal))
        {
            builder.AddContent(0, RenderNarrativeParagraphs(field.Value, "dialog-origin-book"));
            return;
        }

        if (string.Equals(field.VisualKind, DesktopDialogFieldVisualKinds.Narrative, StringComparison.Ordinal))
        {
            builder.AddContent(0, RenderNarrativeParagraphs(field.Value, "dialog-origin-narrative"));
            return;
        }

        builder.OpenElement(0, "pre");
        builder.AddAttribute(1, "class", "dialog-visual-pre");
        builder.AddContent(2, field.Value);
        builder.CloseElement();
    };

    private static RenderFragment RenderNarrativeParagraphs(string value, string cssClass) => builder =>
    {
        string normalized = value.Replace("\r\n", "\n", StringComparison.Ordinal);
        string[] paragraphs = normalized
            .Split(["\n\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        string[] renderedParagraphs = paragraphs.Length == 0 ? [normalized.Trim()] : paragraphs;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", cssClass);

        int sequence = 2;
        foreach (string paragraph in renderedParagraphs.Where(static paragraph => !string.IsNullOrWhiteSpace(paragraph)))
        {
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, paragraph);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

