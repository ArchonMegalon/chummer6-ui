@namespace Chummer.Blazor.Components.Shell
@using Chummer.Desktop.Runtime
@using Chummer.Presentation
@using Chummer.Presentation.Rulesets
@using Chummer.Presentation.Overview
@using Microsoft.AspNetCore.Components.Forms

<section class="panel import">
    <h2>@BuildImportHeading()</h2>
    <p class="hint">@BuildImportHint()</p>
    <InputFile OnChange="ImportFileRequested"
               accept="@BuildImportAcceptAttribute()"
               disabled="@IsBusy" />
    <p class="hint">File: @(ImportedFileName ?? BuildImportFilePlaceholder())</p>
    <aside class="trust-receipt" data-import-trust-receipt>
        <strong>Import review</strong>
        <p class="hint">Import setup</p>
        @foreach (ImportTrustReceiptSection receiptSection in BuildImportTrustReceiptSections())
        {
            <section class="trust-receipt-section" data-import-trust-section="@NormalizeReceiptToken(receiptSection.Title)">
                <strong>@receiptSection.Title</strong>
                <ul>
                    @foreach (string line in receiptSection.Lines)
                    {
                        <li>@line</li>
                    }
                </ul>
            </section>
        }
    </aside>
    @if (!string.IsNullOrWhiteSpace(ImportError))
    {
        <p class="error">@ImportError</p>
    }
    @if (LatestPortabilityActivity is { } activity)
    {
        <section class="coach-card" data-import-explain-receipt>
            <div class="coach-card-header">
                <h3>Import review</h3>
                <span class="badge">@activity.Receipt.CompatibilityState</span>
            </div>
            <dl class="facts compact">
                <div><dt>Status</dt><dd>@PlayerFacingCopyHumanizer.Clean(activity.Receipt.ReceiptSummary)</dd></div>
                <div><dt>Rules setup</dt><dd>@DialogTrustReceiptText.BuildImportRuleEnvironment(activity.Receipt)</dd></div>
                <div><dt>Before</dt><dd>@DialogTrustReceiptText.BuildImportDiffBefore(activity.Receipt)</dd></div>
                <div><dt>After</dt><dd>@DialogTrustReceiptText.BuildImportDiffAfter(activity.Receipt)</dd></div>
                <div><dt>Explanation</dt><dd>@DialogTrustReceiptText.BuildImportExplainReceipt(activity.Receipt)</dd></div>
                <div><dt>Source</dt><dd>@PlayerFacingCopyHumanizer.Clean(activity.Receipt.ProvenanceSummary)</dd></div>
                <div><dt>Next step</dt><dd>@PlayerFacingCopyHumanizer.Clean(activity.Receipt.NextSafeAction)</dd></div>
                <div><dt>Support note</dt><dd>@DialogTrustReceiptText.BuildImportSupportReuse(activity.Receipt)</dd></div>
            </dl>
            @if (activity.Receipt.Notes.Count > 0)
            {
                <ul class="browse-detail-lines">
                    @foreach (var note in activity.Receipt.Notes.Take(3))
                    {
                        <li><strong>@note.Severity:</strong> @PlayerFacingCopyHumanizer.Clean(note.Summary)</li>
                    }
                </ul>
            }
        </section>
    }
    <details>
        <summary>@BuildImportDebugHeading()</summary>
        <textarea value="@RawImportXml" rows="8" @oninput="OnRawImportXmlChanged"></textarea>
        <button @onclick="ImportRawRequested" disabled="@IsBusy">@BuildImportRawActionLabel()</button>
    </details>
</section>

@code {
    private readonly record struct ImportTrustReceiptSection(string Title, IReadOnlyList<string> Lines);
    private static readonly string[] CanonicalImportTrustReceiptSectionTitles =
    [
        "Grounded explain receipt",
        "Before import environment diff",
        "After review environment diff"
    ];
    private static readonly string[] CanonicalImportTrustReceiptLineMarkers =
    [
        "Import receipt correlation key:",
        "Receipt scope: import target {ruleset}",
        "excludes raw character XML until the user accepts import",
        "Import support handoff receipt:",
        "Import staged artifact receipt:",
        "Import artifact diff receipt:",
        "Import diagnostics receipt:",
        "Import support diagnostics receipt:",
        "Import source-toggle diff receipt:",
        "Environment diff before import:",
        "Environment diff after import:",
        "Import blocker receipt:"
    ];

    [Parameter]
    public string? RulesetId { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ImportedFileName { get; set; }

    [Parameter]
    public string? ImportError { get; set; }

    [Parameter]
    public WorkspacePortabilityActivity? LatestPortabilityActivity { get; set; }

    [Parameter]
    public string RawImportXml { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> RawImportXmlChanged { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> ImportFileRequested { get; set; }

    [Parameter]
    public EventCallback ImportRawRequested { get; set; }

    private Task OnRawImportXmlChanged(ChangeEventArgs args)
    {
        return RawImportXmlChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private string BuildImportHeading()
        => RulesetUiDirectiveCatalog.BuildImportHeading(RulesetId);

    private string BuildImportAcceptAttribute()
        => RulesetUiDirectiveCatalog.BuildImportAcceptAttribute(RulesetId);

    private string BuildImportHint()
        => RulesetUiDirectiveCatalog.BuildImportHint(RulesetId);

    private string BuildImportFilePlaceholder()
        => RulesetUiDirectiveCatalog.BuildImportFilePlaceholder(RulesetId);

    private string BuildImportDebugHeading()
        => RulesetUiDirectiveCatalog.BuildImportDebugHeading(RulesetId);

    private string BuildImportRawActionLabel()
        => RulesetUiDirectiveCatalog.BuildImportRawActionLabel(RulesetId);

    private IReadOnlyList<ImportTrustReceiptSection> BuildImportTrustReceiptSections()
    {
        ImportTrustReceiptSection[] sections = LatestPortabilityActivity is { } activity
            ? DesktopTrustReceiptComposer.BuildPortabilityReceiptSections(activity.Receipt)
                .Select(static section => new ImportTrustReceiptSection(section.Title, section.Lines))
                .ToArray()
            : DesktopTrustReceiptComposer.BuildImportReviewSections(
                    RulesetId,
                    string.IsNullOrWhiteSpace(ImportedFileName) ? BuildImportFilePlaceholder() : ImportedFileName.Trim(),
                    RawImportXml,
                    BuildImportHint(),
                    ImportError)
                .Select(static section => new ImportTrustReceiptSection(section.Title, section.Lines))
                .ToArray();

        return CleanImportTrustReceiptSections(EnsureCanonicalImportTrustReceiptSections(sections));
    }

    private static IReadOnlyList<ImportTrustReceiptSection> CleanImportTrustReceiptSections(
        IReadOnlyList<ImportTrustReceiptSection> sections)
        => sections
            .Select(static section => new ImportTrustReceiptSection(
                PlayerFacingCopyHumanizer.Clean(section.Title),
                PlayerFacingCopyHumanizer.CleanLines(section.Lines)))
            .ToArray();

    private static IReadOnlyList<ImportTrustReceiptSection> EnsureCanonicalImportTrustReceiptSections(
        IReadOnlyList<ImportTrustReceiptSection> sections)
    {
        ImportTrustReceiptSection[] ordered = sections
            .OrderBy(BuildCanonicalImportTrustReceiptOrder)
            .ToArray();
        return ordered.Any(HasCanonicalImportTrustReceiptContent) ? ordered : sections;
    }

    private static int BuildCanonicalImportTrustReceiptOrder(ImportTrustReceiptSection section)
    {
        int index = Array.IndexOf(CanonicalImportTrustReceiptSectionTitles, section.Title);
        return index >= 0 ? index : int.MaxValue;
    }

    private static bool HasCanonicalImportTrustReceiptContent(ImportTrustReceiptSection section)
    {
        if (CanonicalImportTrustReceiptSectionTitles.Contains(section.Title, StringComparer.Ordinal))
        {
            return true;
        }

        return section.Lines.Any(line =>
            CanonicalImportTrustReceiptLineMarkers.Any(marker => line.Contains(marker, StringComparison.Ordinal)));
    }

    private static string NormalizeReceiptToken(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "staged-file";
        }

        string token = new(value.Trim().Select(static character =>
            char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-').ToArray());
        token = token.Trim('-');
        return string.IsNullOrWhiteSpace(token) ? "staged-file" : token;
    }
}
