@namespace Chummer.Blazor.Components.Shell
@using Chummer.Contracts.Presentation
@using Chummer.Presentation.UiKit

<div class="tool-strip classic-tool-strip" role="toolbar" aria-label="Chummer actions">
    @for (int index = 0; index < Commands.Count; index++)
    {
        AppCommandDefinition command = Commands[index];
        bool enabled = IsCommandEnabled(command);
        @if (ShouldRenderDividerBefore(index))
        {
            <span class="tool-divider" aria-hidden="true"></span>
        }

        <button class="tool-btn classic-tool-button @(string.Equals(LastCommandId, command.Id, StringComparison.Ordinal) ? "selected" : string.Empty)"
                title="@ShellChromeBoundary.FormatCommandLabel(command.Id)"
                disabled="@(!enabled || IsBusy)"
                @onclick="() => ExecuteCommandAsync(command.Id)">
            @FormatToolStripLabel(command.Id)
        </button>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<AppCommandDefinition> Commands { get; set; } = [];

    [Parameter]
    public string? CurrentLanguage { get; set; }

    [Parameter]
    public string? LastCommandId { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public Func<AppCommandDefinition, bool> IsCommandEnabled { get; set; } = _ => false;

    [Parameter]
    public EventCallback<string> ExecuteCommandRequested { get; set; }

    private Task ExecuteCommandAsync(string commandId)
    {
        return ExecuteCommandRequested.InvokeAsync(commandId);
    }

    private bool ShouldRenderDividerBefore(int index)
    {
        if (index <= 0 || index >= Commands.Count)
            return false;

        return string.Equals(Commands[index - 1].Id, CopyCommandId, StringComparison.Ordinal)
            && string.Equals(Commands[index].Id, NewCharacterCommandId, StringComparison.Ordinal);
    }

    private static string FormatToolStripLabel(string commandId)
        => commandId switch
        {
            NewCharacterCommandId => "New",
            OpenCharacterCommandId => "Open",
            SaveCharacterCommandId => "Save",
            SaveCharacterAsCommandId => "Save As",
            PrintCharacterCommandId => "Print",
            CopyCommandId => "Copy",
            PasteCommandId => "Paste",
            CloseWindowCommandId => "Close",
            CloseAllCommandId => "Close All",
            UpdateCommandId => "Update",
            GlobalSettingsCommandId => "Options",
            ReportBugCommandId => "Bug",
            _ => ShellChromeBoundary.FormatCommandLabel(commandId)
        };

    private const string NewCharacterCommandId = "new_character";
    private const string OpenCharacterCommandId = "open_character";
    private const string SaveCharacterCommandId = "save_character";
    private const string SaveCharacterAsCommandId = "save_character_as";
    private const string PrintCharacterCommandId = "print_character";
    private const string CopyCommandId = "copy";
    private const string PasteCommandId = "paste";
    private const string CloseWindowCommandId = "close_window";
    private const string CloseAllCommandId = "close_all";
    private const string UpdateCommandId = "update";
    private const string GlobalSettingsCommandId = "global_settings";
    private const string ReportBugCommandId = "report_bug";
}
