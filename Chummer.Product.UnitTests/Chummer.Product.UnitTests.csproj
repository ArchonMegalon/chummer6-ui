<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.VisualStudio.TestTools.UnitTesting.DoNotParallelizeAttribute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Chummer.Desktop.Runtime/Chummer.Desktop.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DesktopUpdateArtifactTests.cs" />
    <Compile Include="../Chummer.Tests/DesktopCrashRuntimeTests.cs" Link="DesktopCrashRuntimeTests.cs" />
    <Compile Include="../Chummer.Tests/DesktopInstallLinkingRuntimeTests.cs" Link="DesktopInstallLinkingRuntimeTests.cs" />
    <Compile Include="../Chummer.Tests/DesktopPreferenceRuntimeTests.cs" Link="DesktopPreferenceRuntimeTests.cs" />
    <Compile Include="../Chummer.Tests/DesktopStartupSmokeRuntimeTests.cs" Link="DesktopStartupSmokeRuntimeTests.cs" />
    <Compile Include="../Chummer.Tests/DesktopUpdateRuntimeTests.cs" Link="DesktopUpdateRuntimeTests.cs" />
    <Compile Include="../Chummer.Tests/Presentation/CareerActiveSkillAdvanceParityTests.cs" Link="Presentation/CareerActiveSkillAdvanceParityTests.cs" />
    <Compile Include="../Chummer.Tests/Presentation/CareerSkillGroupAdvanceParityTests.cs" Link="Presentation/CareerSkillGroupAdvanceParityTests.cs" />
    <Compile Include="../Chummer.Tests/Presentation/CareerSkillSpecializationParityTests.cs" Link="Presentation/CareerSkillSpecializationParityTests.cs" />
    <Compile Include="../Chummer.Tests/Presentation/CareerWeaponFireParityTests.cs" Link="Presentation/CareerWeaponFireParityTests.cs" />
  </ItemGroup>
</Project>
